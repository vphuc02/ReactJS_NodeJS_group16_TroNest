PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/tronest
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development

# Cấu hình SMTP gửi mã OTP Quên mật khẩu (Tùy chọn - nếu để trống hệ thống sẽ hiển thị OTP ở chế độ Dev Preview)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TroNest <no-reply@tronest.com>"

# Cấu hình Google OAuth 2.0 (Lấy từ Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
