mixin roomItem(room, favoriteRoomIds)
  - const isFav = favoriteRoomIds && favoriteRoomIds.includes(room._id.toString());
  .product-item(class="client-clean-147")
    // Favorite Button
    button.btn-fav(class=isFav ? 'active' : '' data-room-id=room._id.toString() title="Lưu vào danh sách yêu thích")
      if isFav
        i.fa-solid.fa-heart
      else
        i.fa-regular.fa-heart

    .inner-image(class="client-clean-148")
      a(href=`/rooms/detail/${room._id}`)
        img(
          alt=room.title
          src=room.thumbnail || "/client/assets/images/product-1.jpg"
          class="client-clean-149"
        )
      if room.categoryId && room.categoryId.title
        span(class="client-clean-150")
          = room.categoryId.title

    .inner-content(class="client-clean-151")
      div
        h3.inner-title(class="client-clean-152")
          a(href=`/rooms/detail/${room._id}` class="client-clean-153")
            = room.title

        .inner-prices(class="client-clean-154")
          span(class="client-clean-155")
            = room.price.toLocaleString('vi-VN')
          span(class="client-clean-156") đ/tháng

        .inner-desc(class="client-clean-157")
          div(class="client-clean-158")
            i.fa-solid.fa-vector-square(class="client-clean-059")
            span #{room.area} m²
          div(class="client-clean-158")
            i.fa-solid.fa-user-group(class="client-clean-059")
            span #{room.capacity || 2} người
          div(class="client-clean-158")
            i.fa-solid.fa-location-dot(class="client-clean-059")
            span= room.district

      div(class="client-clean-159")
        div(class="client-clean-160")
          i.fa-solid.fa-user-tie(class="client-clean-161")
          span(class="client-clean-162")
            = room.landlordId ? room.landlordId.fullName : 'Chủ trọ'
        a(href=`/rooms/detail/${room._id}` class="client-clean-163")
          | Chi tiết
          i.fa-solid.fa-arrow-right(class="client-clean-164")
