//- Header - TroNest Floating Pill Navbar (Hotelier Luxury Hospitality Style: Warm Alabaster, Champagne Bronze & Deep Charcoal)
header.header(class="fixed top-4 inset-x-0 z-50 px-2 sm:px-6 pointer-events-none")
  .container-pill(class="w-[96%] max-w-[1440px] mx-auto pointer-events-auto")
    nav.navbar-pill(class="rounded-full bg-[#FAF7F2]/95 backdrop-blur-md border border-[#E6DFD3] shadow-[0_10px_34px_rgba(28,27,25,0.08),0_1px_2px_rgba(28,27,25,0.04)] hover:shadow-[0_14px_42px_rgba(166,124,82,0.16)] transition-all duration-300 px-4 sm:px-7 py-2.5 flex items-center justify-between gap-3 sm:gap-6")
      
      //- Bên trái: Logo TroNest phong cách Hotelier Luxury
      div(class="flex items-center gap-2.5 flex-shrink-0")
        //- Menu Mobile Toggle
        button.inner-menu-mobile(type="button" aria-label="Mở menu" class="md:hidden w-8 h-8 sm:w-9 sm:h-9 rounded-full border border-[#E6DFD3] bg-[#F5EFE6] hover:bg-[#A67C52] text-[#1C1B19] hover:text-white flex items-center justify-center transition-all duration-200")
          i.fa-solid.fa-bars(class="text-xs sm:text-sm")
        
        a(href="/" title="TroNest - Nền tảng tìm kiếm phòng trọ sang trọng, an tâm" class="flex items-center gap-2.5 group no-underline")
          span(class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-[#A67C52] border border-[#8C6239]/30 flex items-center justify-center text-white group-hover:bg-[#1C1B19] transition-all duration-200 shadow-xs")
            i.fa-solid.fa-house-chimney(class="text-sm sm:text-base")
          span(class="text-xl sm:text-2xl font-serif font-bold tracking-tight text-[#1C1B19] group-hover:text-[#A67C52] transition-colors duration-200") TroNest

      //- Ở giữa: Danh sách các chức năng chính sắp xếp cân đối, tinh tế
      nav(class="hidden md:flex items-center justify-center gap-1.5 lg:gap-4 flex-1 px-4")
        a(href="/" class="px-4 py-2 rounded-full text-[13.5px] lg:text-sm font-semibold text-[#1C1B19] hover:text-[#A67C52] hover:bg-[#F5EFE6] transition-all duration-200 no-underline flex items-center gap-2 group")
          span(class="w-1.5 h-1.5 rounded-full bg-[#D4C2AA] group-hover:bg-[#A67C52] transition-colors")
          span Trang Chủ
        a(href="/rooms" class="px-4 py-2 rounded-full text-[13.5px] lg:text-sm font-semibold text-[#1C1B19] hover:text-[#A67C52] hover:bg-[#F5EFE6] transition-all duration-200 no-underline flex items-center gap-2 group")
          span(class="w-1.5 h-1.5 rounded-full bg-[#D4C2AA] group-hover:bg-[#A67C52] transition-colors")
          span Tất Cả Phòng
        a(href="/rooms?category=can-ho-mini-studio" class="hidden lg:flex px-4 py-2 rounded-full text-[13.5px] lg:text-sm font-semibold text-[#6E6A63] hover:text-[#A67C52] hover:bg-[#F5EFE6] transition-all duration-200 no-underline items-center gap-2 group")
          span(class="w-1.5 h-1.5 rounded-full bg-[#D4C2AA] group-hover:bg-[#A67C52] transition-colors")
          span Studio & Căn Hộ

      //- Bên phải: Cụm Action (Nút Đăng tin + Tài khoản + Yêu thích + Đăng xuất)
      div(class="flex items-center gap-2 sm:gap-2.5 flex-shrink-0")
        if user
          //- Trạng thái đã đăng nhập
          if user.role === 'ADMIN'
            a(href="/admin/dashboard" title="Cổng Quản trị" class="rounded-full bg-[#1C1B19] hover:bg-[#2A2825] text-white px-3.5 sm:px-4 py-2 text-xs sm:text-sm font-semibold shadow-xs flex items-center gap-1.5 no-underline transition-all duration-200")
              i.fa-solid.fa-shield-halved(class="text-[#C59B6D]")
              span(class="hidden sm:inline") Cổng Quản trị
          else if user.role === 'LANDLORD'
            a(href="/landlord/dashboard" title="Kênh Quản lý Chủ trọ" class="rounded-full bg-[#F5EFE6] hover:bg-[#E6DFD3] text-[#8C6239] border border-[#E6DFD3] px-3.5 sm:px-4 py-2 text-xs sm:text-sm font-semibold shadow-xs flex items-center gap-1.5 no-underline transition-all duration-200")
              i.fa-solid.fa-house-chimney-user(class="text-xs")
              span(class="hidden sm:inline") Kênh Chủ Trọ
            a(href="/landlord/rooms/create" title="Đăng tin trọ" class="btn-hotelier btn-hotelier-bronze text-xs sm:text-sm no-underline")
              span(class="hidden xs:inline sm:inline") Đăng tin trọ
              span.btn-hotelier-icon
                i.fa-solid.fa-plus(class="text-[11px]")
          else
            //- Nút Đăng tin trọ: Phong cách Split-Icon Pill Hotelier
            a(href="/landlord/rooms/create" title="Đăng tin trọ" class="btn-hotelier btn-hotelier-bronze text-xs sm:text-sm no-underline")
              span(class="hidden xs:inline sm:inline") Đăng tin trọ
              span.btn-hotelier-icon
                i.fa-solid.fa-plus(class="text-[11px]")

          //- Vạch ngăn tinh tế giữa nút CTA và hồ sơ người dùng
          div(class="hidden sm:block w-px h-6 bg-[#E6DFD3] mx-0.5")

          //- Thẻ người dùng (Bấm để xem và quản lý thông tin cá nhân)
          div(class="flex items-center gap-1.5 pl-1")
            a(
              href=user.role === 'LANDLORD' ? '/landlord/profile' : (user.role === 'ADMIN' ? '/admin/dashboard' : '/profile')
              title="Xem và cập nhật thông tin cá nhân"
              class="flex items-center gap-1.5 sm:gap-2 py-1 px-1.5 sm:px-3 rounded-full border border-[#E6DFD3] bg-white hover:bg-[#F5EFE6] hover:border-[#A67C52] transition-all duration-200 no-underline shadow-xs"
            )
              img(src=user.avatar || "/admin/assets/images/avatar.jpg" alt=user.fullName referrerpolicy="no-referrer" onerror="this.onerror=null;this.src='/admin/assets/images/avatar.jpg';" class="w-6 h-6 sm:w-7 sm:h-7 rounded-full object-cover border border-[#E6DFD3]")
              span(class="text-xs font-semibold text-[#1C1B19] inline-block max-w-[110px] sm:max-w-[150px] truncate")= user.fullName ? user.fullName.replace(/\s*\([^)]*\)/g, '') : ''
              span(class="text-[10px] sm:text-[11px] px-2 py-0.5 rounded-full font-bold " + (user.role === 'LANDLORD' ? 'bg-[#F5EFE6] text-[#8C6239] border border-[#E6DFD3]' : (user.role === 'ADMIN' ? 'bg-[#1C1B19] text-[#C59B6D]' : 'bg-[#FAF7F2] text-[#6E4B26] border border-[#E6DFD3]')))
                if user.role === 'LANDLORD'
                  | Chủ trọ
                else if user.role === 'ADMIN'
                  | Quản trị
                else
                  | Khách thuê

            if user.role === 'CUSTOMER'
              a(href="/favorites" title="Phòng yêu thích" class="w-8 h-8 rounded-full border border-[#E6DFD3] bg-white flex items-center justify-center text-[#6E6A63] hover:text-[#A67C52] hover:border-[#A67C52] hover:bg-[#F5EFE6] transition-all duration-200 no-underline shadow-xs")
                i.fa-solid.fa-heart(class="text-xs")

            a(href="/logout" data-logout-url="/logout" title="Đăng xuất" class="w-8 h-8 rounded-full border border-[#E6DFD3] bg-white flex items-center justify-center text-[#6E6A63] hover:text-red-600 hover:border-red-300 hover:bg-red-50 transition-all duration-200 no-underline shadow-xs")
              i.fa-solid.fa-arrow-right-from-bracket(class="text-xs")
        else
          //- Trạng thái KHÁCH VÃNG LAI (GUEST)
          a(href="/landlord/rooms/create" title="Đăng tin trọ" class="btn-hotelier btn-hotelier-bronze text-xs sm:text-sm no-underline")
            span(class="hidden xs:inline sm:inline") Đăng tin trọ
            span.btn-hotelier-icon
              i.fa-solid.fa-arrow-up-right-from-square(class="text-[10px]")

          //- Hai nút Đăng nhập & Đăng ký
          a(href="/login" class="rounded-full border border-[#E6DFD3] bg-white hover:border-[#A67C52] hover:text-[#1C1B19] text-[#6E6A63] px-3 sm:px-4 py-1.5 sm:py-2 text-xs sm:text-sm font-semibold transition-all duration-200 no-underline shadow-xs")
            | Đăng nhập
          a(href="/register" class="rounded-full border border-[#1C1B19] bg-[#1C1B19] hover:bg-[#2A2825] text-white px-3 sm:px-4 py-1.5 sm:py-2 text-xs sm:text-sm font-semibold transition-all duration-200 no-underline shadow-xs")
            | Đăng ký

  //- Mobile Navigation Drawer (Bổ trợ khi xem trên màn hình nhỏ)
  .inner-menu(class="md:hidden pointer-events-auto")
    .inner-overlay
    .inner-menu-drawer
      .inner-menu-header
        .inner-logo-drawer(class="flex items-center gap-2")
          span(class="w-7 h-7 rounded-full bg-[#A67C52] flex items-center justify-center text-white")
            i.fa-solid.fa-house-chimney(class="text-xs")
          span(class="font-serif font-bold text-lg text-[#1C1B19]") TroNest
        button.inner-menu-close(type="button" aria-label="Đóng menu")
          i.fa-solid.fa-xmark
      ul
        li
          a(href="/")
            i.fa-solid.fa-house(class="client-clean-059 text-[#A67C52]")
            span Trang chủ
        li
          a(href="/rooms")
            i.fa-solid.fa-list-check(class="client-clean-059 text-[#A67C52]")
            span Tất cả phòng
        if !user
          li(class="border-t border-[#E6DFD3] mt-2 pt-2")
            a(href="/login")
              i.fa-solid.fa-right-to-bracket(class="client-clean-059 text-[#A67C52]")
              span Đăng nhập
          li
            a(href="/register")
              i.fa-solid.fa-user-plus(class="client-clean-059 text-[#A67C52]")
              span Đăng ký
        else
          li(class="border-t border-[#E6DFD3] mt-2 pt-2")
            a(href=user.role === 'LANDLORD' ? '/landlord/profile' : (user.role === 'ADMIN' ? '/admin/dashboard' : '/profile'))
              i.fa-solid.fa-user(class="client-clean-059 text-[#A67C52]")
              span Thông tin cá nhân
          if user.role === 'LANDLORD'
            li
              a(href="/landlord/dashboard")
                i.fa-solid.fa-house-chimney-user(class="client-clean-059 text-[#A67C52]")
                span Kênh Quản lý Chủ trọ
          if user.role === 'ADMIN'
            li
              a(href="/admin/dashboard")
                i.fa-solid.fa-shield-halved(class="client-clean-059 text-[#A67C52]")
                span Cổng Quản trị
          if user.role === 'CUSTOMER'
            li
              a(href="/favorites")
                i.fa-solid.fa-heart(class="client-clean-059 text-[#A67C52]")
                span Phòng yêu thích
        li(class="mt-2")
          a(href="/landlord/rooms/create" class="text-[#A67C52] font-bold")
            i.fa-solid.fa-plus
            span Đăng tin trọ
//- End Header
