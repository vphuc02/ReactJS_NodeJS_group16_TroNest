doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(
      content="width=device-width, initial-scale=1.0" 
      name="viewport"
    )
    block title 
    link(rel="icon" href="/favicon.png")
    link(
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" 
      rel="stylesheet"
    )
    link(
      rel="stylesheet" 
      href="https://unpkg.com/aos@2.3.1/dist/aos.css"
    )
    link(
      href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" 
      rel="stylesheet"
    )
    link(
      rel="stylesheet" 
      href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css"
    )
    script(src="https://cdn.tailwindcss.com")
    script.
      tailwind.config = {
        corePlugins: {
          preflight: false
        },
        theme: {
          extend: {
            fontFamily: {
              serif: ['"Cormorant Garamond"', 'Georgia', 'serif'],
              sans: ['"Plus Jakarta Sans"', 'system-ui', '-apple-system', 'sans-serif'],
              display: ['"Cormorant Garamond"', 'Georgia', 'serif']
            },
            colors: {
              brand: {
                50: '#FAF7F2',   // Warm Alabaster soft canvas
                100: '#F5EFE6',  // Warm Sand light tint
                200: '#E6DFD3',  // Delicate Sand border
                500: '#A67C52',  // Primary Warm Champagne Bronze
                600: '#8C6239',  // Hover / Deep Burnished Bronze
                700: '#6E4B26',  // Deep Espresso Bronze
                DEFAULT: '#A67C52',
                dark: '#8C6239',
                deep: '#6E4B26',
                forest: '#1C1B19', // Deep Charcoal / Obsidian
                charcoal: '#2A2825',
                taupe: '#6E6A63',
                light: '#F5EFE6',
                soft: '#FAF7F2',
                border: '#E6DFD3'
              }
            }
          }
        }
      }
    link(
      href="/client/assets/css/style.css" 
      rel="stylesheet"
    )
    link(rel="stylesheet" href="/shared/assets/css/pagination.css")
  body
    // Header
    include ../partials/header.pug
    // End Header

    // Main Content
    block main 
    // End Main Content

    // Footer
    include ../partials/footer.pug
    // End Footer

    script(src="https://unpkg.com/aos@2.3.1/dist/aos.js")
    script(src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js")
    script(src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js")
    script(src="/shared/assets/js/notify.js")
    script(src="/shared/assets/js/http.js")
    script(src="/client/assets/js/script.js")
    script(src="/client/assets/js/location-filter.js")
