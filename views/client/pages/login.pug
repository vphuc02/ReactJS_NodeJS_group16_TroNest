doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Đăng nhập tài khoản - TroNest
    link(rel="icon" href="/favicon.png")
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css")
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css")
    link(rel="stylesheet" href="/client/assets/css/style.css")
  body(class="auth-inline-01")
    .page-account(class="auth-inline-02")
      .form-account(class="auth-inline-03")
        .inner-logo(class="auth-inline-04")
          a(href="/" class="auth-inline-05")
            i.fa-solid.fa-house-circle-check(class="auth-inline-06")
            span TroNest
        
        h2.inner-title(class="auth-inline-07") Đăng nhập hệ thống
        p(class="auth-inline-08") Dành cho Khách thuê và Chủ trọ 

        if oauthError
          div#oauth-error-alert(class="auth-oauth-error" data-error=oauthError)
            i.fa-solid.fa-circle-exclamation
            span= oauthError

        form#login-form
          input(type="hidden" name="redirectUrl" value=redirectUrl || "")

          .inner-group(class="auth-inline-09")
            label(class="auth-inline-10") Email đăng nhập
            input#email(type="email" name="email" placeholder="example@tronest.com" required class="auth-inline-11")

          .inner-group(class="auth-inline-12")
            label(class="auth-inline-10") Mật khẩu
            input#password(type="password" name="password" placeholder="••••••••" required class="auth-inline-11")

          .inner-meta(class="auth-inline-13")
            label(class="auth-inline-14")
              input#rememberPassword(type="checkbox" name="rememberPassword" class="auth-inline-15")
              span Ghi nhớ đăng nhập
            a(href="/forgot-password" class="auth-inline-19") Quên mật khẩu?

          button#btn-submit(type="submit" class="auth-inline-17")
            | Đăng nhập ngay

        .auth-divider
          span Hoặc tiếp tục với

        a#btn-google-login.btn-google-oauth(
          href=(redirectUrl ? `/auth/google?redirect=${encodeURIComponent(redirectUrl)}` : '/auth/google')
        )
          svg(width="18" height="18" viewBox="0 0 24 24" aria-hidden="true")
            path(fill="#EA4335" d="M12 10.2v3.9h5.5c-.2 1.2-.9 2.3-2 3l3.2 2.5c1.9-1.7 3-4.3 3-7.4 0-.7-.1-1.4-.2-2H12z")
            path(fill="#34A853" d="M12 22c2.7 0 5-.9 6.7-2.4l-3.2-2.5c-.9.6-2 1-3.5 1-2.7 0-5-1.8-5.8-4.3H2.9v2.6C4.6 19.8 8 22 12 22z")
            path(fill="#4A90E2" d="M6.2 13.8c-.2-.6-.3-1.2-.3-1.8s.1-1.2.3-1.8V7.6H2.9C2.3 8.9 2 10.4 2 12s.3 3.1.9 4.4l3.3-2.6z")
            path(fill="#FBBC05" d="M12 5.9c1.5 0 2.8.5 3.8 1.5l2.9-2.9C17 2.9 14.7 2 12 2 8 2 4.6 4.2 2.9 7.6l3.3 2.6c.8-2.5 3.1-4.3 5.8-4.3z")
          span Đăng nhập bằng Google

        .inner-footer(class="auth-inline-18")
          | Chưa có tài khoản? 
          a(href="/register" class="auth-inline-19") Đăng ký ngay
        
        div(class="auth-inline-20")
          | Tài khoản mẫu: Admin (admin@tronest.com) | Chủ trọ (chutro.viet@tronest.com) | Khách (khachhang@tronest.com) | MK: 123456

    script(src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js")
    script(src="/shared/assets/js/notify.js")
    script(src="/shared/assets/js/http.js")
    script(src="/client/assets/js/auth.js")
