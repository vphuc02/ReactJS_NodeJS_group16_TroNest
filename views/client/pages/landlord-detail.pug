extends ../layouts/default.pug
include ../mixins/room-item.pug

block title
  title= title

block main
  -
    const formatFbUrl = (val) => {
      if (!val) return '';
      const s = String(val).trim();
      if (s.startsWith('http://') || s.startsWith('https://')) return s;
      if (s.startsWith('facebook.com') || s.startsWith('www.facebook.com') || s.startsWith('fb.com')) return 'https://' + s;
      return 'https://facebook.com/' + s;
    };
    const fbLink = formatFbUrl(landlord.facebook);
    const isOwner = user && user._id && user._id.toString() === landlord._id.toString();

  main(class="client-clean-001 pt-24 pb-16 min-h-screen bg-slate-50/70")
    .container(class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6")
      //- Breadcrumb
      nav(class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 font-medium")
        a(href="/" class="hover:text-[#16A34A] no-underline text-slate-500 flex items-center gap-1.5 transition-colors")
          i.fa-solid.fa-house(class="text-xs text-[#16A34A]")
          span Trang chủ
        span.text-slate-300 /
        a(href="/rooms" class="hover:text-[#16A34A] no-underline text-slate-500 transition-colors") Tất cả phòng
        span.text-slate-300 /
        span(class="text-slate-800 font-semibold truncate max-w-[200px] sm:max-w-none")= cleanName

      //- Banner nhắc nhở nếu chính chủ trọ đang xem hồ sơ công khai của mình
      if isOwner
        div(class="rounded-2xl border border-emerald-200 bg-emerald-50/90 p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 shadow-xs")
          div(class="flex items-center gap-3")
            div(class="w-9 h-9 rounded-xl bg-[#16A34A] text-white flex items-center justify-center shrink-0 shadow-xs")
              i.fa-solid.fa-eye(class="text-sm")
            div
              p(class="text-xs sm:text-sm font-bold text-emerald-900 m-0") Bạn đang xem trang hồ sơ công khai của chính mình
              p(class="text-[11px] sm:text-xs text-emerald-700 m-0 mt-0.5") Đây là giao diện khách thuê nhìn thấy khi xem bài đăng phòng của bạn. Khách thuê không thể chỉnh sửa thông tin này.
          a(href="/landlord/dashboard" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-bold bg-[#16A34A] hover:bg-[#15803D] text-white no-underline shadow-xs transition-colors shrink-0")
            i.fa-solid.fa-house-chimney-user
            span Về Kênh Quản lý Chủ Trọ →

      //- Hero Card: Thông tin tổng quan Chủ trọ
      .landlord-hero(class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-sm relative overflow-hidden")
        div(class="absolute top-0 right-0 -mr-20 -mt-20 w-80 h-80 bg-emerald-100/40 rounded-full blur-3xl pointer-events-none")
        div(class="absolute bottom-0 left-1/4 -mb-16 w-60 h-60 bg-teal-50/50 rounded-full blur-2xl pointer-events-none")

        div(class="relative z-10 flex flex-col md:flex-row items-center md:items-start gap-6 sm:gap-8")
          //- Avatar chủ trọ
          .avatar-box(class="relative shrink-0")
            img(
              src=landlord.avatar || "/admin/assets/images/avatar.jpg" 
              alt=cleanName 
              class="w-28 h-28 sm:w-32 sm:h-32 rounded-full object-cover border-4 border-white shadow-lg ring-2 ring-emerald-300/80 bg-slate-100"
            )
            if landlord.status === USER_STATUS.APPROVED
              span(class="absolute bottom-1 right-1 w-8 h-8 rounded-full bg-[#16A34A] text-white border-2 border-white flex items-center justify-center text-xs shadow-md" title="Chủ trọ đã được TroNest xác thực và phê duyệt")
                i.fa-solid.fa-check

          //- Thông tin & Thống kê
          div(class="flex-1 text-center md:text-left min-w-0")
            div(class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-3 justify-center md:justify-start mb-2")
              h1(class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight m-0")= cleanName
              div(class="flex items-center gap-2 flex-wrap justify-center md:justify-start")
                span(class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200/80")
                  i.fa-solid.fa-house-user(class="text-[11px] text-[#16A34A]")
                  | Chủ trọ cho thuê
                if landlord.status === USER_STATUS.APPROVED
                  span(class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200/80")
                    i.fa-solid.fa-circle-check(class="text-[11px] text-emerald-600")
                    | Đã xác thực uy tín

            p(class="text-xs sm:text-sm text-slate-500 m-0 mb-4")
              i.fa-regular.fa-calendar-check(class="mr-1.5 text-[#16A34A]")
              | Thành viên TroNest từ: #{new Date(landlord.createdAt).toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' })}

            //- Quick Stats Bar
            div(class="grid grid-cols-2 sm:grid-cols-3 gap-3 max-w-xl mx-auto md:mx-0")
              div(class="bg-slate-50 rounded-2xl p-3 border border-slate-200/80 text-center md:text-left")
                div(class="text-lg sm:text-xl font-extrabold text-[#16A34A]")= totalRooms
                div(class="text-[11px] font-medium text-slate-500") Phòng đang mở thuê
              div(class="bg-slate-50 rounded-2xl p-3 border border-slate-200/80 text-center md:text-left")
                div(class="text-lg sm:text-xl font-extrabold text-emerald-600")
                  i.fa-solid.fa-shield-halved(class="text-base mr-1")
                  | 100%
                div(class="text-[11px] font-medium text-slate-500") Độ xác thực tin đăng
              div(class="bg-slate-50 rounded-2xl p-3 border border-slate-200/80 text-center md:text-left col-span-2 sm:col-span-1")
                div(class="text-lg sm:text-xl font-extrabold text-amber-600")
                  i.fa-solid.fa-bolt(class="text-base mr-1")
                  | Nhanh chóng
                div(class="text-[11px] font-medium text-slate-500") Tốc độ phản hồi

          //- Nút hành động liên hệ nổi bật (Sticky/Prominent Contact Actions)
          div(class="w-full md:w-auto flex flex-col sm:flex-row md:flex-col gap-2.5 shrink-0 justify-center")
            if landlord.phone
              a(
                href=`tel:${landlord.phone}` 
                class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full bg-[#16A34A] hover:bg-[#15803D] text-white text-xs sm:text-sm font-bold shadow-md shadow-emerald-600/25 transition-all no-underline active:scale-95 cursor-pointer"
                title="Gọi điện trực tiếp cho chủ trọ"
              )
                i.fa-solid.fa-phone
                span= landlord.phone
              a(
                href=`https://zalo.me/${landlord.phone}` 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-200 text-xs sm:text-sm font-bold shadow-xs transition-all no-underline active:scale-95 cursor-pointer"
                title="Mở ứng dụng Zalo để chat trực tiếp"
              )
                i.fa-solid.fa-comment-dots
                span Nhắn tin Zalo
            if fbLink
              a(
                href=fbLink 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition-all no-underline cursor-pointer"
                title="Xem trang Facebook cá nhân"
              )
                i.fa-brands.fa-facebook(class="text-[#1877F2]")
                span Facebook cá nhân

      //- Nội dung chính: 2 Cột (Thông tin liên hệ & Danh sách phòng đăng)
      div(class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start")
        //- Cột trái: Chi tiết liên hệ & Cam kết an toàn
        div(class="lg:col-span-1 space-y-6")
          //- Card Thông tin liên hệ
          div(class="bg-white rounded-3xl p-6 border border-slate-200/90 shadow-sm")
            h2(class="text-base font-bold text-slate-800 m-0 mb-4 pb-3 border-b border-slate-100 flex items-center gap-2")
              i.fa-solid.fa-address-card(class="text-[#16A34A]")
              | Thông tin liên hệ
            
            ul(class="space-y-4 list-none p-0 m-0 text-xs sm:text-sm")
              li(class="flex items-start gap-3")
                div(class="w-8 h-8 rounded-xl bg-emerald-50 text-[#16A34A] flex items-center justify-center shrink-0 mt-0.5")
                  i.fa-solid.fa-phone
                div(class="min-w-0 flex-1")
                  div(class="text-[11px] font-medium text-slate-400") Số điện thoại
                  if landlord.phone
                    a(href=`tel:${landlord.phone}` class="font-bold text-slate-800 hover:text-[#16A34A] no-underline")= landlord.phone
                  else
                    span(class="text-slate-400 italic") Chưa cập nhật
              
              li(class="flex items-start gap-3")
                div(class="w-8 h-8 rounded-xl bg-emerald-50 text-[#16A34A] flex items-center justify-center shrink-0 mt-0.5")
                  i.fa-regular.fa-envelope
                div(class="min-w-0 flex-1")
                  div(class="text-[11px] font-medium text-slate-400") Hộp thư Email
                  if landlord.email
                    a(href=`mailto:${landlord.email}` class="font-bold text-slate-800 hover:text-[#16A34A] no-underline break-all")= landlord.email
                  else
                    span(class="text-slate-400 italic") Chưa cập nhật
              
              li(class="flex items-start gap-3")
                div(class="w-8 h-8 rounded-xl bg-emerald-50 text-[#16A34A] flex items-center justify-center shrink-0 mt-0.5")
                  i.fa-solid.fa-location-dot
                div(class="min-w-0 flex-1")
                  div(class="text-[11px] font-medium text-slate-400") Khu vực / Địa chỉ
                  span(class="font-semibold text-slate-800")= landlord.address || "Đang cập nhật"

              if fbLink
                li(class="flex items-start gap-3")
                  div(class="w-8 h-8 rounded-xl bg-blue-50 text-[#1877F2] flex items-center justify-center shrink-0 mt-0.5")
                    i.fa-brands.fa-facebook
                  div(class="min-w-0 flex-1")
                    div(class="text-[11px] font-medium text-slate-400") Mạng xã hội
                    a(href=fbLink target="_blank" rel="noopener noreferrer" class="font-semibold text-[#1877F2] hover:underline no-underline break-all flex items-center gap-1")
                      span= landlord.facebook
                      i.fa-solid.fa-arrow-up-right-from-square(class="text-[10px]")

          //- Card Lưu ý an toàn khi thuê phòng
          div(class="bg-white rounded-3xl p-6 border border-slate-200/90 shadow-sm")
            div(class="flex items-center gap-2.5 mb-3 text-slate-800 font-bold text-sm")
              span(class="w-7 h-7 rounded-lg bg-emerald-100 text-[#16A34A] flex items-center justify-center text-xs shrink-0")
                i.fa-solid.fa-shield-halved
              | Lưu ý an toàn khi thuê trọ
            ul(class="space-y-2 text-xs text-slate-600 pl-4 m-0")
              li Nên trực tiếp đến xem phòng thực tế và kiểm tra tiện nghi trước khi đặt cọc.
              li Yêu cầu cung cấp rõ ràng các khoản phí phát sinh (tiền điện, nước, internet, rác).
              li Đọc kỹ hợp đồng thuê trọ và các điều khoản hoàn trả tiền cọc khi kết thúc hợp đồng.
              li Báo cáo ngay cho ban quản trị TroNest nếu phát hiện tin đăng sai sự thật.

        //- Cột phải: Danh sách các bài đăng phòng trọ của chủ trọ này
        div(class="lg:col-span-2 space-y-6")
          div(class="bg-white rounded-3xl p-6 sm:p-7 border border-slate-200/90 shadow-sm")
            div(class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6 pb-4 border-b border-slate-100")
              div
                h2(class="text-lg sm:text-xl font-extrabold text-slate-900 m-0 flex items-center gap-2")
                  i.fa-solid.fa-list-check(class="text-[#16A34A]")
                  | Phòng trọ đang cho thuê
                p(class="text-xs text-slate-500 m-0 mt-1") Toàn bộ danh sách các phòng trọ của chủ trọ #{cleanName} đã được kiểm duyệt
              span(class="px-3.5 py-1.5 rounded-full bg-emerald-50 text-[#16A34A] text-xs font-bold border border-emerald-200/80 self-start sm:self-auto")
                | #{totalRooms} phòng khả dụng

            if rooms && rooms.length > 0
              div(class="grid grid-cols-1 md:grid-cols-2 gap-5")
                each room in rooms
                  +roomItem(room, favoriteRoomIds)
            else
              div(class="text-center py-12 px-4 rounded-2xl bg-slate-50 border border-dashed border-slate-200")
                div(class="w-16 h-16 rounded-full bg-emerald-50 text-[#16A34A] flex items-center justify-center text-2xl mx-auto mb-3")
                  i.fa-solid.fa-house-circle-check
                h3(class="text-sm sm:text-base font-bold text-slate-800 mb-1") Hiện tại chưa có bài đăng phòng nào đang mở
                p(class="text-xs text-slate-500 max-w-md mx-auto m-0") Các phòng trọ của chủ trọ này có thể đã được thuê hết. Quý khách vui lòng liên hệ trực tiếp qua số điện thoại hoặc quay lại sau!
                if landlord.phone
                  a(href=`tel:${landlord.phone}` class="inline-flex items-center gap-2 mt-4 px-4 py-2 rounded-full bg-[#16A34A] text-white text-xs font-bold no-underline shadow-xs hover:bg-[#15803D] transition-colors")
                    i.fa-solid.fa-phone
                    span Gọi điện thoại hỏi phòng

