extends ../layouts/default.pug
include ../mixins/room-item.pug

block title
  title Danh sách phòng trọ cho thuê - TroNest

block main
  main(style="padding: 40px 0;")
    .container
      // Breadcrumb / Title Bar
      div(style="margin-bottom: 24px;")
        h1(style="font-size: 28px; font-weight: 800; color: #1e293b; margin: 0 0 8px;")
          | Danh Sách Phòng Trọ Cho Thuê
        p(style="color: #64748b; font-size: 14px; margin: 0;")
          | Tìm thấy 
          b(style="color: #006241;")= totalRooms
          |  căn phòng đã được phê duyệt phù hợp với nhu cầu của bạn

      .layout-room-list(style="display: grid; grid-template-columns: 280px 1fr; gap: 30px; align-items: start;")
        // Sidebar Filter
        aside.filter-sidebar(style="background: #fff; padding: 24px; border-radius: 16px; border: 1px solid #D4E9E2; box-shadow: 0 4px 15px rgba(0,98,65,0.03); position: sticky; top: 20px;")
          div(style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid #EBF5F1; padding-bottom: 12px;")
            h3(style="font-size: 18px; font-weight: 700; color: #1E3932; margin: 0; display: flex; align-items: center; gap: 8px;")
              i.fa-solid.fa-filter(style="color: #006241;")
              | Bộ lọc tìm kiếm
            a(href="/rooms" style="font-size: 13px; color: #D48B38; font-weight: 600;") Đặt lại

          form(action="/rooms" method="GET")
            // Từ khóa
            .form-group(style="margin-bottom: 18px;")
              label(style="display: block; font-size: 13px; font-weight: 700; color: #1E3932; margin-bottom: 6px;") Từ khóa
              input(type="text" name="keyword" value=query.keyword || "" placeholder="Tên đường, địa chỉ..." style="width: 100%; padding: 10px 12px; border: 1px solid #D4E9E2; border-radius: 8px; font-size: 14px; background: #F7F6F2; color: #1E3932;")

            // Quận Huyện
            .form-group(style="margin-bottom: 18px;")
              label(style="display: block; font-size: 13px; font-weight: 700; color: #1E3932; margin-bottom: 6px;") Quận / Huyện
              select(name="district" style="width: 100%; padding: 10px 12px; border: 1px solid #D4E9E2; border-radius: 8px; font-size: 14px; background: #F7F6F2; color: #1E3932;")
                option(value="") -- Tất cả quận huyện --
                option(value="Cầu Giấy" selected=query.district === 'Cầu Giấy') Cầu Giấy
                option(value="Đống Đa" selected=query.district === 'Đống Đa') Đống Đa
                option(value="Hai Bà Trưng" selected=query.district === 'Hai Bà Trưng') Hai Bà Trưng
                option(value="Thanh Xuân" selected=query.district === 'Thanh Xuân') Thanh Xuân
                option(value="Nam Từ Liêm" selected=query.district === 'Nam Từ Liêm') Nam Từ Liêm
                option(value="Bắc Từ Liêm" selected=query.district === 'Bắc Từ Liêm') Bắc Từ Liêm
                option(value="Ba Đình" selected=query.district === 'Ba Đình') Ba Đình
                option(value="Hoàng Mai" selected=query.district === 'Hoàng Mai') Hoàng Mai

            // Loại phòng
            .form-group(style="margin-bottom: 18px;")
              label(style="display: block; font-size: 13px; font-weight: 700; color: #1E3932; margin-bottom: 6px;") Loại phòng
              select(name="category" style="width: 100%; padding: 10px 12px; border: 1px solid #D4E9E2; border-radius: 8px; font-size: 14px; background: #F7F6F2; color: #1E3932;")
                option(value="") -- Tất cả loại phòng --
                each cat in categories
                  option(value=cat.slug selected=query.category === cat.slug || query.category === cat._id.toString())= cat.title

            // Khoảng giá
            .form-group(style="margin-bottom: 18px;")
              label(style="display: block; font-size: 13px; font-weight: 700; color: #1E3932; margin-bottom: 6px;") Mức giá thuê
              select(name="priceRange" style="width: 100%; padding: 10px 12px; border: 1px solid #D4E9E2; border-radius: 8px; font-size: 14px; background: #F7F6F2; color: #1E3932;")
                option(value="") -- Mọi mức giá --
                option(value="<2m" selected=query.priceRange === '<2m') Dưới 2 triệu
                option(value="2-4m" selected=query.priceRange === '2-4m') 2 triệu - 4 triệu
                option(value="4-7m" selected=query.priceRange === '4-7m') 4 triệu - 7 triệu
                option(value=">7m" selected=query.priceRange === '>7m') Trên 7 triệu

            // Diện tích
            .form-group(style="margin-bottom: 24px;")
              label(style="display: block; font-size: 13px; font-weight: 700; color: #1E3932; margin-bottom: 6px;") Diện tích (m²)
              select(name="areaRange" style="width: 100%; padding: 10px 12px; border: 1px solid #D4E9E2; border-radius: 8px; font-size: 14px; background: #F7F6F2; color: #1E3932;")
                option(value="") -- Mọi diện tích --
                option(value="<20" selected=query.areaRange === '<20') Dưới 20 m²
                option(value="20-30" selected=query.areaRange === '20-30') 20 - 30 m²
                option(value="30-50" selected=query.areaRange === '30-50') 30 - 50 m²
                option(value=">50" selected=query.areaRange === '>50') Trên 50 m²

            button(type="submit" style="width: 100%; padding: 12px; background: #006241; color: #fff; font-weight: 700; border: none; border-radius: 8px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; box-shadow: 0 3px 10px rgba(0,98,65,0.2);")
              i.fa-solid.fa-filter
              | Áp dụng bộ lọc

        // Rooms Grid & Sort
        section.room-content
          // Sort Bar
          .sort-bar(style="background: #fff; padding: 14px 20px; border-radius: 12px; border: 1px solid #D4E9E2; margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: gap;")
            span(style="font-size: 14px; font-weight: 600; color: #1E3932;") Sắp xếp theo:
            div(style="display: flex; gap: 8px; flex-wrap: wrap;")
              a(href=`/rooms?${new URLSearchParams({...query, sort: 'newest'}).toString()}` style=`padding: 6px 12px; border-radius: 6px; font-size: 13px; font-weight: 600; ${!query.sort || query.sort === 'newest' ? 'background: #006241; color: #fff;' : 'background: #EBF5F1; color: #1E3932;'}`) Mới nhất
              a(href=`/rooms?${new URLSearchParams({...query, sort: 'price-asc'}).toString()}` style=`padding: 6px 12px; border-radius: 6px; font-size: 13px; font-weight: 600; ${query.sort === 'price-asc' ? 'background: #006241; color: #fff;' : 'background: #EBF5F1; color: #1E3932;'}`) Giá thấp đến cao
              a(href=`/rooms?${new URLSearchParams({...query, sort: 'price-desc'}).toString()}` style=`padding: 6px 12px; border-radius: 6px; font-size: 13px; font-weight: 600; ${query.sort === 'price-desc' ? 'background: #006241; color: #fff;' : 'background: #EBF5F1; color: #1E3932;'}`) Giá cao đến thấp
              a(href=`/rooms?${new URLSearchParams({...query, sort: 'area-desc'}).toString()}` style=`padding: 6px 12px; border-radius: 6px; font-size: 13px; font-weight: 600; ${query.sort === 'area-desc' ? 'background: #006241; color: #fff;' : 'background: #EBF5F1; color: #1E3932;'}`) Diện tích lớn

          // Rooms Grid
          if rooms && rooms.length > 0
            .rooms-grid(style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 24px; margin-bottom: 30px;")
              each room in rooms
                +roomItem(room, favoriteRoomIds)

            // Pagination
            if totalPages > 1
              .pagination(style="display: flex; justify-content: center; gap: 8px; margin-top: 40px;")
                - for (let p = 1; p <= totalPages; p++)
                  a(href=`/rooms?${new URLSearchParams({...query, page: p}).toString()}` style=`width: 38px; height: 38px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 14px; text-decoration: none; ${p === currentPage ? 'background: #006241; color: #fff;' : 'background: #fff; color: #1E3932; border: 1px solid #D4E9E2;'}`)
                    = p
          else
            div(style="text-align: center; padding: 60px 20px; background: #fff; border-radius: 16px; border: 1px solid #D4E9E2;")
              i.fa-solid.fa-house-circle-xmark(style="font-size: 48px; color: #D4E9E2; margin-bottom: 16px;")
              h3(style="font-size: 18px; color: #1E3932; margin: 0 0 8px;") Không tìm thấy phòng trọ phù hợp
              p(style="color: #5C6F68; font-size: 14px; margin: 0 0 20px;") Vui lòng thử tìm kiếm bằng từ khóa khác hoặc xóa bớt tiêu chí lọc
              a(href="/rooms" style="padding: 10px 20px; background: #006241; color: #fff; border-radius: 8px; font-weight: 600; font-size: 14px;") Xem tất cả phòng
