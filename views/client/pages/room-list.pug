extends ../layouts/default.pug
include ../mixins/room-item.pug
include ../../shared/pagination.pug

block title
  title Danh sách phòng trọ cho thuê - TroNest

block main
  main(class="client-clean-001")
    .container
      // Breadcrumb / Title Bar
      div(class="client-clean-094")
        h1(class="client-clean-095")
          | Danh Sách Phòng Trọ Cho Thuê
        p(class="client-clean-096")
          | Tìm thấy 
          b(class="client-clean-059")= totalRooms
          |  căn phòng đã được phê duyệt phù hợp với nhu cầu của bạn

      .layout-room-list(class="client-clean-097")
        // Sidebar Filter
        aside.filter-sidebar(class="client-clean-098")
          div(class="client-clean-099")
            h3(class="client-clean-100")
              i.fa-solid.fa-filter(class="client-clean-059")
              | Bộ lọc tìm kiếm
            a(href="/rooms" class="client-clean-101") Đặt lại

          form(action="/rooms" method="GET")
            // Từ khóa
            .form-group(class="client-clean-102")
              label(class="client-clean-103") Từ khóa
              input(type="text" name="keyword" value=query.keyword || "" placeholder="Tên đường, địa chỉ..." class="client-clean-104")

            // Quận Huyện
            .form-group(class="client-clean-102")
              label(class="client-clean-103") Quận / Huyện
              select(name="district" class="client-clean-104")
                option(value="") -- Tất cả quận huyện --
                each district in ROOM_DISTRICTS
                  option(value=district selected=query.district === district)= district

            // Loại phòng
            .form-group(class="client-clean-102")
              label(class="client-clean-103") Loại phòng
              select(name="category" class="client-clean-104")
                option(value="") -- Tất cả loại phòng --
                each cat in categories
                  option(value=cat.slug selected=query.category === cat.slug || query.category === cat._id.toString())= cat.title

            // Khoảng giá
            .form-group(class="client-clean-102")
              label(class="client-clean-103") Mức giá thuê
              select(name="priceRange" class="client-clean-104")
                option(value="") -- Mọi mức giá --
                option(value="<2m" selected=query.priceRange === '<2m') Dưới 2 triệu
                option(value="2-4m" selected=query.priceRange === '2-4m') 2 triệu - 4 triệu
                option(value="4-7m" selected=query.priceRange === '4-7m') 4 triệu - 7 triệu
                option(value=">7m" selected=query.priceRange === '>7m') Trên 7 triệu

            // Diện tích
            .form-group(class="client-clean-094")
              label(class="client-clean-103") Diện tích (m²)
              select(name="areaRange" class="client-clean-104")
                option(value="") -- Mọi diện tích --
                option(value="<20" selected=query.areaRange === '<20') Dưới 20 m²
                option(value="20-30" selected=query.areaRange === '20-30') 20 - 30 m²
                option(value="30-50" selected=query.areaRange === '30-50') 30 - 50 m²
                option(value=">50" selected=query.areaRange === '>50') Trên 50 m²

            button(type="submit" class="client-clean-105")
              i.fa-solid.fa-filter
              | Áp dụng bộ lọc

        // Rooms Grid & Sort
        section.room-content
          // Sort Bar
          .sort-bar(class="client-clean-106")
            span(class="client-clean-107") Sắp xếp theo:
            div(class="client-clean-108")
              a.room-sort-link(href=`/rooms?${new URLSearchParams({...query, sort: 'newest'}).toString()}` class=!query.sort || query.sort === 'newest' ? 'is-active' : '') Mới nhất
              a.room-sort-link(href=`/rooms?${new URLSearchParams({...query, sort: 'price-asc'}).toString()}` class=query.sort === 'price-asc' ? 'is-active' : '') Giá thấp đến cao
              a.room-sort-link(href=`/rooms?${new URLSearchParams({...query, sort: 'price-desc'}).toString()}` class=query.sort === 'price-desc' ? 'is-active' : '') Giá cao đến thấp
              a.room-sort-link(href=`/rooms?${new URLSearchParams({...query, sort: 'area-desc'}).toString()}` class=query.sort === 'area-desc' ? 'is-active' : '') Diện tích lớn

          // Rooms Grid
          if rooms && rooms.length > 0
            .rooms-grid(class="client-clean-109")
              each room in rooms
                +roomItem(room, favoriteRoomIds)

            // Pagination
            +pagination(paging, query, '/rooms')
          else
            div(class="client-clean-111")
              i.fa-solid.fa-house-circle-xmark(class="client-clean-112")
              h3(class="client-clean-113") Không tìm thấy phòng trọ phù hợp
              p(class="client-clean-114") Vui lòng thử tìm kiếm bằng từ khóa khác hoặc xóa bớt tiêu chí lọc
              a(href="/rooms" class="client-clean-115") Xem tất cả phòng
