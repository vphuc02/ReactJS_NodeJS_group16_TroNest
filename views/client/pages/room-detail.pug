extends ../layouts/default.pug
include ../mixins/room-item.pug

block title
  title= `${room.title} - TroNest`

block main
  main(class="client-clean-001")
    .container
      // Breadcrumb
      nav(class="client-clean-002")
        a(href="/" class="client-clean-003") Trang chủ
        span /
        a(href="/rooms" class="client-clean-003") Phòng trọ
        span /
        if room.categoryId
          a(href=`/rooms?category=${room.categoryId.slug}` class="client-clean-003")= room.categoryId.title
        else
          span Loại phòng không còn hoạt động
        span /
        span(class="client-clean-004")= room.district

      .room-detail-layout(class="client-clean-005")
        // Main Details Column
        .room-main(class="client-clean-006")
          // Title & Meta
          div(class="client-clean-007")
            div
              span.badge.badge-green(class="client-clean-008")= room.categoryId ? room.categoryId.title : 'Phòng trọ'
              h1(class="client-clean-009")= room.title
              div(class="client-clean-010")
                span
                  i.fa-solid.fa-location-dot(class="client-clean-011")
                  | #{room.address}, #{room.ward ? room.ward + ', ' : ''}#{room.district}, #{room.province}
                span
                  i.fa-solid.fa-eye(class="client-clean-012")
                  | #{room.views} lượt xem
                span
                  i.fa-regular.fa-clock(class="client-clean-012")
                  | #{new Date(room.createdAt).toLocaleDateString('vi-VN')}

            // Nút Lưu yêu thích
            button.btn-fav.room-detail-fav(class=isFavorited ? 'active' : '' data-room-id=room._id.toString() title="Lưu phòng yêu thích")
              if isFavorited
                i.fa-solid.fa-heart(class="client-clean-013")
              else
                i.fa-regular.fa-heart

          // Gallery Images
          .room-gallery(class="client-clean-014")
            .main-image(class="client-clean-015")
              img(src=room.thumbnail || "/client/assets/images/product-1.jpg" alt=room.title class="client-clean-016")
            if room.images && room.images.length > 1
              .thumb-list(class="client-clean-017")
                each img in room.images
                  img(src=img alt=room.title data-gallery-thumb class="client-clean-018")

          // Highlights specs box
          .highlight-specs(class="client-clean-019")
            div
              span(class="client-clean-020") Giá thuê
              b(class="client-clean-021") #{room.price.toLocaleString('vi-VN')} đ/tháng
            div
              span(class="client-clean-020") Diện tích
              b(class="client-clean-022") #{room.area} m²
            div
              span(class="client-clean-020") Tiền đặt cọc
              b(class="client-clean-022") #{room.deposit ? room.deposit.toLocaleString('vi-VN') + ' đ' : 'Thỏa thuận'}
            div
              span(class="client-clean-020") Sức chứa
              b(class="client-clean-022") #{room.capacity || 2} người

          // Chi phí phụ lục (Điện, nước, dịch vụ)
          .service-fees(class="client-clean-023")
            h3(class="client-clean-024")
              i.fa-solid.fa-bolt(class="client-clean-025")
              | Chi phí dịch vụ tham khảo
            div(class="client-clean-026")
              div
                span(class="client-clean-003") Tiền điện: 
                b(class="client-clean-027")= room.electricityPrice || ROOM_DEFAULTS.electricityPrice
              div
                span(class="client-clean-003") Tiền nước: 
                b(class="client-clean-027")= room.waterPrice || ROOM_DEFAULTS.waterPrice
              div
                span(class="client-clean-003") Dịch vụ khác: 
                b(class="client-clean-027")= room.servicePrice || ROOM_DEFAULTS.servicePrice

          // Tiện ích phòng trọ
          if room.amenities && room.amenities.length > 0
            .room-amenities(class="client-clean-014")
              h3(class="client-clean-028") Tiện ích & Cơ sở vật chất
              .amenities-grid(class="client-clean-029")
                each item in room.amenities
                  div(class="client-clean-030")
                    i.fa-solid.fa-circle-check(class="client-clean-031")
                    span= item

          // Mô tả chi tiết
          .room-description(class="client-clean-032")
            h3(class="client-clean-033") Mô tả chi tiết
            div(class="client-clean-034")= room.description

        // Sidebar Landlord Contact Column
        aside.landlord-sidebar(class="client-clean-035")
          // Landlord Contact Card
          .landlord-card(class="client-clean-036")
            div(class="client-clean-037")
              img(src=(room.landlordId && room.landlordId.avatar) || "/admin/assets/images/avatar.jpg" alt=room.landlordId ? room.landlordId.fullName : "" class="client-clean-038")
              span(class="client-clean-039" title="Chủ trọ đã được duyệt xác thực")
                i.fa-solid.fa-check

            h3(class="client-clean-040")
              = room.landlordId ? room.landlordId.fullName : "Chủ trọ TroNest"
            span.badge.badge-green(class="client-clean-041") Chủ trọ uy tín (Đã duyệt)

            if room.landlordId && room.landlordId.phone
              div(class="client-clean-042")
                a(href=`tel:${room.landlordId.phone}` class="client-clean-043")
                  i.fa-solid.fa-phone
                  span= room.landlordId.phone
              
              div(class="client-clean-044")
                a(href=`https://zalo.me/${room.landlordId.phone}` target="_blank" class="client-clean-045")
                  i.fa-solid.fa-comment-dots
                  span Nhắn tin Zalo
            else
              p(class="client-clean-046") Liên hệ hỗ trợ TroNest

            hr(class="client-clean-047")

            div(class="client-clean-048")
              if room.landlordId && room.landlordId.email
                div
                  i.fa-regular.fa-envelope(class="client-clean-049")
                  span= room.landlordId.email
              if room.landlordId && room.landlordId.address
                div
                  i.fa-solid.fa-location-dot(class="client-clean-049")
                  span= room.landlordId.address

          // Safe rental advice
          .advice-box(class="client-clean-050")
            div(class="client-clean-051")
              i.fa-solid.fa-shield-halved
              | Lưu ý an toàn khi thuê phòng
            ul(class="client-clean-052")
              li Không chuyển tiền cọc khi chưa xem phòng trực tiếp.
              li Kiểm tra kỹ hợp đồng thuê và các khoản phí dịch vụ phát sinh.
              li Báo cáo với Ban quản trị TroNest nếu phát hiện tin giả.

      // Related Rooms
      if relatedRooms && relatedRooms.length > 0
        section(class="client-clean-053")
          h2(class="client-clean-054") Phòng trọ tương tự trong khu vực
          .rooms-grid(class="client-clean-055")
            each related in relatedRooms
              +roomItem(related, [])
