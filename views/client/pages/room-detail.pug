extends ../layouts/default.pug
include ../mixins/room-item.pug

block title
  title= `${room.title} - TroNest`

block main
  main(style="padding: 40px 0;")
    .container
      // Breadcrumb
      nav(style="margin-bottom: 20px; font-size: 14px; color: #64748b; display: flex; align-items: center; gap: 8px;")
        a(href="/" style="color: #64748b;") Trang chủ
        span /
        a(href="/rooms" style="color: #64748b;") Phòng trọ
        span /
        a(href=`/rooms?category=${room.categoryId.slug}` style="color: #64748b;")= room.categoryId.title
        span /
        span(style="color: #1e293b; font-weight: 600;")= room.district

      .room-detail-layout(style="display: grid; grid-template-columns: 2fr 1fr; gap: 30px; align-items: start;")
        // Main Details Column
        .room-main(style="background: #fff; padding: 30px; border-radius: 20px; border: 1px solid #e2e8f0; box-shadow: 0 4px 15px rgba(0,0,0,0.03);")
          // Title & Meta
          div(style="display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; margin-bottom: 16px;")
            div
              span.badge.badge-green(style="margin-bottom: 10px;")= room.categoryId.title
              h1(style="font-size: 24px; font-weight: 800; color: #1E3932; line-height: 1.4; margin: 0 0 10px;")= room.title
              div(style="display: flex; align-items: center; gap: 16px; font-size: 14px; color: #5C6F68; flex-wrap: wrap;")
                span
                  i.fa-solid.fa-location-dot(style="color: #006241; margin-right: 6px;")
                  | #{room.address}, #{room.ward ? room.ward + ', ' : ''}#{room.district}, #{room.province}
                span
                  i.fa-solid.fa-eye(style="margin-right: 6px;")
                  | #{room.views} lượt xem
                span
                  i.fa-regular.fa-clock(style="margin-right: 6px;")
                  | #{new Date(room.createdAt).toLocaleDateString('vi-VN')}

            // Nút Lưu yêu thích
            button.btn-fav(class=isFavorited ? 'active' : '' data-room-id=room._id.toString() style="position: static; width: 44px; height: 44px; font-size: 20px; border: 1px solid #D4E9E2;" title="Lưu phòng yêu thích")
              if isFavorited
                i.fa-solid.fa-heart(style="color: #D48B38;")
              else
                i.fa-regular.fa-heart

          // Gallery Images
          .room-gallery(style="margin-bottom: 30px;")
            .main-image(style="height: 400px; border-radius: 14px; overflow: hidden; margin-bottom: 12px; border: 1px solid #D4E9E2;")
              img(src=room.thumbnail || "/client/assets/images/product-1.jpg" alt=room.title style="width: 100%; height: 100%; object-fit: cover;")
            if room.images && room.images.length > 1
              .thumb-list(style="display: flex; gap: 10px; overflow-x: auto;")
                each img in room.images
                  img(src=img alt=room.title style="width: 100px; height: 75px; object-fit: cover; border-radius: 8px; cursor: pointer; border: 2px solid transparent;" onclick=`this.closest('.room-gallery').querySelector('.main-image img').src = this.src`)

          // Highlights specs box
          .highlight-specs(style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; padding: 20px; background: #F7F6F2; border: 1px solid #D4E9E2; border-radius: 14px; margin-bottom: 30px; text-align: center;")
            div
              span(style="font-size: 13px; color: #5C6F68; display: block; margin-bottom: 4px;") Giá thuê
              b(style="font-size: 18px; color: #006241;") #{room.price.toLocaleString('vi-VN')} đ/tháng
            div
              span(style="font-size: 13px; color: #5C6F68; display: block; margin-bottom: 4px;") Diện tích
              b(style="font-size: 18px; color: #1E3932;") #{room.area} m²
            div
              span(style="font-size: 13px; color: #5C6F68; display: block; margin-bottom: 4px;") Tiền đặt cọc
              b(style="font-size: 18px; color: #1E3932;") #{room.deposit ? room.deposit.toLocaleString('vi-VN') + ' đ' : 'Thỏa thuận'}
            div
              span(style="font-size: 13px; color: #5C6F68; display: block; margin-bottom: 4px;") Sức chứa
              b(style="font-size: 18px; color: #1E3932;") #{room.capacity || 2} người

          // Chi phí phụ lục (Điện, nước, dịch vụ)
          .service-fees(style="margin-bottom: 30px; padding: 20px; border: 1px dashed #cbd5e1; border-radius: 14px;")
            h3(style="font-size: 16px; font-weight: 700; color: #1e293b; margin: 0 0 14px;")
              i.fa-solid.fa-bolt(style="color: #f59e0b; margin-right: 8px;")
              | Chi phí dịch vụ tham khảo
            div(style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; font-size: 14px;")
              div
                span(style="color: #64748b;") Tiền điện: 
                b(style="color: #334155;")= room.electricityPrice || '3.800 đ/kWh'
              div
                span(style="color: #64748b;") Tiền nước: 
                b(style="color: #334155;")= room.waterPrice || '30.000 đ/m³'
              div
                span(style="color: #64748b;") Dịch vụ khác: 
                b(style="color: #334155;")= room.servicePrice || '100.000 đ/tháng'

          // Tiện ích phòng trọ
          if room.amenities && room.amenities.length > 0
            .room-amenities(style="margin-bottom: 30px;")
              h3(style="font-size: 18px; font-weight: 700; color: #1e293b; margin: 0 0 16px;") Tiện ích & Cơ sở vật chất
              .amenities-grid(style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 12px;")
                each item in room.amenities
                  div(style="display: flex; align-items: center; gap: 8px; padding: 10px 14px; background: #f1f5f9; border-radius: 8px; font-size: 14px; color: #334155;")
                    i.fa-solid.fa-circle-check(style="color: #16a34a;")
                    span= item

          // Mô tả chi tiết
          .room-description(style="line-height: 1.7; color: #5C6F68; font-size: 15px;")
            h3(style="font-size: 18px; font-weight: 700; color: #1E3932; margin: 0 0 14px;") Mô tả chi tiết
            div(style="white-space: pre-line;")= room.description

        // Sidebar Landlord Contact Column
        aside.landlord-sidebar(style="position: sticky; top: 20px; display: flex; flex-direction: column; gap: 20px;")
          // Landlord Contact Card
          .landlord-card(style="background: #fff; padding: 24px; border-radius: 20px; border: 1px solid #D4E9E2; box-shadow: 0 4px 15px rgba(0,98,65,0.03); text-align: center;")
            div(style="position: relative; width: 80px; height: 80px; margin: 0 auto 16px;")
              img(src=(room.landlordId && room.landlordId.avatar) || "/admin/assets/images/avatar.jpg" alt=room.landlordId ? room.landlordId.fullName : "" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%; border: 3px solid #D4E9E2;")
              span(style="position: absolute; bottom: 0; right: 0; background: #006241; color: #fff; width: 22px; height: 22px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 11px;" title="Chủ trọ đã được duyệt xác thực")
                i.fa-solid.fa-check

            h3(style="font-size: 18px; font-weight: 700; color: #1E3932; margin: 0 0 4px;")
              = room.landlordId ? room.landlordId.fullName : "Chủ trọ TroNest"
            span.badge.badge-green(style="margin-bottom: 16px;") Chủ trọ uy tín (Đã duyệt)

            if room.landlordId && room.landlordId.phone
              div(style="margin-bottom: 12px;")
                a(href=`tel:${room.landlordId.phone}` style="display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; padding: 14px; background: #006241; color: #fff; border-radius: 12px; font-weight: 700; font-size: 16px; text-decoration: none; box-shadow: 0 4px 12px rgba(0, 98, 65, 0.25);")
                  i.fa-solid.fa-phone
                  span= room.landlordId.phone
              
              div(style="margin-bottom: 20px;")
                a(href=`https://zalo.me/${room.landlordId.phone}` target="_blank" style="display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; padding: 12px; background: #0068ff; color: #fff; border-radius: 12px; font-weight: 700; font-size: 15px; text-decoration: none;")
                  i.fa-solid.fa-comment-dots
                  span Nhắn tin Zalo
            else
              p(style="color: #5C6F68; font-size: 14px;") Liên hệ hỗ trợ TroNest

            hr(style="border: 0; border-top: 1px solid #EBF5F1; margin: 16px 0;")

            div(style="text-align: left; font-size: 13px; color: #5C6F68; line-height: 1.8;")
              if room.landlordId && room.landlordId.email
                div
                  i.fa-regular.fa-envelope(style="width: 20px; color: #006241;")
                  span= room.landlordId.email
              if room.landlordId && room.landlordId.address
                div
                  i.fa-solid.fa-location-dot(style="width: 20px; color: #006241;")
                  span= room.landlordId.address

          // Safe rental advice
          .advice-box(style="background: #EBF5F1; padding: 20px; border-radius: 16px; border: 1px solid #D4E9E2; font-size: 13px; color: #1E3932; line-height: 1.6;")
            div(style="font-weight: 700; display: flex; align-items: center; gap: 8px; margin-bottom: 8px; font-size: 14px; color: #006241;")
              i.fa-solid.fa-shield-halved
              | Lưu ý an toàn khi thuê phòng
            ul(style="padding-left: 20px; margin: 0; color: #5C6F68;")
              li Không chuyển tiền cọc khi chưa xem phòng trực tiếp.
              li Kiểm tra kỹ hợp đồng thuê và các khoản phí dịch vụ phát sinh.
              li Báo cáo với Ban quản trị TroNest nếu phát hiện tin giả.

      // Related Rooms
      if relatedRooms && relatedRooms.length > 0
        section(style="margin-top: 60px;")
          h2(style="font-size: 22px; font-weight: 800; color: #1E3932; margin-bottom: 24px;") Phòng trọ tương tự trong khu vực
          .rooms-grid(style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 24px;")
            each related in relatedRooms
              +roomItem(related, [])
