extends ../layouts/default.pug

block title
  title Thông tin tài khoản - TroNest

block main
  - const displayName = profile.fullName ? profile.fullName.replace(/\s*\([^)]*\)/g, '') : ''
  - const isActive = !profile.isBlocked && profile.status !== 'INACTIVE'
  - const fmtDate = (d) => d ? new Date(d).toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' }) : '—'

  main(class="client-clean-001")
    .container
      div(class="client-clean-094")
        h1(class="client-clean-116")
          i.fa-solid.fa-circle-user(class="text-[#EA580C]")
          | Thông Tin Tài Khoản
        p(class="client-clean-117") Xem thông tin cá nhân của bạn trên TroNest

      div(class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start")
        //- Thẻ tóm tắt
        div(class="bg-white rounded-2xl border border-neutral-200 shadow-sm overflow-hidden")
          div(class="h-24 bg-gradient-to-r from-orange-400 to-[#EA580C]")
          div(class="px-6 pb-6 -mt-12 flex flex-col items-center text-center")
            img(src=profile.avatar || "/admin/assets/images/avatar.jpg" alt=displayName class="w-24 h-24 rounded-full object-cover border-4 border-white shadow-md bg-white")
            h2(class="mt-3 mb-1 text-xl font-bold text-neutral-800")= displayName
            span(class="text-xs px-2.5 py-1 rounded-full font-medium bg-emerald-100 text-emerald-700") Khách thuê
            div(class="mt-5 grid grid-cols-2 gap-3 w-full")
              a(href="/favorites" class="rounded-xl border border-neutral-200 p-3 no-underline hover:border-orange-300 hover:bg-orange-50/50 transition-all duration-200")
                div(class="text-2xl font-extrabold text-[#EA580C]")= favoriteCount
                div(class="text-xs text-neutral-500 mt-0.5") Phòng đã lưu
              div(class="rounded-xl border border-neutral-200 p-3")
                div(class=`text-sm font-bold mt-1.5 ${isActive ? 'text-emerald-600' : 'text-red-600'}`)= isActive ? 'Hoạt động' : 'Bị khóa'
                div(class="text-xs text-neutral-500 mt-1") Trạng thái

        //- Chi tiết thông tin
        div(class="lg:col-span-2 bg-white rounded-2xl border border-neutral-200 shadow-sm p-6")
          h3(class="m-0 mb-5 text-lg font-bold text-neutral-800 flex items-center gap-2")
            i.fa-solid.fa-id-card(class="text-[#EA580C]")
            | Thông tin cá nhân

          -
            const rows = [
              { icon: 'fa-user', label: 'Họ và tên', value: displayName },
              { icon: 'fa-envelope', label: 'Email', value: profile.email },
              { icon: 'fa-phone', label: 'Số điện thoại', value: profile.phone },
              { icon: 'fa-location-dot', label: 'Địa chỉ', value: profile.address },
              { icon: 'fa-calendar-plus', label: 'Ngày tham gia', value: fmtDate(profile.createdAt) },
              { icon: 'fa-clock-rotate-left', label: 'Cập nhật gần nhất', value: fmtDate(profile.updatedAt) }
            ]

          dl(class="m-0 divide-y divide-neutral-100")
            each row in rows
              div(class="py-3.5 grid grid-cols-1 sm:grid-cols-3 gap-1 sm:gap-4")
                dt(class="text-sm text-neutral-500 flex items-center gap-2")
                  i(class=`fa-solid ${row.icon} w-4 text-neutral-400`)
                  | #{row.label}
                dd(class="m-0 sm:col-span-2 text-sm font-semibold text-neutral-800 break-words")
                  if row.value
                    | #{row.value}
                  else
                    span(class="font-normal italic text-neutral-400") Chưa cập nhật
