extends ../layouts/default.pug

block title
  title Thông tin tài khoản - TroNest

block main
  - const displayName = profile.fullName ? profile.fullName.replace(/\s*\([^)]*\)/g, '') : ''
  - const isActive = !profile.isBlocked && profile.status !== 'INACTIVE'
  - const fmtDate = (d) => d ? new Date(d).toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' }) : '—'

  main(class="client-clean-001")
    .container
      div(class="client-clean-094")
        h1(class="client-clean-116")
          i.fa-solid.fa-circle-user(class="text-[#16A34A]")
          | Thông Tin Tài Khoản
        p(class="client-clean-117") Xem thông tin cá nhân của bạn trên TroNest

      div(class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-stretch")
        //- Thẻ tóm tắt bên trái (Cân bằng không gian)
        div(class="bg-white rounded-2xl border border-neutral-200 shadow-sm overflow-hidden flex flex-col justify-between")
          div
            div(class="h-32 bg-gradient-to-r from-emerald-400 via-[#16A34A] to-teal-500")
            div(class="px-6 pb-6 -mt-16 flex flex-col items-center text-center")
              img(src=profile.avatar || "/admin/assets/images/avatar.jpg" alt=displayName class="w-28 h-28 rounded-full object-cover border-4 border-white shadow-lg bg-white")
              h2(class="mt-4 mb-1 text-2xl font-bold text-neutral-800")= displayName
              span(class="text-xs px-3 py-1 rounded-full font-semibold bg-emerald-100 text-emerald-800") Khách thuê

              div(class="mt-6 grid grid-cols-2 gap-4 w-full")
                a(href="/favorites" class="rounded-xl border border-neutral-200 p-4 no-underline hover:border-emerald-400 hover:bg-emerald-50/50 transition-all duration-200 text-center flex flex-col justify-center items-center shadow-xs")
                  div(class="text-3xl font-extrabold text-[#16A34A]")= favoriteCount
                  div(class="text-xs font-medium text-neutral-500 mt-1") Phòng đã lưu
                div(class="rounded-xl border border-neutral-200 p-4 text-center flex flex-col justify-center items-center shadow-xs")
                  div(class=`text-base font-bold mt-1 ${isActive ? 'text-emerald-600' : 'text-red-600'}`)= isActive ? 'Hoạt động' : 'Bị khóa'
                  div(class="text-xs font-medium text-neutral-500 mt-1") Trạng thái tài khoản

          div(class="p-6 pt-0")
            div(class="p-4 rounded-xl bg-emerald-50/60 border border-emerald-100 text-xs text-neutral-600 flex items-start gap-2.5")
              i.fa-solid.fa-shield-halved(class="text-[#16A34A] text-sm mt-0.5")
              span Tài khoản của bạn được bảo mật an toàn. Mọi thông tin liên hệ được dùng để thuận tiện kết nối và tìm kiếm phòng trọ nhanh chóng.

        //- Chi tiết thông tin bên phải (Cân bằng không gian 50/50)
        div(class="bg-white rounded-2xl border border-neutral-200 shadow-sm p-6 flex flex-col justify-between")
          div
            h3(class="m-0 mb-4 pb-3 border-b border-neutral-100 text-lg font-bold text-neutral-800 flex items-center gap-2")
              i.fa-solid.fa-id-card(class="text-[#16A34A]")
              | Thông tin cá nhân

            -
              const rows = [
                { icon: 'fa-user', label: 'Họ và tên', value: displayName },
                { icon: 'fa-envelope', label: 'Email', value: profile.email },
                { icon: 'fa-phone', label: 'Số điện thoại', value: profile.phone },
                { icon: 'fa-location-dot', label: 'Địa chỉ', value: profile.address },
                { icon: 'fa-calendar-plus', label: 'Ngày tham gia', value: fmtDate(profile.createdAt) },
                { icon: 'fa-clock-rotate-left', label: 'Cập nhật gần nhất', value: fmtDate(profile.updatedAt) }
              ]

            dl(class="m-0 divide-y divide-neutral-100")
              each row in rows
                div(class="py-3.5 grid grid-cols-1 sm:grid-cols-3 gap-1 sm:gap-4 items-center")
                  dt(class="text-sm font-medium text-neutral-500 flex items-center gap-2")
                    i(class=`fa-solid ${row.icon} w-4 text-neutral-400`)
                    | #{row.label}
                  dd(class="m-0 sm:col-span-2 text-sm font-semibold text-neutral-800 break-words")
                    if row.value
                      | #{row.value}
                    else
                      span(class="font-normal italic text-neutral-400") Chưa cập nhật
