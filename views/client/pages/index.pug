extends ../layouts/default.pug
include ../mixins/room-item.pug

block title
  title TroNest - Tìm kiếm và Đăng tin phòng trọ tiện lợi, an tâm

block main
  main
    // Hero Banner Section
    .section-1(style="padding: 70px 0; background: linear-gradient(135deg, #EBF5F1 0%, #F7F6F2 100%); border-bottom: 1px solid #D4E9E2;")
      .container
        .inner-wrap(style="text-align: center; max-width: 900px; margin: 0 auto;")
          h1.inner-title(data-aos="fade-up" data-aos-duration="800" style="font-size: 38px; font-weight: 800; color: #1E3932; line-height: 1.3; margin-bottom: 16px;")
            | Tìm Phòng Trọ Nhanh Chóng, An Toàn & Đã Kiểm Duyệt
            br
            span(style="color: #006241;") Ngôi Nhà Thứ Hai Dành Cho Bạn
          
          p.inner-desc(data-aos="fade-up" data-aos-delay="100" data-aos-duration="800" style="font-size: 16px; color: #5C6F68; margin-bottom: 35px;")
            | Hơn 10.000+ phòng trọ khép kín, chung cư mini, studio và sleepbox trên toàn quốc được Admin kiểm duyệt chất lượng 100%.

          // Search Box Form
          form.inner-form(action="/rooms" method="GET" data-aos="fade-up" data-aos-delay="200" data-aos-duration="800" style="background: #fff; padding: 20px; border-radius: 20px; border: 1px solid #D4E9E2; box-shadow: 0 10px 30px rgba(0,98,65,0.06); display: flex; flex-wrap: wrap; gap: 15px; align-items: center;")
            // Input từ khóa
            div(style="flex: 2; min-width: 200px; text-align: left;")
              label(style="font-size: 12px; font-weight: 700; color: #1E3932; display: block; margin-bottom: 6px;") Từ khóa / Khu vực
              div(style="display: flex; align-items: center; gap: 8px; background: #F7F6F2; border: 1px solid #D4E9E2; border-radius: 10px; padding: 10px 14px;")
                i.fa-solid.fa-magnifying-glass(style="color: #006241;")
                input(type="text" name="keyword" placeholder="Nhập tên đường, địa chỉ..." style="border: none; background: transparent; outline: none; width: 100%; font-size: 14px; color: #1E3932;")

            // Quận Huyện
            div(style="flex: 1.2; min-width: 150px; text-align: left;")
              label(style="font-size: 12px; font-weight: 700; color: #1E3932; display: block; margin-bottom: 6px;") Quận / Huyện
              select(name="district" style="width: 100%; padding: 10px 14px; background: #F7F6F2; border: 1px solid #D4E9E2; border-radius: 10px; font-size: 14px; outline: none; color: #1E3932;")
                option(value="") Tất cả quận huyện
                option(value="Cầu Giấy") Cầu Giấy
                option(value="Đống Đa") Đống Đa
                option(value="Hai Bà Trưng") Hai Bà Trưng
                option(value="Thanh Xuân") Thanh Xuân
                option(value="Nam Từ Liêm") Nam Từ Liêm
                option(value="Bắc Từ Liêm") Bắc Từ Liêm
                option(value="Ba Đình") Ba Đình
                option(value="Hoàng Mai") Hoàng Mai

            // Khoảng giá
            div(style="flex: 1.2; min-width: 150px; text-align: left;")
              label(style="font-size: 12px; font-weight: 700; color: #1E3932; display: block; margin-bottom: 6px;") Khoảng giá thuê
              select(name="priceRange" style="width: 100%; padding: 10px 14px; background: #F7F6F2; border: 1px solid #D4E9E2; border-radius: 10px; font-size: 14px; outline: none; color: #1E3932;")
                option(value="") Mọi mức giá
                option(value="<2m") Dưới 2 triệu
                option(value="2-4m") 2 - 4 triệu
                option(value="4-7m") 4 - 7 triệu
                option(value=">7m") Trên 7 triệu

            // Nút Tìm Kiếm
            div(style="flex: 0.8; min-width: 120px; align-self: flex-end;")
              button(type="submit" style="width: 100%; padding: 12px 20px; background: #006241; color: #fff; font-weight: 700; border: none; border-radius: 10px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 15px; box-shadow: 0 4px 12px rgba(0,98,65,0.25);")
                i.fa-solid.fa-magnifying-glass
                | Tìm kiếm
    // End Hero Banner

    // Categories Section
    section(style="padding: 50px 0;")
      .container
        h2(data-aos="fade-up" style="font-size: 26px; font-weight: 800; color: #1E3932; text-align: center; margin-bottom: 30px;")
          | Khám Phá Theo Loại Hình Phòng Trọ
        
        .categories-grid(style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px;" data-aos="fade-up" data-aos-delay="100")
          each cat in categories
            a(href=`/rooms?category=${cat.slug}` style="background: #fff; padding: 24px 20px; border-radius: 16px; text-align: center; border: 1px solid #D4E9E2; box-shadow: 0 4px 15px rgba(0,98,65,0.03); transition: all 0.3s ease; text-decoration: none; display: flex; flex-direction: column; align-items: center;")
              div(style="width: 55px; height: 55px; border-radius: 14px; background: #D4E9E2; display: flex; align-items: center; justify-content: center; font-size: 24px; color: #006241; margin-bottom: 14px;")
                i(class=cat.icon || "fa-solid fa-house-chimney")
              h3(style="font-size: 16px; font-weight: 700; color: #1E3932; margin: 0 0 6px;")= cat.title
              p(style="font-size: 12px; color: #5C6F68; margin: 0;")= cat.description || 'Xem danh sách phòng'

    // Featured Rooms Section
    if featuredRooms && featuredRooms.length > 0
      section(style="padding: 40px 0 60px; background: #fff;")
        .container
          div(style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 30px;")
            div
              span.badge.badge-gold(style="margin-bottom: 8px;") Nổi bật nhất
              h2(style="font-size: 26px; font-weight: 800; color: #1E3932; margin: 0;") Phòng Trọ Đáng Thuê Nhất
            a(href="/rooms" style="color: #006241; font-weight: 700; display: flex; align-items: center; gap: 6px; font-size: 15px;")
              | Xem tất cả (#{featuredRooms.length}+)
              i.fa-solid.fa-arrow-right
          
          .rooms-grid(style="display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 24px;")
            each room in featuredRooms
              +roomItem(room, favoriteRoomIds)

    // Latest Rooms Section
    section(style="padding: 60px 0;")
      .container
        div(style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 30px;")
          div
            span.badge.badge-green(style="margin-bottom: 8px;") Mới đăng & Đã duyệt
            h2(style="font-size: 26px; font-weight: 800; color: #1E3932; margin: 0;") Phòng Trọ Mới Phê Duyệt
          a(href="/rooms" style="color: #006241; font-weight: 700; display: flex; align-items: center; gap: 6px; font-size: 15px;")
            | Xem thêm phòng khác
            i.fa-solid.fa-arrow-right
        
        if latestRooms && latestRooms.length > 0
          .rooms-grid(style="display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 24px;")
            each room in latestRooms
              +roomItem(room, favoriteRoomIds)
        else
          p(style="text-align: center; color: #5C6F68; padding: 40px 0;") Hiện chưa có bài đăng nào được phê duyệt.

    // Trust & Benefits Section
    section(style="padding: 60px 0; background: #fff; border-top: 1px solid #D4E9E2;")
      .container
        h2(style="font-size: 26px; font-weight: 800; color: #1E3932; text-align: center; margin-bottom: 40px;")
          | Vì Sao Nên Tìm Phòng & Đăng Tin Tại TroNest?
        .benefits-grid(style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 30px;")
          .benefit-box(style="padding: 24px; border-radius: 16px; background: #F7F6F2; border: 1px solid #D4E9E2; text-align: center;")
            div(style="width: 50px; height: 50px; border-radius: 50%; background: #D4E9E2; color: #006241; display: flex; align-items: center; justify-content: center; font-size: 22px; margin: 0 auto 16px;")
              i.fa-solid.fa-shield-halved
            h3(style="font-size: 17px; font-weight: 700; margin: 0 0 10px; color: #1E3932;") 100% Đã Kiểm Duyệt
            p(style="font-size: 14px; color: #5C6F68; margin: 0; line-height: 1.5;") Mọi bài đăng và thông tin chủ trọ đều được Admin xác minh tính xác thực trước khi hiển thị.
          
          .benefit-box(style="padding: 24px; border-radius: 16px; background: #F7F6F2; border: 1px solid #D4E9E2; text-align: center;")
            div(style="width: 50px; height: 50px; border-radius: 50%; background: #FDF4E3; color: #B45309; display: flex; align-items: center; justify-content: center; font-size: 22px; margin: 0 auto 16px;")
              i.fa-solid.fa-handshake
            h3(style="font-size: 17px; font-weight: 700; margin: 0 0 10px; color: #1E3932;") Trực Tiếp Chính Chủ
            p(style="font-size: 14px; color: #5C6F68; margin: 0; line-height: 1.5;") Khách thuê liên hệ thẳng với Chủ trọ qua Số điện thoại, Email mà không qua trung gian môi giới.
          
          .benefit-box(style="padding: 24px; border-radius: 16px; background: #F7F6F2; border: 1px solid #D4E9E2; text-align: center;")
            div(style="width: 50px; height: 50px; border-radius: 50%; background: #EBF5F1; color: #00754A; display: flex; align-items: center; justify-content: center; font-size: 22px; margin: 0 auto 16px;")
              i.fa-solid.fa-heart-circle-check
            h3(style="font-size: 17px; font-weight: 700; margin: 0 0 10px; color: #1E3932;") Lưu Phòng Yêu Thích
            p(style="font-size: 14px; color: #5C6F68; margin: 0; line-height: 1.5;") Dễ dàng đánh dấu và so sánh các căn phòng ưng ý với tính năng danh sách yêu thích tiện lợi.
