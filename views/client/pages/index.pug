extends ../layouts/default.pug
include ../mixins/room-item.pug

block title
  title TroNest - Tìm kiếm và Đăng tin phòng trọ tiện lợi, an tâm

block main
  main
    // Hero Banner & Search Section (Phong cách Hotelier Luxury Hospitality)
    h1.visually-hidden TroNest - Nền tảng tìm kiếm và đăng tin phòng trọ tiện lợi, an tâm
    section.hero-banner-section
      .swiper.hero-banner-swiper
        .swiper-wrapper
          .swiper-slide
            .hero-slide-item
              img(src="/client/assets/images/hero-banners/banner-1.png" alt="Phòng trọ gác lửng thông minh TroNest")
          .swiper-slide
            .hero-slide-item
              img(src="/client/assets/images/hero-banners/banner-2.png" alt="Căn hộ studio sang trọng tiện nghi")
          .swiper-slide
            .hero-slide-item
              img(src="/client/assets/images/hero-banners/banner-3.png" alt="Phòng trọ gác lửng phong cách hiện đại")
          .swiper-slide
            .hero-slide-item
              img(src="/client/assets/images/hero-banners/banner-4.png" alt="Căn hộ mini duplex trần cao sang trọng")
        
        // Editorial Luxury Overlay ("Find Your Perfect Stay.")
        .hero-editorial-overlay
          .container.hero-editorial-container
            .hero-editorial-left(data-aos="fade-up")
              span.hero-editorial-badge
                i.fa-solid.fa-gem
                | KHÔNG GIAN SỐNG & LƯU TRÚ TINH TẾ
              h2.hero-editorial-title
                | Find Your
                br
                | Perfect Stay.
              p.hero-editorial-subtitle
                | Trải nghiệm chuẩn mực tìm kiếm phòng trọ, studio và căn hộ dịch vụ đã xác thực với không gian kiến trúc ấm cúng, minh bạch và an tâm tuyệt đối.
              div(class="flex flex-wrap items-center gap-3 pt-1")
                a.btn-hotelier.btn-hotelier-bronze(href="/rooms")
                  span Khám Phá Ngay
                  span.btn-hotelier-icon
                    i.fa-solid.fa-arrow-right

            .hero-editorial-right(data-aos="fade-left" data-aos-delay="150")
              .hero-floating-card
                .hero-floating-card-top
                  span.hero-floating-tag TroNest Signature
                  span.hero-floating-rating
                    i.fa-solid.fa-star
                    | 4.9
                .hero-floating-img-wrap
                  img(src="/client/assets/images/hero-banners/banner-4.png" alt="Studio & Duplex Tuyển Chọn")
                .hero-floating-card-body
                  div
                    div.hero-floating-card-title Studio & Căn Hộ Dịch Vụ
                    div.hero-floating-card-meta Kiểm duyệt thực tế • Đầy đủ nội thất
                  a.hero-floating-card-btn(href="/rooms" aria-label="Xem danh sách phòng")
                    i.fa-solid.fa-arrow-up-right-from-square

        // Swiper Controls (Nút chuyển ảnh & Chấm phân trang)
        .swiper-button-prev.hero-swiper-btn.hero-swiper-prev
        .swiper-button-next.hero-swiper-btn.hero-swiper-next
        .swiper-pagination.hero-swiper-pagination

      // Thanh Tìm Kiếm Phòng Trọ kết hợp trực tiếp với Banner (Phong cách Hotelier Booking Bar)
      .hero-search-wrapper
        .container
          // Search Box Form
          form.home-search-form(action="/rooms" method="GET" data-aos="fade-up" data-aos-delay="100")
            .search-fields-grid
              // Input từ khóa
              .search-field-col.col-keyword
                label.search-field-label(for="home-keyword") Khu vực / Địa chỉ
                .search-input-wrapper
                  input#home-keyword.search-input-control(type="text" name="keyword" placeholder="Nhập tên đường, địa chỉ, trường học...")

              // Tỉnh / Thành phố
              .search-field-col.col-province
                label.search-field-label(for="home-province") Tỉnh / Thành phố
                .search-input-wrapper
                  select#home-province.search-select-control(name="province" data-location-province data-ward-target="#home-ward")
                    option(value="") Toàn quốc
                    each p in VN_PROVINCES
                      option(value=p.shortName data-code=p.code)= p.name

              // Phường / Xã
              .search-field-col.col-ward
                label.search-field-label(for="home-ward") Phường / Xã
                .search-input-wrapper
                  select#home-ward.search-select-control(name="ward" disabled)
                    option(value="") Chọn tỉnh trước

              // Khoảng giá
              .search-field-col.col-price
                label.search-field-label(for="home-price") Khoảng giá thuê
                .search-input-wrapper
                  select#home-price.search-select-control(name="priceRange")
                    option(value="") Mọi mức giá
                    option(value="<2m") Dưới 2 triệu
                    option(value="2-4m") 2 - 4 triệu
                    option(value="4-7m") 4 - 7 triệu
                    option(value=">7m") Trên 7 triệu

              // Nút Tìm Kiếm (Deep Charcoal Split-Icon Pill như "Book A Room" trong mẫu Hotelier)
              .search-field-col.col-submit
                button.btn-search-submit.btn-hotelier.btn-hotelier-dark(type="submit")
                  span Tìm Phòng Ngay
                  span.btn-hotelier-icon.pill-icon-circle
                    i.fa-solid.fa-magnifying-glass

              // Nút Vị trí của tôi
              .search-field-col.col-nearby
                button.btn-nearby-trigger(type="button" id="btn-find-nearby" data-find-nearby title="Tìm phòng trọ gần vị trí của bạn")
                  i.fa-solid.fa-location-crosshairs
                  span Trọ gần tôi

          // Quick Tag Suggestions (Gợi ý tìm nhanh gọn gàng)
          .search-quick-tags(data-aos="fade-up" data-aos-delay="150")
            span.quick-tags-title
              i.fa-solid.fa-sparkles
              | Gợi ý phổ biến:
            a.quick-tag-item(href="/rooms?priceRange=<2m") Dưới 2 triệu
            a.quick-tag-item(href="/rooms?priceRange=2-4m") Từ 2 - 4 triệu
            a.quick-tag-item(href="/rooms?category=can-ho-mini-studio") Studio tiện nghi
            a.quick-tag-item(href="/rooms?category=chung-cu-mini") Chung cư mini
            a.quick-tag-item(href="/rooms?province=Hà Nội") Hà Nội
            a.quick-tag-item(href="/rooms?province=Hồ Chí Minh") TP. Hồ Chí Minh
    // End Hero Banner & Search Section

    // Section 1: "About TroNest" Editorial Split Section (Matches "About Hotelier" in Reference)
    section.hotelier-about-section
      .container
        .hotelier-about-grid
          .hotelier-about-content(data-aos="fade-right")
            span.hotelier-eyebrow VỀ TRONEST • HOSPITALITY LIVING
            h2.hotelier-section-title
              | About TroNest —
              br
              | Nghệ Thuật Của Sự An Cư.
            p.hotelier-about-desc
              | Lấy cảm hứng từ tiêu chuẩn lưu trú khách sạn boutique cao cấp, TroNest mang đến trải nghiệm tìm kiếm phòng trọ, căn hộ studio và nhà nguyên căn minh bạch, chuẩn xác. Mỗi không gian trên hệ thống đều được chọn lọc kỹ lưỡng, xác thực chủ nhà và niêm yết chi phí rõ ràng.
            .hotelier-about-actions
              a.btn-hotelier.btn-hotelier-outline(href="/rooms")
                span Tìm Hiểu Thêm
                span.btn-hotelier-icon
                  i.fa-solid.fa-arrow-right

          .hotelier-about-pillars(data-aos="fade-left" data-aos-delay="100")
            .hotelier-pillar-card
              img(src="/client/assets/images/hero-banners/banner-1.png" alt="Không gian phòng trọ gác lửng tinh tế" loading="lazy")
            .hotelier-pillar-card.pillar-offset
              img(src="/client/assets/images/hero-banners/banner-2.png" alt="Nội thất studio ấm cúng hiện đại" loading="lazy")
            .hotelier-pillar-card
              img(src="/client/assets/images/hero-banners/banner-4.png" alt="Kiến trúc căn hộ dịch vụ cao cấp" loading="lazy")

    // Section 2: Warm Bronze Amenity & Service Strip (#A67C52 Full-Width Bar)
    section.hotelier-bronze-strip
      .container
        .hotelier-strip-grid
          .hotelier-strip-item
            span.hotelier-strip-icon
              i.fa-solid.fa-map-location-dot
            div
              strong Vị Trí Đắc Địa
              span Kết nối trường học & trung tâm
          .hotelier-strip-item
            span.hotelier-strip-icon
              i.fa-solid.fa-shield-check
              i.fa-solid.fa-certificate
            div
              strong Phòng Xác Thực 100%
              span Kiểm duyệt thực tế minh bạch
          .hotelier-strip-item
            span.hotelier-strip-icon
              i.fa-solid.fa-couch
            div
              strong Nội Thất Tinh Tế
              span Tiện nghi sẵn sàng dọn vào ở
          .hotelier-strip-item
            span.hotelier-strip-icon
              i.fa-solid.fa-lock
            div
              strong An Ninh & Riêng Tư
              span Khóa vân tay, camera 24/7
          .hotelier-strip-item
            span.hotelier-strip-icon
              i.fa-solid.fa-headset
            div
              strong Hỗ Trợ Tận Tâm 24/7
              span Kết nối trực tiếp chủ nhà uy tín

    // Section 3: Nearby Rooms Section (Ẩn mặc định, hiện khi user cho phép vị trí)
    section#nearby-rooms-section.nearby-rooms-section(style="display:none")
      .container
        .nearby-rooms-header
          .nearby-rooms-title-group
            span.nearby-badge
              i.fa-solid.fa-location-crosshairs
              | Gần bạn
            h2.nearby-title
              | Phòng trọ gần vị trí của bạn
            p.nearby-subtitle#nearby-location-label &nbsp;
          a.btn-view-all-nearby.btn-hotelier.btn-hotelier-outline(href="#" id="btn-view-all-nearby")
            span Xem tất cả
            span.btn-hotelier-icon
              i.fa-solid.fa-arrow-right
        
        // Loading skeleton
        .nearby-loading#nearby-loading
          .nearby-skeleton
          .nearby-skeleton
          .nearby-skeleton
          .nearby-skeleton
          .nearby-skeleton
          .nearby-skeleton
        
        // Error state
        .nearby-error#nearby-error(style="display:none")
          i.fa-solid.fa-triangle-exclamation
          span#nearby-error-msg Không thể xác định vị trí của bạn.

        // Rooms grid
        .rooms-grid.nearby-rooms-grid#nearby-rooms-grid(style="display:none")

    // Section 4: Dark Charcoal "Why Book With Us" Section (#1C1B19 Background)
    section.hotelier-why-section
      .container
        .hotelier-why-grid
          .hotelier-why-visual(data-aos="fade-right")
            .hotelier-why-img-box
              img(src="/client/assets/images/hero-banners/banner-3.png" alt="Kiến trúc lưu trú hiện đại TroNest" loading="lazy")
              .hotelier-why-floating-badge
                span.why-badge-score 4.9 ★
                div
                  strong Uy Tín Hàng Đầu
                  span Hơn 10.000+ khách thuê tin chọn

          .hotelier-why-content(data-aos="fade-left" data-aos-delay="100")
            span.hotelier-eyebrow(class="text-[#C59B6D]") WHY BOOK WITH US • VÌ SAO CHỌN TRONEST
            h2.hotelier-why-title
              | Chuẩn Mực Mới Trong Hành Trình Tìm Phòng Trọ
            p.hotelier-why-desc
              | Chúng tôi loại bỏ hoàn toàn nỗi lo tin ảo, phí ẩn hay trung gian thiếu minh bạch bằng quy trình kiểm duyệt khắt khe và nền tảng kết nối trực tiếp với chủ trọ đã xác thực.

            .hotelier-why-features
              .hotelier-why-feature-card
                span.why-feature-num 01
                h3 Minh Bạch Giá Thuê
                p Niêm yết rõ ràng giá phòng, điện, nước và dịch vụ ngay từ đầu, cam kết không phát sinh chi phí ẩn.
              .hotelier-why-feature-card
                span.why-feature-num 02
                h3 Chủ Nhà Xác Thực
                p Toàn bộ chủ trọ và bài đăng đều được Ban quản trị TroNest kiểm duyệt danh tính và hình ảnh thực tế.
              .hotelier-why-feature-card
                span.why-feature-num 03
                h3 Tìm Kiếm Thông Minh
                p Bộ lọc chính xác theo khu vực, ngân sách, diện tích và định vị GPS giúp tìm phòng gần bạn chỉ trong vài giây.
              .hotelier-why-feature-card
                span.why-feature-num 04
                h3 Hỗ Trợ Nhanh Chóng
                p Liên hệ trực tiếp qua điện thoại hoặc Zalo với chủ nhà không qua môi giới, đặt lịch xem phòng tức thì.

            div(class="pt-2")
              a.btn-hotelier.btn-hotelier-bronze(href="/rooms")
                span Xem Tất Cả Phòng
                span.btn-hotelier-icon
                  i.fa-solid.fa-arrow-right

    // Section 5: "Your Stay, Our Service" — Categories Vertical Showcase
    section(class="client-clean-070 hotelier-categories-section")
      .container
        div(class="text-center max-w-2xl mx-auto mb-10" data-aos="fade-up")
          span.hotelier-eyebrow YOUR STAY, OUR SERVICE
          h2(class="client-clean-071 mb-3")
            | Khám Phá Theo Loại Hình Lưu Trú
          p(class="text-sm sm:text-base text-[#6E6A63] m-0")
            | Đa dạng lựa chọn từ phòng đơn khép kín, căn hộ studio hiện đại đến nhà nguyên căn rộng rãi đáp ứng trọn vẹn nhu cầu sinh hoạt của bạn.
        
        -
          const catBgImages = [
            '/client/assets/images/hero-banners/banner-1.png',
            '/client/assets/images/hero-banners/banner-2.png',
            '/client/assets/images/hero-banners/banner-3.png',
            '/client/assets/images/hero-banners/banner-4.png'
          ];
        .categories-grid.hotelier-categories-grid(class="client-clean-072" data-aos="fade-up" data-aos-delay="100")
          each cat, idx in categories
            a(href=`/rooms?category=${cat.slug}` class="client-clean-073 hotelier-cat-card")
              img.hotelier-cat-bg(src=catBgImages[idx % catBgImages.length] alt=cat.title loading="lazy")
              .hotelier-cat-overlay
              div(class="client-clean-074 hotelier-cat-icon")
                i(class=cat.icon || "fa-solid fa-house-chimney")
              div.hotelier-cat-info
                span.hotelier-cat-count= (roomTypeCount && roomTypeCount[cat._id]) ? `${roomTypeCount[cat._id]} phòng sẵn sàng` : 'Khám phá không gian'
                h3(class="client-clean-075")= cat.title
                p(class="client-clean-076")= cat.description || 'Xem danh sách phòng tuyển chọn'

        div(class="text-center mt-10" data-aos="fade-up")
          a.btn-hotelier.btn-hotelier-outline(href="/rooms")
            span Khám Phá Tất Cả Loại Hình
            span.btn-hotelier-icon
              i.fa-solid.fa-arrow-right

    // Section 6: Warm Bronze Header Banner + Featured Rooms ("Choose Your Room" / Phòng Trọ Nổi Bật)
    if featuredRooms && featuredRooms.length > 0
      section(class="client-clean-077 hotelier-featured-section")
        .hotelier-bronze-banner
          .container
            div(class="text-center max-w-2xl mx-auto")
              span.hotelier-eyebrow(class="text-[#FAF7F2]/85") CHOOSE YOUR SPACE • TUYỂN CHỌN ĐẶC BIỆT
              h2.hotelier-bronze-banner-title Không Gian Lưu Trú Nổi Bật Nhất
              p.hotelier-bronze-banner-sub
                | Những căn phòng có vị trí thuận tiện, thiết kế thẩm mỹ và được cộng đồng người thuê đánh giá cao nhất tuần qua.
        .container.hotelier-featured-container
          .rooms-grid(class="client-clean-082")
            each room in featuredRooms
              +roomItem(room, favoriteRoomIds)
          
          div(class="text-center mt-10")
            a.btn-hotelier.btn-hotelier-bronze(href="/rooms")
              span Xem Tất Cả Phòng Nổi Bật (#{featuredRooms.length}+)
              span.btn-hotelier-icon
                i.fa-solid.fa-arrow-right

    // Section 8: Dark Editorial Testimonials + CTA Banner ("What People Say About Us")
    section.hotelier-testimonials-section
      .container
        .hotelier-testi-header
          div
            span.hotelier-eyebrow(class="text-[#C59B6D]") WHAT PEOPLE SAY ABOUT US
            h2.hotelier-testi-title Khách Thuê & Chủ Trọ Nói Gì Về TroNest
          .hotelier-testi-rating-box
            span.testi-stars ★★★★★
            span.testi-score 4.9 / 5.0 Đánh giá hài lòng

        .hotelier-testi-grid
          .hotelier-testi-card
            .testi-quote-mark “
            .testi-stars-sm ★★★★★
            p.testi-text
              | "Mình tìm được căn studio gần trường chỉ sau 1 buổi chiều trên TroNest. Hình ảnh trên web giống hệt thực tế, giá điện nước ghi rõ ràng nên cực kỳ yên tâm."
            .testi-author
              .testi-avatar M
              div
                strong Minh Anh
                span Sinh viên Đại học Quốc gia

          .hotelier-testi-card
            .testi-quote-mark “
            .testi-stars-sm ★★★★★
            p.testi-text
              | "Giao diện sang trọng, dễ lọc theo khu vực và mức giá. Mình thích nhất tính năng liên hệ trực tiếp Zalo với chủ nhà đã xác thực mà không phải qua môi giới."
            .testi-author
              .testi-avatar H
              div
                strong Hoàng Nam
                span Chuyên viên Thiết kế Nội thất

          .hotelier-testi-card
            .testi-quote-mark “
            .testi-stars-sm ★★★★★
            p.testi-text
              | "Từ khi đăng phòng lên TroNest, tòa căn hộ mini của tôi luôn lấp đầy nhanh chóng. Khách thuê văn minh, lịch sự và quy trình duyệt tin rất chuyên nghiệp."
            .testi-author
              .testi-avatar T
              div
                strong Cô Thanh Hương
                span Chủ hệ thống Căn hộ Studio

    // Section 9: Architectural Bottom CTA Banner
    section.hotelier-cta-section
      .container
        .hotelier-cta-banner
          .hotelier-cta-content
            span.hotelier-eyebrow(class="text-[#C59B6D]") BẮT ĐẦU HÀNH TRÌNH AN CƯ
            h2.hotelier-cta-title Bạn Đang Tìm Phòng Hay Muốn Đăng Tin Cho Thuê?
            p.hotelier-cta-desc
              | Tham gia cộng đồng lưu trú văn minh TroNest ngay hôm nay để tìm không gian sống hoàn hảo hoặc tiếp cận hàng ngàn khách thuê uy tín.
            div(class="flex flex-wrap items-center gap-3 pt-2")
              a.btn-hotelier.btn-hotelier-bronze(href="/rooms")
                span Tìm Phòng Ngay
                span.btn-hotelier-icon
                  i.fa-solid.fa-arrow-right
              a.btn-hotelier.btn-hotelier-outline(href="/landlord/rooms/create")
                span Đăng Tin Cho Thuê
                span.btn-hotelier-icon
                  i.fa-solid.fa-plus
          .hotelier-cta-image
            img(src="/client/assets/images/hero-banners/banner-4.png" alt="TroNest Luxury Living" loading="lazy")

    script.
      document.addEventListener('DOMContentLoaded', function() {
        // --- Swiper Hero Banner ---
        if (typeof Swiper !== 'undefined') {
          new Swiper('.hero-banner-swiper', {
            loop: true,
            speed: 800,
            effect: 'fade',
            fadeEffect: { crossFade: true },
            autoplay: { delay: 4000, disableOnInteraction: false, pauseOnMouseEnter: true },
            pagination: { el: '.hero-swiper-pagination', clickable: true },
            navigation: { nextEl: '.hero-swiper-next', prevEl: '.hero-swiper-prev' }
          });
        }

        // --- Geolocation: Trọ gần tôi ---
        const btnNearby   = document.getElementById('btn-find-nearby') || document.getElementById('find-nearby-btn');
        const section     = document.getElementById('nearby-rooms-section');
        const loading     = document.getElementById('nearby-loading');
        const errorBox    = document.getElementById('nearby-error');
        const errorMsg    = document.getElementById('nearby-error-msg');
        const grid        = document.getElementById('nearby-rooms-grid');
        const labelEl     = document.getElementById('nearby-location-label');
        const viewAllBtn  = document.getElementById('btn-view-all-nearby');

        if (!btnNearby) return;

        // Hiển thị giá tiền kiểu VN
        function formatPrice(p) {
          if (p >= 1000000) return (p / 1000000).toFixed(p % 1000000 === 0 ? 0 : 1) + ' triệu';
          return p.toLocaleString('vi-VN') + ' đ';
        }

        // Render 1 room card (đồng bộ với roomItem mixin phong cách Hotelier Warm Bronze)
        function renderRoom(room) {
          const thumb = room.thumbnail || '/client/assets/images/product-1.jpg';
          const catTitle = room.categoryId ? (room.categoryId.title || 'Phòng trọ') : 'Phòng trọ';
          const landlord = room.landlordId ? (room.landlordId.fullName || '').replace(/\s*\([^)]*\)/g, '') : 'Chủ trọ';
          const landlordAvatar = (room.landlordId && room.landlordId.avatar) || '';
          const landlordId = room.landlordId ? (room.landlordId._id || room.landlordId) : '';
          const address  = room.address || [room.ward, room.district, room.province].filter(Boolean).join(', ') || 'Đang cập nhật';
          const price    = (room.price || 0).toLocaleString('vi-VN') + ' đ';
          const imgCount = (room.images && room.images.length > 0) ? room.images.length : 1;

          // Badge khoảng cách GPS nếu có
          let distanceBadge = '';
          if (room.distanceM != null) {
            const dist = room.distanceM < 1000
              ? `${room.distanceM} m`
              : `${(room.distanceM / 1000).toFixed(1)} km`;
            distanceBadge = `
              <span class="backdrop-blur-md bg-[#1C1B19]/85 text-[#FAF7F2] text-[10px] sm:text-[11px] font-semibold px-2.5 py-0.5 rounded-full flex items-center gap-1 shadow-sm border border-white/15">
                <i class="fa-solid fa-location-crosshairs text-[10px] text-[#C59B6D]"></i> ${dist}
              </span>`;
          }

          // Tiện ích 1 & 2
          let amenity1 = 'WC khép kín';
          let amenity2 = (room.capacity ? room.capacity + ' người' : 'Tự do giờ');
          if (room.amenities && room.amenities.length > 0) {
            amenity1 = room.amenities[0];
            if (room.amenities.length > 1) {
              amenity2 = room.amenities[1];
            }
          }

          const avatarHtml = (landlordAvatar && !landlordAvatar.includes('avatar.jpg'))
            ? `<img src="${landlordAvatar}" alt="${landlord}" class="h-7 w-7 rounded-full object-cover border border-[#E6DFD3]" />`
            : `<div class="flex h-7 w-7 items-center justify-center rounded-full bg-[#F5EFE6] text-xs font-semibold text-[#8C6239] border border-[#E6DFD3]">${(landlord.charAt(0) || 'C').toUpperCase()}</div>`;

          return `
            <div class="product-item room-card-modern group relative flex flex-col overflow-hidden rounded-2xl border border-[#E6DFD3] bg-white transition-all duration-300 hover:-translate-y-1.5 hover:shadow-[0_20px_38px_rgba(28,27,25,0.09)] hover:border-[#D4C2AA] cursor-pointer" onclick="if(!event.target.closest('.btn-fav')) window.location.href='/rooms/detail/${room._id}'">
              <a href="/rooms/detail/${room._id}" class="room-card-overlay absolute inset-0 z-[2]" aria-label="${room.title}"></a>
              <div class="inner-image relative aspect-[4/3] w-full overflow-hidden bg-[#F5EFE6] flex-shrink-0">
                <img src="${thumb}" alt="${room.title}" loading="lazy" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
                <div class="absolute left-3 top-3 z-10 flex items-center gap-1.5 pointer-events-none">
                  <span class="rounded-full bg-[#1C1B19]/75 px-2.5 py-1 text-[11px] font-medium text-[#FAF7F2] backdrop-blur-md border border-white/15">
                    ${catTitle}
                  </span>
                  <span class="flex items-center gap-1 rounded-full bg-[#A67C52]/95 px-2.5 py-1 text-[11px] font-medium text-white backdrop-blur-md">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
                    Xác thực
                  </span>
                  ${distanceBadge}
                </div>
                <button type="button" class="btn-fav absolute right-3 top-3 z-20 flex h-8 w-8 items-center justify-center rounded-full bg-white/95 text-[#6E6A63] shadow-sm backdrop-blur-md transition-all hover:bg-white hover:scale-110 active:scale-95 border-0 cursor-pointer pointer-events-auto" data-room-id="${room._id}" title="Lưu vào danh sách yêu thích" aria-label="Lưu phòng">
                  <svg class="h-4 w-4 transition-colors fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                  </svg>
                </button>
                <span class="absolute bottom-2.5 right-3 z-10 flex items-center gap-1 rounded-full bg-[#1C1B19]/65 px-2.5 py-0.5 text-[11px] font-normal text-[#FAF7F2] backdrop-blur-sm pointer-events-none">
                  <i class="fa-regular fa-images text-[10px] text-[#C59B6D]"></i> ${imgCount}
                </span>
              </div>
              <div class="inner-content flex flex-1 flex-col p-4 z-[3]">
                <div class="mb-1.5 flex items-baseline gap-1">
                  <span class="price-main text-xl font-extrabold tracking-tight text-[#8C6239]">${price}</span>
                  <span class="text-xs font-medium text-[#6E6A63]">/tháng</span>
                </div>
                <h3 class="inner-title line-clamp-2 font-serif text-[17px] font-semibold leading-snug text-[#1C1B19] transition-colors group-hover:text-[#A67C52] m-0">
                  <a href="/rooms/detail/${room._id}" class="text-[#1C1B19] group-hover:text-[#A67C52] no-underline">${room.title}</a>
                </h3>
                <p class="inner-address mt-1.5 flex items-center gap-1 text-xs text-[#6E6A63] mb-0">
                  <svg class="h-3.5 w-3.5 shrink-0 text-[#A67C52]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                  <span class="truncate" title="${address}">${address}</span>
                </p>
                <div class="my-3 flex items-center gap-2.5 border-y border-[#F3EFE6] py-2.5 text-xs text-[#6E6A63]">
                  <span class="font-semibold text-[#1C1B19]">${room.area} m²</span>
                  <span class="text-[#D4C2AA]">•</span>
                  <span>${amenity1}</span>
                  <span class="text-[#D4C2AA]">•</span>
                  <span class="truncate">${amenity2}</span>
                </div>
                <div class="inner-footer mt-auto flex items-center justify-between pt-1">
                  ${landlordId
                    ? `<a href="/landlords/${landlordId}" title="Xem hồ sơ chủ trọ: ${landlord}" onclick="event.stopPropagation();" class="relative z-10 flex items-center gap-2 no-underline hover:opacity-85 transition-all group/author cursor-pointer">
                        ${avatarHtml}
                        <span class="text-xs font-medium text-[#6E6A63] group-hover/author:text-[#A67C52] transition-colors truncate max-w-[110px]">${landlord}</span>
                        <svg class="w-3.5 h-3.5 text-[#A67C52] shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
                      </a>`
                    : `<div class="flex items-center gap-2">
                        ${avatarHtml}
                        <span class="text-xs font-medium text-[#6E6A63] truncate max-w-[110px]">${landlord}</span>
                        <svg class="w-3.5 h-3.5 text-[#A67C52] shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
                      </div>`
                  }
                  <button type="button" class="flex items-center gap-1.5 rounded-full bg-[#F5EFE6] group-hover:bg-[#A67C52] text-[#8C6239] group-hover:text-white pl-3 pr-1.5 py-1 text-xs font-bold transition-all border border-[#E6DFD3] group-hover:border-[#A67C52] cursor-pointer shadow-2xs">
                    <span>Chi tiết</span>
                    <span class="w-5 h-5 rounded-full bg-white/90 text-[#1C1B19] flex items-center justify-center transition-transform group-hover:translate-x-0.5">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" /></svg>
                    </span>
                  </button>
                </div>
              </div>
            </div>`;
        }

        function showNearbyLoading() {
          section.style.display = '';
          loading.style.display = '';
          errorBox.style.display = 'none';
          grid.style.display = 'none';
          section.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        function showNearbyError(msg) {
          loading.style.display = 'none';
          errorMsg.textContent = msg;
          errorBox.style.display = '';
          grid.style.display = 'none';
        }

        function showNearbyRooms(rooms, province, geo, radiusM, source) {
          loading.style.display = 'none';
          errorBox.style.display = 'none';
          if (rooms.length === 0) {
            showNearbyError('Chưa có phòng trọ nào được đăng tại khu vực của bạn.');
            return;
          }
          grid.innerHTML = rooms.map(renderRoom).join('');
          grid.style.display = '';

          // Cập nhật label vị trí
          const locationHint = geo.city_district || geo.suburb || geo.road || province;
          const radiusKm = (radiusM / 1000).toFixed(0);
          const sourceLabel = source === 'gps' || source === 'mixed'
            ? `trong vòng ${radiusKm}km` : `thuộc ${province}`;
          labelEl.textContent = `📍 ${locationHint}, ${province} — ${sourceLabel}`;

          // Cập nhật link "Xem tất cả"
          viewAllBtn.href = '/rooms?province=' + encodeURIComponent(province);
        }

        async function fetchNearbyRooms(lat, lng) {
          showNearbyLoading();
          try {
            const resp = await fetch(`/api/geo/nearby?lat=${lat}&lng=${lng}&limit=6&radius=5000`);
            const data = await resp.json();
            if (!resp.ok || data.code !== 200) {
              showNearbyError(data.message || 'Không thể tải phòng trọ gần bạn.');
              return;
            }
            showNearbyRooms(data.rooms, data.province, data.geo, data.radiusM, data.source);
          } catch {
            showNearbyError('Lỗi kết nối. Vui lòng thử lại sau.');
          }
        }

        btnNearby.addEventListener('click', function () {
          if (!navigator.geolocation) {
            window.notyf?.error('Trình duyệt của bạn không hỗ trợ định vị vị trí.');
            return;
          }

          // Trạng thái loading trên nút
          btnNearby.disabled = true;
          btnNearby.classList.add('loading');
          const origHTML = btnNearby.innerHTML;
          btnNearby.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> <span>Đang xác định...</span>';

          navigator.geolocation.getCurrentPosition(
            function (pos) {
              btnNearby.disabled = false;
              btnNearby.classList.remove('loading');
              btnNearby.innerHTML = '<i class="fa-solid fa-location-crosshairs"></i> <span>Trọ gần tôi</span>';
              fetchNearbyRooms(pos.coords.latitude, pos.coords.longitude);
            },
            function (err) {
              btnNearby.disabled = false;
              btnNearby.classList.remove('loading');
              btnNearby.innerHTML = origHTML;
              const msgs = {
                1: 'Bạn đã từ chối quyền truy cập vị trí.',
                2: 'Không thể xác định vị trí của bạn.',
                3: 'Hết thời gian chờ xác định vị trí.'
              };
              window.notyf?.error(msgs[err.code] || 'Không thể lấy vị trí của bạn.');
            },
            { timeout: 10000, maximumAge: 300000, enableHighAccuracy: false }
          );
        });

        // Nếu có param ?lat=...&lng=... trên URL thì tự động hiển thị phòng gần vị trí đó
        const urlParams = new URLSearchParams(window.location.search);
        const urlLat = parseFloat(urlParams.get('lat'));
        const urlLng = parseFloat(urlParams.get('lng'));
        if (!isNaN(urlLat) && !isNaN(urlLng)) {
          fetchNearbyRooms(urlLat, urlLng);
        }
      });




