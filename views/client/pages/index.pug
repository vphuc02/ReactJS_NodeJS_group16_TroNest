extends ../layouts/default.pug
include ../mixins/room-item.pug

block title
  title TroNest - Tìm kiếm và Đăng tin phòng trọ tiện lợi, an tâm

block main
  main
    // Hero Banner Section
    .section-1(class="client-clean-056")
      .container
        .inner-wrap(class="client-clean-057")
          h1.inner-title(data-aos="fade-up" data-aos-duration="800" class="client-clean-058")
            | Tìm Phòng Trọ Nhanh Chóng, An Toàn & Đã Kiểm Duyệt
            br
            span(class="client-clean-059") Ngôi Nhà Thứ Hai Dành Cho Bạn
          
          p.inner-desc(data-aos="fade-up" data-aos-delay="100" data-aos-duration="800" class="client-clean-060")
            | Hơn 10.000+ phòng trọ khép kín, chung cư mini, studio và sleepbox trên toàn quốc được Admin kiểm duyệt chất lượng 100%.

          // Search Box Form
          form.inner-form(action="/rooms" method="GET" data-aos="fade-up" data-aos-delay="200" data-aos-duration="800" class="client-clean-061")
            // Input từ khóa
            div(class="client-clean-062")
              label(class="client-clean-063") Từ khóa / Khu vực
              div(class="client-clean-064")
                i.fa-solid.fa-magnifying-glass(class="client-clean-059")
                input(type="text" name="keyword" placeholder="Nhập tên đường, địa chỉ..." class="client-clean-065")

            // Quận Huyện
            div(class="client-clean-066")
              label(class="client-clean-063") Quận / Huyện
              select(name="district" class="client-clean-067")
                option(value="") Tất cả quận huyện
                each district in ROOM_DISTRICTS
                  option(value=district)= district

            // Khoảng giá
            div(class="client-clean-066")
              label(class="client-clean-063") Khoảng giá thuê
              select(name="priceRange" class="client-clean-067")
                option(value="") Mọi mức giá
                option(value="<2m") Dưới 2 triệu
                option(value="2-4m") 2 - 4 triệu
                option(value="4-7m") 4 - 7 triệu
                option(value=">7m") Trên 7 triệu

            // Nút Tìm Kiếm
            div(class="client-clean-068")
              button(type="submit" class="client-clean-069")
                i.fa-solid.fa-magnifying-glass
                | Tìm kiếm
    // End Hero Banner

    // Categories Section
    section(class="client-clean-070")
      .container
        h2(data-aos="fade-up" class="client-clean-071")
          | Khám Phá Theo Loại Hình Phòng Trọ
        
        .categories-grid(class="client-clean-072" data-aos="fade-up" data-aos-delay="100")
          each cat in categories
            a(href=`/rooms?category=${cat.slug}` class="client-clean-073")
              div(class="client-clean-074")
                i(class=cat.icon || "fa-solid fa-house-chimney")
              h3(class="client-clean-075")= cat.title
              p(class="client-clean-076")= cat.description || 'Xem danh sách phòng'

    // Featured Rooms Section
    if featuredRooms && featuredRooms.length > 0
      section(class="client-clean-077")
        .container
          div(class="client-clean-078")
            div
              span.badge.badge-gold(class="client-clean-079") Nổi bật nhất
              h2(class="client-clean-080") Phòng Trọ Đáng Thuê Nhất
            a(href="/rooms" class="client-clean-081")
              | Xem tất cả (#{featuredRooms.length}+)
              i.fa-solid.fa-arrow-right
          
          .rooms-grid(class="client-clean-082")
            each room in featuredRooms
              +roomItem(room, favoriteRoomIds)

    // Latest Rooms Section
    section(class="client-clean-083")
      .container
        div(class="client-clean-078")
          div
            span.badge.badge-green(class="client-clean-079") Mới đăng & Đã duyệt
            h2(class="client-clean-080") Phòng Trọ Mới Phê Duyệt
          a(href="/rooms" class="client-clean-081")
            | Xem thêm phòng khác
            i.fa-solid.fa-arrow-right
        
        if latestRooms && latestRooms.length > 0
          .rooms-grid(class="client-clean-082")
            each room in latestRooms
              +roomItem(room, favoriteRoomIds)
        else
          p(class="client-clean-084") Hiện chưa có bài đăng nào được phê duyệt.

    // Trust & Benefits Section
    section(class="client-clean-085")
      .container
        h2(class="client-clean-086")
          | Vì Sao Nên Tìm Phòng & Đăng Tin Tại TroNest?
        .benefits-grid(class="client-clean-087")
          .benefit-box(class="client-clean-088")
            div(class="client-clean-089")
              i.fa-solid.fa-shield-halved
            h3(class="client-clean-090") 100% Đã Kiểm Duyệt
            p(class="client-clean-091") Mọi bài đăng và thông tin chủ trọ đều được Admin xác minh tính xác thực trước khi hiển thị.
          
          .benefit-box(class="client-clean-088")
            div(class="client-clean-092")
              i.fa-solid.fa-handshake
            h3(class="client-clean-090") Trực Tiếp Chính Chủ
            p(class="client-clean-091") Khách thuê liên hệ thẳng với Chủ trọ qua Số điện thoại, Email mà không qua trung gian môi giới.
          
          .benefit-box(class="client-clean-088")
            div(class="client-clean-093")
              i.fa-solid.fa-heart-circle-check
            h3(class="client-clean-090") Lưu Phòng Yêu Thích
            p(class="client-clean-091") Dễ dàng đánh dấu và so sánh các căn phòng ưng ý với tính năng danh sách yêu thích tiện lợi.
