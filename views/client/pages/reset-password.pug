doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Đặt lại mật khẩu - TroNest
    link(rel="icon" href="/favicon.png")
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css")
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css")
    link(rel="stylesheet" href="/client/assets/css/style.css")
  body(class="auth-inline-01")
    .page-account(class="auth-inline-02")
      .form-account(class="auth-inline-03")
        .inner-logo(class="auth-inline-04")
          a(href="/" class="auth-inline-05")
            i.fa-solid.fa-house-circle-check(class="auth-inline-06")
            span TroNest

        h2.inner-title(class="auth-inline-07") Đặt lại mật khẩu
        p.inner-desc(class="auth-inline-08") Thiết lập mật khẩu mới an toàn cho tài khoản của bạn

        if error
          div(style="background-color: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; padding: 16px; border-radius: 12px; margin-bottom: 20px; font-size: 14px; text-align: center;")
            i.fa-solid.fa-circle-exclamation(style="margin-right: 8px;")
            span= error
            div(style="margin-top: 12px;")
              a(href="/login" class="auth-inline-19") Quay lại Đăng nhập
        else
          form#reset-password-form
            input(type="hidden" name="_csrf" value=csrfToken)
            input(type="hidden" name="token" value=token)
            input(type="hidden" name="email" value=email)

            .inner-group(class="auth-inline-09")
              label(for="password" class="auth-inline-10") Mật khẩu mới
              input#password(
                type="password"
                name="password"
                placeholder="Tối thiểu 6 ký tự"
                minlength="6"
                required
                autocomplete="new-password"
                class="auth-inline-11"
              )

            .inner-group(class="auth-inline-12")
              label(for="confirmPassword" class="auth-inline-10") Xác nhận mật khẩu mới
              input#confirmPassword(
                type="password"
                name="confirmPassword"
                placeholder="Nhập lại mật khẩu mới"
                minlength="6"
                required
                autocomplete="new-password"
                class="auth-inline-11"
              )

            button#btn-submit-reset(type="submit" class="auth-inline-17")
              i.fa-solid.fa-key(style="margin-right: 8px;")
              span Đổi mật khẩu

          .inner-footer(class="auth-inline-18")
            | Nhớ mật khẩu? 
            a(href="/login" class="auth-inline-19") Quay lại Đăng nhập

    script(src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js")
    script(src="/shared/assets/js/notify.js")
    script(src="/shared/assets/js/http.js")
    script.
      document.addEventListener("DOMContentLoaded", function () {
        const notyf = new Notyf({
          duration: 3500,
          position: { x: "right", y: "top" }
        });

        const form = document.getElementById("reset-password-form");
        const btnSubmit = document.getElementById("btn-submit-reset");

        if (form) {
          form.addEventListener("submit", async function (e) {
            e.preventDefault();

            const token = form.querySelector('input[name="token"]').value;
            const email = form.querySelector('input[name="email"]').value;
            const _csrf = form.querySelector('input[name="_csrf"]')?.value;
            const password = document.getElementById("password").value;
            const confirmPassword = document.getElementById("confirmPassword").value;

            if (!password || !confirmPassword) {
              notyf.error("Vui lòng điền đầy đủ thông tin!");
              return;
            }

            if (password.length < 6) {
              notyf.error("Mật khẩu mới phải có ít nhất 6 ký tự!");
              return;
            }

            if (password !== confirmPassword) {
              notyf.error("Mật khẩu xác nhận không trùng khớp!");
              return;
            }

            btnSubmit.disabled = true;
            btnSubmit.innerHTML = '<i class="fa-solid fa-spinner fa-spin" style="margin-right: 8px;"></i><span>Đang xử lý...</span>';

            try {
              const res = await fetch("/reset-password", {
                method: "POST",
                headers: {
                  "Content-Type": "application/json",
                  "Accept": "application/json"
                },
                body: JSON.stringify({ token, email, password, confirmPassword, _csrf })
              });

              const data = await res.json();

              if (res.ok && data.code === 200) {
                notyf.success(data.message || "Đặt lại mật khẩu thành công!");
                setTimeout(() => {
                  window.location.href = data.redirectUrl || "/login";
                }, 1500);
              } else {
                notyf.error(data.message || "Đặt lại mật khẩu thất bại!");
                btnSubmit.disabled = false;
                btnSubmit.innerHTML = '<i class="fa-solid fa-key" style="margin-right: 8px;"></i><span>Đổi mật khẩu</span>';
              }
            } catch (err) {
              notyf.error("Có lỗi xảy ra khi kết nối máy chủ!");
              btnSubmit.disabled = false;
              btnSubmit.innerHTML = '<i class="fa-solid fa-key" style="margin-right: 8px;"></i><span>Đổi mật khẩu</span>';
            }
          });
        }
      });

