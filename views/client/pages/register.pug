doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Đăng ký tài khoản - TroNest
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css")
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css")
    link(rel="stylesheet" href="/client/assets/css/style.css")
  body(class="auth-inline-01")
    .page-account(class="auth-inline-02")
      .form-account(class="auth-inline-21")
        .inner-logo(class="auth-inline-22")
          a(href="/" class="auth-inline-05")
            i.fa-solid.fa-house-circle-check(class="auth-inline-06")
            span TroNest
        
        h2.inner-title(class="auth-inline-07") Đăng ký tài khoản mới
        p(class="auth-inline-23") Trở thành thành viên của cộng đồng TroNest

        form#register-form
          // Role selection tabs/radios
          .role-selector(class="auth-inline-24")
            label(class="auth-inline-25" id="label-role-customer")
              input(type="radio" name="role" value="CUSTOMER" checked class="auth-inline-15")
              span Khách thuê phòng
            label(class="auth-inline-25" id="label-role-landlord")
              input(type="radio" name="role" value="LANDLORD" class="auth-inline-26")
              span Chủ trọ cho thuê

          // Notice for landlord
          #landlord-notice(hidden class="auth-inline-27")
            i.fa-solid.fa-circle-info(class="auth-inline-28")
            | Lưu ý: Tài khoản Chủ trọ sau khi đăng ký sẽ ở trạng thái 
            b Chờ duyệt (PENDING)
            | . Admin sẽ kiểm tra và phê duyệt trước khi bạn có thể đăng bài.

          .inner-group(class="auth-inline-29")
            label(class="auth-inline-10") Họ và tên
            input#fullName(type="text" name="fullName" placeholder="Nguyễn Văn A" required class="auth-inline-30")

          .inner-group(class="auth-inline-29")
            label(class="auth-inline-10") Email
            input#email(type="email" name="email" placeholder="email@example.com" required class="auth-inline-30")

          .inner-group(class="auth-inline-29")
            label(class="auth-inline-10") Số điện thoại
            input#phone(type="tel" name="phone" placeholder="0987654321" required class="auth-inline-30")

          .inner-group(class="auth-inline-29")
            label(class="auth-inline-10") Mật khẩu
            input#password(type="password" name="password" placeholder="Tối thiểu 6 ký tự" required minlength="6" class="auth-inline-30")

          .inner-group(class="auth-inline-31")
            label(class="auth-inline-10") Địa chỉ
            input#address(type="text" name="address" placeholder="Quận Cầu Giấy, Hà Nội" class="auth-inline-30")

          button#btn-submit(type="submit" class="auth-inline-17")
            | Hoàn tất đăng ký

        .inner-footer(class="auth-inline-18")
          | Đã có tài khoản? 
          a(href="/login" class="auth-inline-19") Đăng nhập

    script(src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js")
    script(src="/shared/assets/js/notify.js")
    script(src="/shared/assets/js/http.js")
    script(src="/client/assets/js/auth.js")
