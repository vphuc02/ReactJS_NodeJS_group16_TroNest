extends ../layouts/default.pug

block title
  title Thông tin cá nhân - TroNest

block main
  -
    const formatFbUrl = (val) => {
      if (!val) return '';
      const s = String(val).trim();
      if (s.startsWith('http://') || s.startsWith('https://')) return s;
      if (s.startsWith('facebook.com') || s.startsWith('www.facebook.com') || s.startsWith('fb.com')) return 'https://' + s;
      return 'https://facebook.com/' + s;
    };

  main(class="client-clean-001 pt-24 pb-16 min-h-screen bg-[#FAF7F2]")
    .container(class="max-w-6xl mx-auto px-4 sm:px-6 space-y-6")
      
      //- Breadcrumb
      nav(class="flex items-center gap-2 text-xs sm:text-sm text-[#6E6A63] font-medium")
        a(href="/" class="hover:text-[#A67C52] transition-colors no-underline text-[#6E6A63] flex items-center gap-1.5")
          i.fa-solid.fa-house(class="text-xs text-[#A67C52]")
          span Trang chủ
        if user && user.role === 'LANDLORD'
          span(class="text-[#D4C2AA]") /
          a(href="/landlord/dashboard" class="hover:text-[#A67C52] transition-colors no-underline text-[#6E6A63] flex items-center gap-1.5")
            i.fa-solid.fa-house-chimney-user(class="text-xs text-[#A67C52]")
            span Kênh chủ trọ
        span(class="text-[#D4C2AA]") /
        span(class="text-[#1C1B19] font-semibold") Thông tin cá nhân

      //- Hero Profile Header Card
      .profile-hero(class="bg-white rounded-3xl p-6 sm:p-8 border border-[#E6DFD3] shadow-sm relative overflow-hidden")
        div(class="absolute top-0 right-0 -mr-20 -mt-20 w-80 h-80 bg-[#F5EFE6]/70 rounded-full blur-3xl pointer-events-none")
        div(class="absolute bottom-0 left-1/3 -mb-16 w-60 h-60 bg-[#FAF7F2] rounded-full blur-2xl pointer-events-none")

        div(class="relative z-10 flex flex-col sm:flex-row items-center sm:items-start gap-6 sm:gap-7")
          
          //- Avatar với nút đổi ảnh mượt mà từ máy tính
          .avatar-wrapper(class="relative group cursor-pointer shrink-0" id="avatar-click-zone" title="Nhấn vào ảnh để đổi avatar từ máy tính")
            img#profile-avatar-display(
              src=user.avatar || "/admin/assets/images/avatar.jpg" 
              alt=user.fullName 
              referrerpolicy="no-referrer"
              onerror="this.onerror=null;this.src='/admin/assets/images/avatar.jpg';"
              class="w-24 h-24 sm:w-28 sm:h-28 rounded-full object-cover border-4 border-white shadow-md ring-2 ring-[#A67C52]/50 bg-[#F5EFE6] transition-all duration-200 group-hover:brightness-90"
            )
            //- Overlay đổi ảnh hiện lên khi hover
            div(class="absolute inset-0 bg-black/45 rounded-full flex flex-col items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-200 text-white")
              i.fa-solid.fa-camera(class="text-base sm:text-lg mb-0.5")
              span(class="text-[10px] font-semibold tracking-wide") Đổi ảnh
            //- Huy hiệu máy ảnh bo tròn góc dưới bên phải avatar
            span(class="absolute bottom-0 right-0 w-8 h-8 bg-[#A67C52] text-white border-2 border-white rounded-full flex items-center justify-center text-xs shadow-md group-hover:scale-105 transition-transform" title="Nhấn để tải ảnh lên")
              i.fa-solid.fa-camera
            //- Input file ẩn
            input#avatar-file-input(type="file" name="avatar" accept="image/jpeg,image/png,image/webp,image/gif" class="hidden")

          //- Thông tin tóm tắt & Badges
          div(class="flex-1 text-center sm:text-left min-w-0")
            div(class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-3 justify-center sm:justify-start mb-2")
              h1#profile-name-display(class="font-serif text-3xl sm:text-4xl font-semibold text-[#1C1B19] tracking-tight m-0")= user.fullName
              div(class="flex items-center gap-2 flex-wrap justify-center sm:justify-start")
                span(class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-[#F5EFE6] text-[#8C6239] border border-[#E6DFD3]")
                  if user.role === 'LANDLORD'
                    i.fa-solid.fa-house-user(class="text-[11px] text-[#A67C52]")
                    | Chủ trọ cho thuê
                  else if user.role === 'ADMIN'
                    i.fa-solid.fa-shield-halved(class="text-[11px] text-[#8C6239]")
                    | Quản trị viên
                  else
                    i.fa-solid.fa-user-check(class="text-[11px] text-[#A67C52]")
                    | Khách thuê TroNest
                span(class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-[#FAF7F2] text-[#6E4B26] border border-[#E6DFD3]")
                  span(class="w-1.5 h-1.5 rounded-full bg-[#A67C52] animate-pulse")
                  | Đang hoạt động

            div(class="flex flex-wrap items-center gap-x-5 gap-y-2 text-xs sm:text-sm text-[#6E6A63] justify-center sm:justify-start mt-2.5")
              span(class="flex items-center gap-1.5")
                i.fa-regular.fa-envelope(class="text-[#A67C52]")
                span= user.email
              span(class="flex items-center gap-1.5")
                i.fa-regular.fa-calendar-check(class="text-[#A67C52]")
                | Tham gia: #{new Date(user.createdAt).toLocaleDateString('vi-VN')}
              if user.phone
                span(class="flex items-center gap-1.5")
                  i.fa-solid.fa-phone(class="text-[#A67C52]")
                  span= user.phone
              - const heroFbUrl = formatFbUrl(user.facebook)
              a#hero-facebook-link(
                href=heroFbUrl || '#' 
                target="_blank" 
                rel="noopener noreferrer" 
                class="flex items-center gap-1.5 text-[#8C6239] hover:text-[#A67C52] hover:underline no-underline font-medium " + (user.facebook ? '' : 'hidden')
                title="Bấm để chuyển hướng sang Facebook cá nhân"
              )
                i.fa-brands.fa-facebook(class="text-sm text-[#A67C52]")
                span#hero-facebook-text Facebook
                i.fa-solid.fa-arrow-up-right-from-square(class="text-[10px] opacity-75")

          //- Hành động nhanh (Nút yêu thích / Cập nhật hồ sơ)
          div(class="flex flex-row sm:flex-col gap-2.5 sm:self-center w-full sm:w-auto shrink-0")
            if user.role === 'LANDLORD'
              a(href="/landlord/dashboard" class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-full bg-[#F5EFE6] hover:bg-[#E6DFD3] text-[#8C6239] text-xs sm:text-sm font-bold transition-all border border-[#E6DFD3] no-underline shadow-xs")
                i.fa-solid.fa-house-chimney-user(class="text-xs text-[#A67C52]")
                span Kênh chủ trọ
                span(class="bg-[#A67C52] text-white text-[11px] font-bold px-2 py-0.5 rounded-full")= roomCount || 0
            else
              a(href="/favorites" class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-full bg-[#F5EFE6] hover:bg-[#E6DFD3] text-[#8C6239] text-xs sm:text-sm font-bold transition-all border border-[#E6DFD3] no-underline shadow-xs")
                i.fa-solid.fa-heart(class="text-xs text-[#A67C52]")
                span Phòng yêu thích
                span(class="bg-[#A67C52] text-white text-[11px] font-bold px-2 py-0.5 rounded-full")= favoriteCount || 0
            
            button#btn-trigger-edit(type="button" class="btn-hotelier btn-hotelier-bronze text-xs sm:text-sm justify-between cursor-pointer")
              span Cập nhật hồ sơ
              span.btn-hotelier-icon
                i.fa-solid.fa-user-pen(class="text-[10px]")

      //- Main Content Grid: Sidebar + Tabs
      div(class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start")
        
        //- Cột trái: Menu điều hướng & Thống kê cá nhân
        div(class="lg:col-span-4 space-y-6")
          
          //- Menu Tab Selector
          div(class="bg-white rounded-3xl p-3 border border-[#E6DFD3] shadow-sm")
            ul(class="space-y-1.5 list-none p-0 m-0")
              li
                button.profile-tab-btn(
                  type="button" 
                  data-target="#tab-overview" 
                  class="active w-full flex items-center justify-between px-4 py-3 rounded-2xl text-left font-bold text-sm transition-all border-none cursor-pointer bg-[#F5EFE6] text-[#8C6239]"
                )
                  span(class="flex items-center gap-3")
                    i.fa-solid.fa-id-card(class="text-base w-5 text-center")
                    span Thông tin chi tiết
                  i.fa-solid.fa-chevron-right(class="text-xs opacity-60")
              li
                button.profile-tab-btn(
                  type="button" 
                  data-target="#tab-edit" 
                  class="w-full flex items-center justify-between px-4 py-3 rounded-2xl text-left font-semibold text-sm transition-all border-none cursor-pointer bg-transparent text-[#6E6A63] hover:bg-[#FAF7F2] hover:text-[#1C1B19]"
                )
                  span(class="flex items-center gap-3")
                    i.fa-solid.fa-user-gear(class="text-base w-5 text-center")
                    span Chỉnh sửa thông tin
                  i.fa-solid.fa-chevron-right(class="text-xs opacity-60")
              li
                button.profile-tab-btn(
                  type="button" 
                  data-target="#tab-password" 
                  class="w-full flex items-center justify-between px-4 py-3 rounded-2xl text-left font-semibold text-sm transition-all border-none cursor-pointer bg-transparent text-[#6E6A63] hover:bg-[#FAF7F2] hover:text-[#1C1B19]"
                )
                  span(class="flex items-center gap-3")
                    i.fa-solid.fa-shield-halved(class="text-base w-5 text-center")
                    span Đổi mật khẩu
                  i.fa-solid.fa-chevron-right(class="text-xs opacity-60")

          //- Thẻ Tóm Tắt Hoạt Động & Tiện Ích
          div(class="bg-white rounded-3xl p-6 border border-[#E6DFD3] shadow-sm space-y-4")
            h3(class="text-xs font-bold text-[#6E6A63] uppercase tracking-wider mb-2 flex items-center gap-2")
              i.fa-solid.fa-chart-pie(class="text-[#A67C52]")
              = user.role === 'LANDLORD' ? 'Quản lý phòng trọ' : 'Hoạt động & Tiện ích'
            
            if user.role === 'LANDLORD'
              div(class="p-4 rounded-2xl bg-[#F5EFE6]/70 border border-[#E6DFD3] flex items-center justify-between")
                div(class="flex items-center gap-3")
                  div(class="w-9 h-9 rounded-xl bg-white flex items-center justify-center text-[#A67C52] shadow-xs")
                    i.fa-solid.fa-house-user(class="text-xs")
                  div
                    div(class="text-xs text-[#6E6A63]") Phòng trọ đang quản lý
                    div(class="text-base font-bold text-[#1C1B19]")
                      span= roomCount || 0
                      span(class="text-xs font-normal text-[#6E6A63] ml-1") phòng
                a(href="/landlord/rooms" class="text-xs font-bold text-[#A67C52] hover:underline no-underline") Quản lý &rarr;

              div(class="p-4 rounded-2xl bg-[#FAF7F2] border border-[#E6DFD3] flex items-center justify-between")
                div(class="flex items-center gap-3")
                  div(class="w-9 h-9 rounded-xl bg-white flex items-center justify-center text-[#A67C52] shadow-xs")
                    i.fa-solid.fa-circle-plus(class="text-xs")
                  div
                    div(class="text-xs text-[#6E6A63]") Đăng phòng trọ mới
                    div(class="text-sm font-bold text-[#1C1B19]") Tiếp cận người thuê
                a(href="/landlord/rooms/create" class="text-xs font-bold text-[#A67C52] hover:underline no-underline") Đăng tin &rarr;
            else
              div(class="p-4 rounded-2xl bg-[#F5EFE6]/70 border border-[#E6DFD3] flex items-center justify-between")
                div(class="flex items-center gap-3")
                  div(class="w-9 h-9 rounded-xl bg-white flex items-center justify-center text-[#A67C52] shadow-xs")
                    i.fa-solid.fa-heart(class="text-xs")
                  div
                    div(class="text-xs text-[#6E6A63]") Phòng đã lưu yêu thích
                    div(class="text-base font-bold text-[#1C1B19]")
                      span= favoriteCount || 0
                      span(class="text-xs font-normal text-[#6E6A63] ml-1") phòng
                a(href="/favorites" class="text-xs font-bold text-[#A67C52] hover:underline no-underline") Xem tất cả &rarr;

              div(class="p-4 rounded-2xl bg-[#FAF7F2] border border-[#E6DFD3] flex items-center justify-between")
                div(class="flex items-center gap-3")
                  div(class="w-9 h-9 rounded-xl bg-white flex items-center justify-center text-[#A67C52] shadow-xs")
                    i.fa-solid.fa-magnifying-glass-location(class="text-xs")
                  div
                    div(class="text-xs text-[#6E6A63]") Khám phá phòng trọ
                    div(class="text-sm font-bold text-[#1C1B19]") Hàng ngàn phòng mới
                a(href="/rooms" class="text-xs font-bold text-[#A67C52] hover:underline no-underline") Tìm phòng &rarr;

            div(class="pt-3 border-t border-[#F3EFE6]")
              a(href="/logout" data-logout-url="/logout" class="w-full flex items-center justify-center gap-2 py-2.5 px-4 rounded-2xl border border-red-200 text-red-600 hover:bg-red-50 text-xs font-bold transition-colors no-underline cursor-pointer")
                i.fa-solid.fa-arrow-right-from-bracket
                | Đăng xuất khỏi tài khoản

        //- Cột phải: Chi tiết các Tab
        div(class="lg:col-span-8")
          
          //- Tab 1: Chi tiết thông tin cá nhân
          #tab-overview.profile-tab-content(class="bg-white rounded-3xl p-6 sm:p-8 border border-[#E6DFD3] shadow-sm space-y-6")
            div(class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-[#F3EFE6]")
              div
                h2(class="font-serif text-2xl sm:text-3xl font-semibold text-[#1C1B19] m-0 flex items-center gap-2")
                  i.fa-solid.fa-address-card(class="text-[#A67C52] text-lg")
                  = user.role === 'LANDLORD' ? 'Hồ sơ chủ trọ' : (user.role === 'ADMIN' ? 'Hồ sơ quản trị viên' : 'Hồ sơ khách thuê')
                p(class="text-[#6E6A63] text-xs sm:text-sm mt-1 m-0")= user.role === 'LANDLORD' ? 'Thông tin cá nhân & liên hệ của chủ trọ được hiển thị an toàn trên hệ thống.' : 'Thông tin chi tiết được bảo mật và lưu trữ an toàn trong tài khoản của bạn.'
              button(type="button" onclick="document.querySelector('[data-target=\"#tab-edit\"]').click()" class="btn-hotelier btn-hotelier-outline text-xs cursor-pointer")
                span Chỉnh sửa
                span.btn-hotelier-icon
                  i.fa-solid.fa-pen-to-square(class="text-[10px]")

            //- Grid thông tin hiển thị rõ ràng, chuyên nghiệp
            div(class="grid grid-cols-1 sm:grid-cols-2 gap-4")
              
              //- Họ và tên
              .info-card(class="p-4 rounded-2xl bg-[#FAF7F2] border border-[#E6DFD3] transition-colors")
                span(class="text-xs font-semibold text-[#6E6A63] block mb-1.5 flex items-center gap-1.5")
                  i.fa-solid.fa-user(class="text-[#A67C52] text-[11px]")
                  | Họ và tên đầy đủ
                p#profile-fullname-text(class="text-sm sm:text-base font-bold text-[#1C1B19] m-0")= user.fullName

              //- Email
              .info-card(class="p-4 rounded-2xl bg-[#FAF7F2] border border-[#E6DFD3] transition-colors")
                span(class="text-xs font-semibold text-[#6E6A63] block mb-1.5 flex items-center gap-1.5")
                  i.fa-solid.fa-envelope(class="text-[#A67C52] text-[11px]")
                  | Địa chỉ Email
                div(class="flex items-center gap-2")
                  p(class="text-sm sm:text-base font-bold text-[#1C1B19] m-0 truncate" title=user.email)= user.email
                  span(class="px-2 py-0.5 rounded-full bg-[#F5EFE6] text-[#8C6239] text-[10px] font-bold border border-[#E6DFD3] shrink-0") Đã xác thực

              //- Số điện thoại
              .info-card(class="p-4 rounded-2xl bg-[#FAF7F2] border border-[#E6DFD3] transition-colors")
                span(class="text-xs font-semibold text-[#6E6A63] block mb-1.5 flex items-center gap-1.5")
                  i.fa-solid.fa-phone(class="text-[#A67C52] text-[11px]")
                  | Số điện thoại liên hệ
                if user.phone
                  p#profile-phone-text(class="text-sm sm:text-base font-bold text-[#1C1B19] m-0")= user.phone
                else
                  p#profile-phone-text(class="text-sm text-[#9A9389] italic m-0") Chưa cập nhật

              //- Địa chỉ liên hệ
              .info-card(class="p-4 rounded-2xl bg-[#FAF7F2] border border-[#E6DFD3] transition-colors")
                span(class="text-xs font-semibold text-[#6E6A63] block mb-1.5 flex items-center gap-1.5")
                  i.fa-solid.fa-location-dot(class="text-[#A67C52] text-[11px]")
                  | Địa chỉ / Khu vực quan tâm
                if user.address
                  p#profile-address-text(class="text-sm sm:text-base font-bold text-[#1C1B19] m-0")= user.address
                else
                  p#profile-address-text(class="text-sm text-[#9A9389] italic m-0") Chưa cập nhật

              //- Facebook cá nhân
              .info-card(class="p-4 rounded-2xl bg-[#FAF7F2] border border-[#E6DFD3] transition-colors")
                span(class="text-xs font-semibold text-[#6E6A63] block mb-1.5 flex items-center gap-1.5")
                  i.fa-brands.fa-facebook(class="text-[#A67C52] text-xs")
                  | Liên kết Facebook
                - const tabFbUrl = formatFbUrl(user.facebook)
                a#profile-facebook-link(
                  href=tabFbUrl || '#' 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="text-sm sm:text-base font-bold text-[#8C6239] hover:text-[#A67C52] hover:underline m-0 flex items-center gap-1.5 truncate no-underline transition-colors " + (user.facebook ? '' : 'hidden')
                  title="Nhấn để chuyển hướng sang Facebook cá nhân"
                )
                  span#profile-facebook-text= user.facebook || ''
                  i.fa-solid.fa-arrow-up-right-from-square(class="text-[11px] opacity-75 shrink-0")
                p#profile-facebook-empty(class="text-sm text-[#9A9389] italic m-0 " + (user.facebook ? 'hidden' : '')) Chưa cập nhật

              //- Vai trò tài khoản
              .info-card(class="p-4 rounded-2xl bg-[#FAF7F2] border border-[#E6DFD3] transition-colors")
                span(class="text-xs font-semibold text-[#6E6A63] block mb-1.5 flex items-center gap-1.5")
                  i.fa-solid.fa-shield-halved(class="text-[#A67C52] text-[11px]")
                  | Vai trò tài khoản
                p(class="text-sm sm:text-base font-bold text-[#8C6239] m-0 flex items-center gap-1.5")
                  i.fa-solid.fa-circle-check(class="text-[#A67C52] text-xs")
                  if user.role === 'LANDLORD'
                    | Chủ trọ (Landlord)
                  else if user.role === 'ADMIN'
                    | Quản trị viên (Admin)
                  else
                    | Khách thuê (Customer)

              //- Trạng thái tài khoản
              .info-card(class="p-4 rounded-2xl bg-[#FAF7F2] border border-[#E6DFD3] transition-colors")
                span(class="text-xs font-semibold text-[#6E6A63] block mb-1.5 flex items-center gap-1.5")
                  i.fa-solid.fa-signal(class="text-[#A67C52] text-[11px]")
                  | Trạng thái hoạt động
                p(class="text-sm sm:text-base font-bold text-[#6E4B26] m-0 flex items-center gap-1.5")
                  span(class="w-2 h-2 rounded-full bg-[#A67C52]")
                  | Hoạt động bình thường

              //- Ngày đăng ký
              .info-card(class="p-4 rounded-2xl bg-[#FAF7F2] border border-[#E6DFD3] transition-colors")
                span(class="text-xs font-semibold text-[#6E6A63] block mb-1.5 flex items-center gap-1.5")
                  i.fa-solid.fa-calendar-plus(class="text-[#A67C52] text-[11px]")
                  | Ngày khởi tạo tài khoản
                p(class="text-sm sm:text-base font-medium text-[#1C1B19] m-0")
                  | #{new Date(user.createdAt).toLocaleDateString('vi-VN')} #{new Date(user.createdAt).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' })}

              //- Cập nhật lần cuối
              .info-card(class="p-4 rounded-2xl bg-[#FAF7F2] border border-[#E6DFD3] transition-colors")
                span(class="text-xs font-semibold text-[#6E6A63] block mb-1.5 flex items-center gap-1.5")
                  i.fa-solid.fa-clock-rotate-left(class="text-[#A67C52] text-[11px]")
                  | Lần cập nhật gần nhất
                p#profile-updated-at(class="text-sm sm:text-base font-medium text-[#1C1B19] m-0")
                  | #{new Date(user.updatedAt || user.createdAt).toLocaleDateString('vi-VN')} #{new Date(user.updatedAt || user.createdAt).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' })}

            //- Banner gợi ý bảo mật
            div(class="rounded-2xl bg-[#F5EFE6] border border-[#E6DFD3] p-4 flex items-start gap-3 text-xs sm:text-sm text-[#1C1B19] shadow-2xs")
              i.fa-solid.fa-lightbulb(class="text-[#A67C52] mt-0.5 text-base shrink-0")
              div
                if user.role === 'LANDLORD'
                  strong(class="font-bold block mb-0.5") Mẹo dành cho Chủ trọ:
                  | Cập nhật đầy đủ số điện thoại, địa chỉ và liên kết Facebook sẽ giúp khách tìm thuê phòng dễ dàng liên hệ trao đổi và nâng cao độ tin cậy của tin đăng!
                else
                  strong(class="font-bold block mb-0.5") Mẹo dành cho Khách thuê:
                  | Cập nhật đầy đủ số điện thoại, địa chỉ và Facebook cá nhân sẽ giúp chủ trọ dễ dàng xác minh và liên hệ hẹn xem phòng trọ nhanh nhất!

