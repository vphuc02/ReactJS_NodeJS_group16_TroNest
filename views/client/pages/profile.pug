                input#edit-address(
                  type="text" 
                  name="address" 
                  value=user.address || '' 
                  placeholder="VD: Cầu Giấy, Hà Nội"
                  class="w-full px-4 py-2.5 sm:py-3 rounded-2xl border border-[#E6DFD3] hover:border-[#A67C52] focus:outline-none focus:border-[#A67C52] focus:ring-2 focus:ring-[#F5EFE6] transition-all text-sm text-[#1C1B19]"
