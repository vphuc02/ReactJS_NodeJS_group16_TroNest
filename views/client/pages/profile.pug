  //- Script điều khiển Tabs và Xử lý Ajax cập nhật hồ sơ & đổi mật khẩu & đổi avatar từ máy tính
  script.
    document.addEventListener("DOMContentLoaded", function () {
      // 1. Chuyển đổi Tabs
      const tabButtons = document.querySelectorAll(".profile-tab-btn");
      const tabContents = document.querySelectorAll(".profile-tab-content");
      const btnTriggerEdit = document.getElementById("btn-trigger-edit");

      function switchTab(targetSelector) {
        tabButtons.forEach(function (btn) {
          if (btn.getAttribute("data-target") === targetSelector) {
            btn.classList.add("active", "bg-[#F5EFE6]", "text-[#8C6239]");
            btn.classList.remove("bg-transparent", "text-[#6E6A63]");
          } else {
            btn.classList.remove("active", "bg-[#F5EFE6]", "text-[#8C6239]");
            btn.classList.add("bg-transparent", "text-[#6E6A63]");
          }
        });

        tabContents.forEach(function (content) {
          if ("#" + content.id === targetSelector) {
            content.classList.remove("hidden");
          } else {
            content.classList.add("hidden");
          }
        });
      }

      tabButtons.forEach(function (btn) {
        btn.addEventListener("click", function () {
          const target = this.getAttribute("data-target");
          switchTab(target);
        });
      });

      if (btnTriggerEdit) {
        btnTriggerEdit.addEventListener("click", function () {
          switchTab("#tab-edit");
        });
      }

      // 2. Xử lý đổi ảnh đại diện bằng cách click vào avatar chọn ảnh trong máy
      const avatarClickZone = document.getElementById("avatar-click-zone");
      const avatarFileInput = document.getElementById("avatar-file-input");
      const profileAvatarDisplay = document.getElementById("profile-avatar-display");
      const editAvatarPreview = document.getElementById("edit-avatar-preview");

      if (avatarClickZone && avatarFileInput) {
        avatarClickZone.addEventListener("click", function () {
          avatarFileInput.click();
        });
      }

      if (avatarFileInput) {
        avatarFileInput.addEventListener("change", async function (e) {
          const file = e.target.files && e.target.files[0];
          if (!file) return;

          // Kiểm tra dung lượng tối đa 5 MB
          if (file.size > 5 * 1024 * 1024) {
            window.notyf?.error("Ảnh đại diện không được vượt quá 5 MB!");
            avatarFileInput.value = "";
            return;
          }

          // Kiểm tra định dạng ảnh
          if (!file.type.match(/^image\/(jpeg|png|webp|gif)$/i)) {
            window.notyf?.error("Chỉ chấp nhận ảnh định dạng JPG, PNG, WebP hoặc GIF!");
            avatarFileInput.value = "";
            return;
          }

          // Hiển thị preview ngay lập tức
          const previewUrl = URL.createObjectURL(file);
          if (profileAvatarDisplay) profileAvatarDisplay.src = previewUrl;
          if (editAvatarPreview) editAvatarPreview.src = previewUrl;

          // Gửi FormData lên server qua endpoint /profile/avatar
          const formData = new FormData();
          formData.append("avatar", file);

          if (profileAvatarDisplay) profileAvatarDisplay.style.opacity = "0.6";

          try {
            const response = await fetch("/profile/avatar", {
              method: "POST",
              headers: {
                "Accept": "application/json"
              },
              body: formData
            });

            const data = await response.json();

            if (response.ok && data.code === 200) {
              window.notyf?.success(data.message || "Cập nhật ảnh đại diện thành công!");
              const newAvatarUrl = data.avatar;
              if (profileAvatarDisplay) profileAvatarDisplay.src = newAvatarUrl;
              if (editAvatarPreview) editAvatarPreview.src = newAvatarUrl;

              // Đồng bộ luôn ảnh avatar trên thanh Navbar góc trên bên phải
              document.querySelectorAll(".navbar-pill img, .inner-menu img").forEach(function (img) {
                img.src = newAvatarUrl;
              });
            } else {
              window.notyf?.error(data.message || "Tải ảnh lên thất bại, vui lòng thử lại!");
            }
          } catch (err) {
            window.notyf?.error("Đã xảy ra lỗi kết nối khi tải ảnh đại diện!");
          } finally {
            if (profileAvatarDisplay) profileAvatarDisplay.style.opacity = "1";
            avatarFileInput.value = "";
          }
        });
      }

      // 3. Xử lý Form Cập nhật thông tin cá nhân (Họ tên, SĐT, Địa chỉ, Facebook)
      const formUpdateProfile = document.getElementById("form-update-profile");
      const btnSaveProfile = document.getElementById("btn-save-profile");

      if (formUpdateProfile) {
        formUpdateProfile.addEventListener("submit", async function (e) {
          e.preventDefault();
          if (btnSaveProfile) btnSaveProfile.disabled = true;

          const fullName = document.getElementById("edit-fullName")?.value?.trim() || "";
          const phone = document.getElementById("edit-phone")?.value?.trim() || "";
          const address = document.getElementById("edit-address")?.value?.trim() || "";
          const facebook = document.getElementById("edit-facebook")?.value?.trim() || "";

          try {
            const response = await fetch("/profile/edit", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                "Accept": "application/json"
              },
              body: JSON.stringify({ fullName, phone, address, facebook })
            });

            const data = await response.json();

            if (response.ok && data.code === 200) {
              window.notyf?.success(data.message || "Cập nhật thông tin thành công!");

              // Cập nhật DOM trực tiếp
              const nameDisplay = document.getElementById("profile-name-display");
              const fullnameText = document.getElementById("profile-fullname-text");
              const phoneText = document.getElementById("profile-phone-text");
              const addressText = document.getElementById("profile-address-text");
              const facebookText = document.getElementById("profile-facebook-text");
              const facebookLink = document.getElementById("profile-facebook-link");
              const facebookEmpty = document.getElementById("profile-facebook-empty");
              const heroFacebookLink = document.getElementById("hero-facebook-link");

              if (nameDisplay) nameDisplay.textContent = data.user.fullName;
              if (fullnameText) fullnameText.textContent = data.user.fullName;

              if (phoneText) {
                phoneText.textContent = data.user.phone || "Chưa cập nhật";
                phoneText.classList.toggle("italic", !data.user.phone);
                phoneText.classList.toggle("text-slate-400", !data.user.phone);
              }

              if (addressText) {
                addressText.textContent = data.user.address || "Chưa cập nhật";
                addressText.classList.toggle("italic", !data.user.address);
                addressText.classList.toggle("text-slate-400", !data.user.address);
              }

              function formatFacebookUrl(val) {
                if (!val) return "";
                const s = String(val).trim();
                if (!s) return "";
                if (s.startsWith("http://") || s.startsWith("https://")) return s;
                if (s.startsWith("facebook.com") || s.startsWith("www.facebook.com") || s.startsWith("fb.com")) {
                  return "https://" + s;
                }
                return "https://facebook.com/" + s;
              }

              const fbRaw = data.user.facebook ? String(data.user.facebook).trim() : "";
              const fbUrl = formatFacebookUrl(fbRaw);

              if (fbRaw) {
                if (facebookText) facebookText.textContent = fbRaw;
                if (facebookLink) {
                  facebookLink.href = fbUrl;
                  facebookLink.classList.remove("hidden");
                }
                if (facebookEmpty) facebookEmpty.classList.add("hidden");

                if (heroFacebookLink) {
                  heroFacebookLink.href = fbUrl;
                  heroFacebookLink.classList.remove("hidden");
                }
              } else {
                if (facebookLink) facebookLink.classList.add("hidden");
                if (facebookEmpty) facebookEmpty.classList.remove("hidden");
                if (heroFacebookLink) heroFacebookLink.classList.add("hidden");
              }

              // Chuyển lại tab tổng quan sau 600ms
              setTimeout(function () {
                switchTab("#tab-overview");
              }, 600);
            } else {
              window.notyf?.error(data.message || "Cập nhật thất bại, vui lòng kiểm tra lại!");
            }
          } catch (err) {
            window.notyf?.error("Đã xảy ra lỗi kết nối, vui lòng thử lại!");
          } finally {
            if (btnSaveProfile) btnSaveProfile.disabled = false;
          }
        });
      }

      // 4. Xử lý Gửi liên kết đổi mật khẩu qua Email
      const btnSendResetMail = document.getElementById("btn-send-reset-mail");

      if (btnSendResetMail) {
        btnSendResetMail.addEventListener("click", async function () {
          btnSendResetMail.disabled = true;
          btnSendResetMail.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> <span>Đang gửi email...</span>';

          try {
            const response = await fetch("/profile/send-reset-password-email", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                "Accept": "application/json"
              }
            });

            const data = await response.json();

            if (response.ok && data.code === 200) {
              window.notyf?.success(data.message || "Đã gửi liên kết đổi mật khẩu qua email!");
            } else {
              window.notyf?.error(data.message || "Không thể gửi email, vui lòng thử lại sau!");
            }
          } catch (err) {
            window.notyf?.error("Đã xảy ra lỗi khi kết nối máy chủ!");
          } finally {
            btnSendResetMail.disabled = false;
            btnSendResetMail.innerHTML = '<i class="fa-solid fa-paper-plane"></i> <span>Gửi liên kết đổi mật khẩu qua Email</span>';
          }
        });
      }
    });
