doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Quên mật khẩu - TroNest
    link(rel="icon" href="/favicon.png")
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css")
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css")
    link(rel="stylesheet" href="/client/assets/css/style.css")
  body(class="auth-inline-01")
    .page-account(class="auth-inline-02")
      .form-account(class="auth-inline-03")
        .inner-logo(class="auth-inline-04")
          a(href="/" class="auth-inline-05")
            i.fa-solid.fa-house-circle-check(class="auth-inline-06")
            span TroNest

        h2.inner-title(class="auth-inline-07") Khôi phục mật khẩu
        p#forgot-subtitle(class="auth-inline-08") Nhập email đã đăng ký để nhận mã xác thực OTP 6 chữ số

        //- Thanh tiến trình 3 bước (Clean & Content-First)
        .forgot-stepper#forgot-stepper
          .forgot-step.is-active(data-step="1")
            span.step-num 1
            span.step-label Email
          .forgot-step-line
          .forgot-step(data-step="2")
            span.step-num 2
            span.step-label Mã OTP
          .forgot-step-line
          .forgot-step(data-step="3")
            span.step-num 3
            span.step-label Mật khẩu mới

        //- BƯỚC 1: Nhập Email nhận mã OTP
        form#forgot-email-form
          .inner-group(class="auth-inline-09")
            label(for="forgot-email" class="auth-inline-10") Địa chỉ Email tài khoản
            input#forgot-email(
              type="email"
              name="email"
              placeholder="example@tronest.com"
              required
              autocomplete="email"
              class="auth-inline-11"
            )

          button#btn-send-otp(type="submit" class="auth-inline-17")
            | Gửi mã xác thực OTP

        //- BƯỚC 2: Nhập mã OTP 6 chữ số
        form#forgot-otp-form(hidden)
          .forgot-info-box
            div.forgot-info-text
              | Mã OTP đã được gửi tới email 
              strong#otp-target-email —
            div.forgot-timer-badge
              i.fa-regular.fa-clock
              span#otp-countdown 05:00

          .inner-group(class="auth-inline-09")
            label(for="forgot-otp" class="auth-inline-10") Nhập mã OTP (6 chữ số)
            input#forgot-otp(
              type="text"
              name="otp"
              inputmode="numeric"
              pattern="[0-9]{6}"
              maxlength="6"
              placeholder="000000"
              required
              autocomplete="one-time-code"
              class="auth-inline-11 forgot-otp-input"
            )

          button#btn-verify-otp(type="submit" class="auth-inline-17")
            | Xác thực mã OTP

          .forgot-secondary-actions
            button#btn-change-email(type="button" class="btn-link-muted")
              i.fa-solid.fa-arrow-left
              span Đổi địa chỉ Email
            button#btn-resend-otp(type="button" class="btn-link-accent")
              i.fa-solid.fa-rotate-right
              span Gửi lại mã OTP

        //- BƯỚC 3: Đặt lại mật khẩu mới
        form#forgot-reset-form(hidden)
          .inner-group(class="auth-inline-09")
            label(for="new-password" class="auth-inline-10") Mật khẩu mới
            input#new-password(
              type="password"
              name="password"
              placeholder="Tối thiểu 6 ký tự"
              minlength="6"
              required
              autocomplete="new-password"
              class="auth-inline-11"
            )

          .inner-group(class="auth-inline-12")
            label(for="confirm-password" class="auth-inline-10") Xác nhận mật khẩu mới
            input#confirm-password(
              type="password"
              name="confirmPassword"
              placeholder="Nhập lại mật khẩu mới"
              minlength="6"
              required
              autocomplete="new-password"
              class="auth-inline-11"
            )

          button#btn-reset-password(type="submit" class="auth-inline-17")
            | Cập nhật mật khẩu mới

        .inner-footer(class="auth-inline-18")
          | Nhớ mật khẩu? 
          a(href="/login" class="auth-inline-19") Quay lại Đăng nhập

    script(src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js")
    script(src="/shared/assets/js/notify.js")
    script(src="/shared/assets/js/http.js")
    script(src="/client/assets/js/auth.js")

