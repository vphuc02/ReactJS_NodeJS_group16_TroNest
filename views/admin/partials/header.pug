header.header(style="background: #fff; border-bottom: 1px solid #e2e8f0; padding: 12px 24px; display: flex; justify-content: space-between; align-items: center;")
  div(style="display: flex; align-items: center; gap: 16px;")
    a(href="/admin/dashboard" style="display: flex; align-items: center; gap: 8px; font-size: 20px; font-weight: 800; color: #2563eb; text-decoration: none;")
      i.fa-solid.fa-shield-halved
      span TroNest Admin Panel

  div(style="display: flex; align-items: center; gap: 20px;")
    a(href="/" target="_blank" style="font-size: 14px; font-weight: 600; color: #4502C7; display: flex; align-items: center; gap: 6px; text-decoration: none;")
      i.fa-solid.fa-globe
      | Xem website chính

    if user
      .user-info(style="display: flex; align-items: center; gap: 10px;")
        img(src=user.avatar || "/admin/assets/images/avatar.jpg" alt=user.fullName style="width: 36px; height: 36px; border-radius: 50%; object-fit: cover; border: 2px solid #bfdbfe;")
        div
          span(style="display: block; font-size: 14px; font-weight: 700; color: #1e293b;")= user.fullName
          span.badge.badge-blue(style="font-size: 11px; padding: 2px 6px;") Quản trị viên

      a(href="/admin/logout" title="Đăng xuất" style="color: #ef4444; font-size: 16px; margin-left: 10px; text-decoration: none;")
        i.fa-solid.fa-power-off
