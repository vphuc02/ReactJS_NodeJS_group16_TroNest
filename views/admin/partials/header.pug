//- Header Quản Trị Viên TroNest (Đồng bộ phong cách hiện đại với Kênh Chủ Trọ & Web chính)
header.header(class="h-16 bg-white border-b border-slate-200 px-4 sm:px-8 flex items-center justify-between sticky top-0 z-30 shadow-sm")
  //- Bên trái: Mobile menu button & Lời chào Quản trị viên
  div(class="flex items-center gap-3")
    button.inner-button-menu(type="button" class="lg:hidden text-slate-600 hover:text-slate-900 p-1 rounded-lg border-0 bg-transparent cursor-pointer" aria-label="Mở menu")
      i.fa-solid.fa-bars(class="text-lg")

    if user
      div(class="flex items-center gap-2 flex-wrap")
        span(class="text-xs sm:text-sm font-medium text-slate-500 hidden sm:inline") Xin chào,
        span(class="text-xs sm:text-sm font-bold text-slate-800")= user.fullName
        span(class="inline-flex items-center gap-1 bg-emerald-50 text-emerald-700 text-[11px] font-semibold px-2.5 py-0.5 rounded-full border border-emerald-200" title="Tài khoản Quản trị viên hệ thống")
          i.fa-solid.fa-shield-halved(class="text-[11px] text-[#16A34A]")
          span Quản trị viên

  //- Bên phải: Xem website chính & Thông tin tài khoản
  div(class="flex items-center gap-3 sm:gap-4")
    a(
      href="/"
      target="_blank"
      class="text-xs font-semibold text-slate-600 hover:text-[#16A34A] flex items-center gap-1.5 transition-colors no-underline hidden md:flex"
      title="Mở website chính trong tab mới"
    )
      i.fa-solid.fa-globe(class="text-xs text-[#16A34A]")
      span Xem website chính

    div(class="h-4 w-px bg-slate-200 hidden sm:block")

    if user
      div(class="flex items-center gap-2.5")
        img(
          src=user.avatar || "/admin/assets/images/avatar.jpg"
          alt=user.fullName
          class="w-8 h-8 rounded-full object-cover border border-slate-200 ring-2 ring-emerald-50 shrink-0"
        )
        div(class="hidden xl:flex flex-col text-left")
          span(class="text-xs font-semibold text-slate-800 leading-tight")= user.fullName
          span(class="text-[10px] text-slate-400")= user.email

      a.btn-logout(
        href="/admin/logout"
        data-logout-url="/admin/logout"
        title="Đăng xuất"
        class="w-8 h-8 rounded-full flex items-center justify-center text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-colors no-underline ml-1"
      )
        i.fa-solid.fa-arrow-right-from-bracket(class="text-xs")
