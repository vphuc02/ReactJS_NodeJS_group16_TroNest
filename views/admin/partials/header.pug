header.header(class="admin-clean-118")
  div(class="admin-clean-119")
    a(href="/admin/dashboard" class="admin-clean-120")
      i.fa-solid.fa-shield-halved
      span TroNest Admin Panel

  div(class="admin-clean-121")
    a(href="/" target="_blank" class="admin-clean-122")
      i.fa-solid.fa-globe
      | Xem website chính

    if user
      .user-info(class="admin-clean-020")
        img(src=user.avatar || "/admin/assets/images/avatar.jpg" alt=user.fullName class="admin-clean-123")
        div
          span(class="admin-clean-124")= user.fullName
          span.badge.badge-blue(class="admin-clean-125") Quản trị viên

      a.btn-logout(href="/admin/logout" data-logout-url="/admin/logout" title="Đăng xuất" class="admin-clean-126")
        i.fa-solid.fa-power-off
