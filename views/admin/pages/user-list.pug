extends ../layouts/default.pug

block title
  title Quản lý người dùng - TroNest

block main
  div(class="admin-clean-040")
    div
      h1.box-title(class="admin-clean-041")
        | Quản lý người dùng hệ thống
      p(class="admin-clean-042")
        | Danh sách tất cả tài khoản Khách hàng, Chủ trọ và Quản trị viên trong hệ thống

  // Filter Form
  form(action="/admin/users" method="GET" class="admin-clean-105")
    select(name="role" class="admin-clean-106")
      option(value="") -- Tất cả vai trò --
      option(value=ROLES.CUSTOMER selected=roleFilter === ROLES.CUSTOMER) Khách hàng
      option(value=ROLES.LANDLORD selected=roleFilter === ROLES.LANDLORD) Chủ trọ
      option(value=ROLES.ADMIN selected=roleFilter === ROLES.ADMIN) Quản trị viên (Admin)

    select(name="status" class="admin-clean-106")
      option(value="") -- Tất cả trạng thái --
      option(value=USER_STATUS.ACTIVE selected=statusFilter === USER_STATUS.ACTIVE) Đang hoạt động (ACTIVE)
      option(value=USER_STATUS.INACTIVE selected=statusFilter === USER_STATUS.INACTIVE) Đã khóa (INACTIVE)
      option(value=USER_STATUS.PENDING selected=statusFilter === USER_STATUS.PENDING) Chờ duyệt (PENDING)
      option(value=USER_STATUS.APPROVED selected=statusFilter === USER_STATUS.APPROVED) Đã duyệt (APPROVED)

    div(class="admin-clean-107")
      i.fa-solid.fa-magnifying-glass(class="admin-clean-077")
      input(type="text" name="keyword" value=keyword placeholder="Tìm theo tên, email, sđt..." class="admin-clean-078")

    button.btn.btn-primary(type="submit") Lọc danh sách

  // Table
  .table-2(class="admin-clean-024")
    table
      thead
        tr
          th Họ tên
          th Email
          th Số điện thoại
          th Vai trò
          th Trạng thái
          th Thao tác
      tbody
        if users && users.length > 0
          each u in users
            tr
              td
                div(class="admin-clean-020")
                  img(src=u.avatar || "/admin/assets/images/avatar.jpg" class="admin-clean-108")
                  b(class="admin-clean-025")= u.fullName
              td= u.email
              td(class="admin-clean-026")= u.phone || '-'
              td
                if u.role === ROLES.ADMIN
                  span.badge.badge-blue Admin
                else if u.role === ROLES.LANDLORD
                  span.badge.badge-yellow Chủ trọ
                else
                  span.badge.badge-gray Khách hàng
              td
                if u.status === USER_STATUS.ACTIVE || u.status === USER_STATUS.APPROVED
                  span.badge.badge-green= u.status
                else if u.status === USER_STATUS.PENDING
                  span.badge.badge-yellow PENDING
                else
                  span.badge.badge-red= u.status
              td
                if u.role !== ROLES.ADMIN
                  button.btn.admin-small-action(data-admin-action="toggle-user-status" data-id=u._id class=u.status === USER_STATUS.INACTIVE ? 'btn-success' : 'btn-danger')
                    if u.status === USER_STATUS.INACTIVE
                      i.fa-solid.fa-lock-open
                      | Mở khóa
                    else
                      i.fa-solid.fa-lock
                      | Khóa tài khoản
                else
                  span(class="admin-clean-109") Không thể khóa
        else
          tr
            td(colspan="6" class="admin-clean-088")
              | Không tìm thấy người dùng phù hợp.
