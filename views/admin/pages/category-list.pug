extends ../layouts/default.pug
include ../../shared/pagination.pug

block title
  title Quản lý loại phòng trọ - TroNest

block main
  div(class="space-y-6 max-w-7xl mx-auto")
    //- 1. Header
    div
      h1.box-title(class="text-2xl font-bold tracking-tight text-slate-900 m-0")
        | Quản lý loại hình phòng trọ
      p(class="text-xs text-slate-500 m-0 mt-1")
        | Danh mục phân loại các hình thức cho thuê: Phòng trọ, Căn hộ mini, Chung cư mini, Ký túc xá...

    //- 2. Layout 2 cột: Danh sách & Form tạo mới
    .category-layout(class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start")
      //- Danh sách loại phòng (2/3)
      div(class="lg:col-span-2 bg-white rounded-2xl border border-slate-200/80 shadow-xs overflow-hidden")
        div(class="overflow-x-auto")
          table(class="w-full text-left border-collapse min-w-[560px]")
            thead
              tr(class="bg-slate-50/80 text-[11px] font-semibold text-slate-500 uppercase tracking-wider border-b border-slate-100")
                th(class="py-3 px-5") Icon
                th(class="py-3 px-4") Tên loại phòng
                th(class="py-3 px-4") Slug
                th(class="py-3 px-4") Số phòng
                th(class="py-3 px-5 text-right") Thao tác
            tbody(class="divide-y divide-slate-100 text-xs")
              if categories && categories.length > 0
                each cat in categories
                  tr(class="hover:bg-slate-50/70 transition-colors")
                    td(class="py-3.5 px-5")
                      div(class="w-9 h-9 rounded-xl bg-emerald-50 text-[#16A34A] flex items-center justify-center text-base")
                        i(class=cat.icon || "fa-solid fa-house-chimney")
                    td(class="py-3.5 px-4")
                      b(class="font-semibold text-slate-900 block")= cat.title
                      if cat.description
                        div(class="text-[11px] text-slate-400 mt-0.5")= cat.description
                    td(class="py-3.5 px-4 text-slate-500 font-mono text-[11px]")= cat.slug
                    td(class="py-3.5 px-4")
                      span(class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200/60")
                        | #{cat.roomCount || 0} phòng
                    td(class="py-3.5 px-5 text-right")
                      button(
                        type="button"
                        data-admin-action="delete-category"
                        data-id=cat._id
                        class="p-2 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-colors bg-transparent border-0 cursor-pointer"
                        title="Xóa loại phòng"
                      )
                        i.fa-solid.fa-trash-can(class="text-xs")
              else
                tr
                  td(colspan="5" class="py-12 text-center text-slate-400 text-xs")
                    | Chưa có loại phòng nào. Hãy thêm ở form bên phải.

        if paging && paging.totalPages > 1
          div(class="p-4 border-t border-slate-100 flex items-center justify-center sm:justify-between text-xs text-slate-500")
            span(class="hidden sm:inline") Trang #{paging.currentPage} / #{paging.totalPages}
            +pagination(paging, query, '/admin/categories')

      //- Form thêm mới (1/3)
      .create-card(class="bg-white p-5 sm:p-6 rounded-2xl border border-slate-200/80 shadow-xs")
        h3(class="text-sm font-bold text-slate-800 m-0 pb-3 mb-4 border-b border-slate-100 flex items-center gap-2")
          i.fa-solid.fa-plus-circle(class="text-[#16A34A]")
          span Thêm loại phòng mới

        form#form-create-cat(class="space-y-4 m-0")
          .form-group
            label(for="cat-title" class="block text-xs font-bold text-slate-700 mb-1.5")
              | Tên loại phòng 
              span(class="text-rose-500") *
            input#cat-title(
              type="text"
              name="title"
              placeholder="VD: Homestay nghỉ dưỡng"
              required
              class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-slate-200 bg-slate-50/50 focus:bg-white focus:outline-none focus:border-[#16A34A] focus:ring-2 focus:ring-[#16A34A]/15 transition-all"
            )

          .form-group
            label(for="cat-icon" class="block text-xs font-bold text-slate-700 mb-1.5")
              | FontAwesome Icon Class
            input#cat-icon(
              type="text"
              name="icon"
              value="fa-solid fa-house-chimney"
              placeholder="fa-solid fa-bed"
              class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-slate-200 bg-slate-50/50 focus:bg-white focus:outline-none focus:border-[#16A34A] focus:ring-2 focus:ring-[#16A34A]/15 transition-all"
            )

          .form-group
            label(for="cat-desc" class="block text-xs font-bold text-slate-700 mb-1.5")
              | Mô tả ngắn
            textarea#cat-desc(
              name="description"
              rows="3"
              placeholder="Mô tả đặc điểm loại hình phòng..."
              class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-slate-200 bg-slate-50/50 focus:bg-white focus:outline-none focus:border-[#16A34A] focus:ring-2 focus:ring-[#16A34A]/15 transition-all"
            )

          button#btn-create-cat(
            type="submit"
            class="w-full py-2.5 px-4 rounded-xl bg-[#16A34A] hover:bg-[#15803D] text-white text-xs font-bold shadow-sm transition-all cursor-pointer border-0 flex items-center justify-center gap-2"
          )
            i.fa-solid.fa-plus
            span Tạo loại phòng
