extends ../layouts/default.pug
include ../../shared/pagination.pug

block title
  title Quản lý loại phòng trọ - TroNest

block main
  div(class="admin-clean-040")
    div
      h1.box-title(class="admin-clean-041")
        | Quản lý loại hình phòng trọ
      p(class="admin-clean-042")
        | Danh mục phân loại các hình thức cho thuê: Phòng trọ, Căn hộ mini, Chung cư mini, Ký túc xá...

  .category-layout(class="admin-clean-048")
    // Danh sách loại phòng
    .table-2(class="admin-clean-024")
      table
        thead
          tr
            th Icon
            th Tên loại phòng
            th Slug
            th Số phòng
            th Thao tác
        tbody
          if categories && categories.length > 0
            each cat in categories
              tr
                td(class="admin-clean-089")
                  i(class=cat.icon || "fa-solid fa-house-chimney")
                td
                  b(class="admin-clean-025")= cat.title
                  if cat.description
                    div(class="admin-clean-035")= cat.description
                td(class="admin-clean-090")= cat.slug
                td
                  span.badge.badge-blue= `${cat.roomCount || 0} phòng`
                td
                  button.btn.btn-danger(data-admin-action="delete-category" data-id=cat._id class="admin-clean-038" title="Xóa loại phòng")
                    i.fa-solid.fa-trash-can
          else
            tr
              td(colspan="5" class="admin-clean-029")
                | Chưa có loại phòng nào. Hãy thêm ở form bên phải.

    // Form thêm mới
    .create-card(class="admin-clean-049")
      h3(class="admin-clean-063")
        i.fa-solid.fa-plus-circle(class="admin-clean-091")
        | Thêm loại phòng mới
      
      form#form-create-cat
        .form-group(class="admin-clean-092")
          label(class="admin-clean-093")
            | Tên loại phòng 
            span(class="admin-clean-094") *
          input#cat-title(type="text" name="title" placeholder="VD: Homestay nghỉ dưỡng" required class="admin-clean-095")

        .form-group(class="admin-clean-092")
          label(class="admin-clean-093")
            | FontAwesome Icon Class
          input#cat-icon(type="text" name="icon" value="fa-solid fa-house-chimney" placeholder="fa-solid fa-bed" class="admin-clean-095")

        .form-group(class="admin-clean-058")
          label(class="admin-clean-093")
            | Mô tả ngắn
          textarea#cat-desc(name="description" rows="3" placeholder="Mô tả đặc điểm loại hình phòng..." class="admin-clean-096")

        button#btn-create-cat.btn.btn-primary(type="submit" class="admin-clean-097")
          i.fa-solid.fa-plus
          | Tạo loại phòng

  +pagination(paging, query, '/admin/categories')
