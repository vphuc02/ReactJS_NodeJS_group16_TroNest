extends ../layouts/default.pug

block title
  title Quản lý và Phê duyệt Chủ trọ - TroNest

block main
  div(style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;")
    div
      h1.box-title(style="margin: 0 0 6px; font-size: 24px; font-weight: 800; color: #1e293b;")
        | Quản lý & Phê duyệt Chủ trọ
      p(style="margin: 0; color: #64748b; font-size: 14px;")
        | Kiểm tra thông tin các đối tác Chủ trọ và quyết định cấp quyền đăng tin phòng

  // Filter Tabs
  .filter-tabs(style="display: flex; gap: 10px; margin-bottom: 20px; overflow-x: auto; padding-bottom: 4px;")
    a.btn(href="/admin/landlords" class=!statusFilter ? 'btn-primary' : 'btn-secondary')
      | Tất cả (#{counts.all})
    a.btn(href="/admin/landlords?status=PENDING" class=statusFilter === 'PENDING' ? 'btn-primary' : 'btn-secondary')
      i.fa-solid.fa-clock(style="color: #ca8a04;")
      | Chờ duyệt (#{counts.pending})
    a.btn(href="/admin/landlords?status=APPROVED" class=statusFilter === 'APPROVED' ? 'btn-primary' : 'btn-secondary')
      i.fa-solid.fa-circle-check(style="color: #16a34a;")
      | Đã duyệt (#{counts.approved})
    a.btn(href="/admin/landlords?status=REJECTED" class=statusFilter === 'REJECTED' ? 'btn-primary' : 'btn-secondary')
      i.fa-solid.fa-circle-xmark(style="color: #dc2626;")
      | Bị từ chối (#{counts.rejected})

  // Search Box
  form(action="/admin/landlords" method="GET" style="display: flex; gap: 12px; margin-bottom: 20px; max-width: 450px;")
    if statusFilter
      input(type="hidden" name="status" value=statusFilter)
    div(style="flex: 1; display: flex; align-items: center; gap: 8px; background: #fff; border: 1px solid #cbd5e1; border-radius: 8px; padding: 8px 12px;")
      i.fa-solid.fa-magnifying-glass(style="color: #94a3b8;")
      input(type="text" name="keyword" value=keyword placeholder="Tìm tên, email, SĐT..." style="border: none; outline: none; width: 100%; font-size: 14px;")
    button.btn.btn-primary(type="submit") Tìm kiếm

  // Table
  .table-2(style="background: #fff; border-radius: 16px; overflow: hidden; border: 1px solid #e2e8f0; box-shadow: 0 4px 15px rgba(0,0,0,0.02);")
    table
      thead
        tr
          th Họ tên
          th Liên hệ
          th Địa chỉ
          th Số bài trọ
          th Trạng thái
          th Thao tác
      tbody
        if landlords && landlords.length > 0
          each l in landlords
            tr
              td
                div(style="display: flex; align-items: center; gap: 12px;")
                  img(src=l.avatar || "/admin/assets/images/avatar.jpg" style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover;")
                  div
                    b(style="color: #1e293b; font-size: 15px; display: block;")= l.fullName
                    span(style="font-size: 12px; color: #64748b;") Tham gia: #{new Date(l.createdAt).toLocaleDateString('vi-VN')}
              td
                div(style="font-size: 14px; color: #1e293b;")= l.email
                div(style="font-size: 13px; font-weight: 600; color: #2563eb;")= l.phone || '-'
              td= l.address || '-'
              td(style="font-weight: 700; color: #475569;")= l.roomCount || 0
              td
                if l.status === 'APPROVED'
                  span.badge.badge-green Đã duyệt (APPROVED)
                else if l.status === 'PENDING'
                  span.badge.badge-yellow Chờ duyệt (PENDING)
                else if l.status === 'REJECTED'
                  span.badge.badge-red Bị từ chối (REJECTED)
                  if l.rejectReason
                    div(style="font-size: 12px; color: #b91c1c; margin-top: 4px; max-width: 220px;")
                      | #{l.rejectReason}
              td
                div(style="display: flex; gap: 8px;")
                  if l.status !== 'APPROVED'
                    button.btn.btn-success(onclick=`approveLandlord('${l._id}')` style="padding: 6px 12px; font-size: 13px;" title="Phê duyệt tài khoản")
                      i.fa-solid.fa-check
                      | Duyệt
                  if l.status !== 'REJECTED'
                    button.btn.btn-danger(onclick=`rejectLandlord('${l._id}')` style="padding: 6px 12px; font-size: 13px;" title="Từ chối tài khoản")
                      i.fa-solid.fa-xmark
                      | Từ chối
        else
          tr
            td(colspan="6" style="text-align: center; padding: 40px; color: #64748b;")
              | Không tìm thấy tài khoản Chủ trọ nào phù hợp.

  script.
    function approveLandlord(id) {
      if (!confirm("Xác nhận phê duyệt tài khoản Chủ trọ này để cho phép họ đăng bài?")) return;
      fetch('/admin/landlords/approve/' + id, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      })
      .then(res => res.json())
      .then(data => {
        if (data.code === 200) {
          notyf.success(data.message);
          setTimeout(() => location.reload(), 1200);
        } else notyf.error(data.message);
      });
    }

    function rejectLandlord(id) {
      const reason = prompt("Nhập lý do từ chối tài khoản Chủ trọ:");
      if (reason === null) return;
      fetch('/admin/landlords/reject/' + id, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reason })
      })
      .then(res => res.json())
      .then(data => {
        if (data.code === 200) {
          notyf.success(data.message);
          setTimeout(() => location.reload(), 1200);
        } else notyf.error(data.message);
      });
    }
