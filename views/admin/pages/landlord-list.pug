extends ../layouts/default.pug
include ../../shared/pagination.pug

block title
  title Quản lý và Phê duyệt Chủ trọ - TroNest

block main
  div(class="admin-clean-040")
    div
      h1.box-title(class="admin-clean-041")
        | Quản lý & Phê duyệt Chủ trọ
      p(class="admin-clean-042")
        | Kiểm tra thông tin các đối tác Chủ trọ và quyết định cấp quyền đăng tin phòng

  // Filter Tabs
  .filter-tabs(class="admin-clean-070")
    a.btn(href="/admin/landlords" class=!statusFilter ? 'btn-primary' : 'btn-secondary')
      | Tất cả (#{counts.all})
    a.btn(href="/admin/landlords?status=" + USER_STATUS.PENDING class=statusFilter === USER_STATUS.PENDING ? 'btn-primary' : 'btn-secondary')
      i.fa-solid.fa-clock(class="admin-clean-071")
      | Chờ duyệt (#{counts.pending})
    a.btn(href="/admin/landlords?status=" + USER_STATUS.APPROVED class=statusFilter === USER_STATUS.APPROVED ? 'btn-primary' : 'btn-secondary')
      i.fa-solid.fa-circle-check(class="admin-clean-072")
      | Đã duyệt (#{counts.approved})
    a.btn(href="/admin/landlords?status=" + USER_STATUS.REJECTED class=statusFilter === USER_STATUS.REJECTED ? 'btn-primary' : 'btn-secondary')
      i.fa-solid.fa-circle-xmark(class="admin-clean-073")
      | Bị từ chối (#{counts.rejected})

  // Search Box
  form(action="/admin/landlords" method="GET" class="admin-clean-075")
    if statusFilter
      input(type="hidden" name="status" value=statusFilter)
    div(class="admin-clean-076")
      i.fa-solid.fa-magnifying-glass(class="admin-clean-077")
      input(type="text" name="keyword" value=keyword placeholder="Tìm tên, email, SĐT..." class="admin-clean-078")
    button.btn.btn-primary(type="submit") Tìm kiếm

  // Table
  .table-2(class="admin-clean-024")
    table
      thead
        tr
          th Họ tên
          th Liên hệ
          th Địa chỉ
          th Số bài trọ
          th Trạng thái
          th Thao tác
      tbody
        if landlords && landlords.length > 0
          each l in landlords
            tr
              td
                div(class="admin-clean-098")
                  img(src=l.avatar || "/admin/assets/images/avatar.jpg" class="admin-clean-099")
                  div
                    b(class="admin-clean-100")= l.fullName
                    span(class="admin-clean-035") Tham gia: #{new Date(l.createdAt).toLocaleDateString('vi-VN')}
              td
                div(class="admin-clean-101")= l.email
                div(class="admin-clean-102")= l.phone || '-'
              td= l.address || '-'
              td(class="admin-clean-103")= l.roomCount || 0
              td
                if l.status === USER_STATUS.APPROVED
                  span.badge.badge-green Đã duyệt (APPROVED)
                else if l.status === USER_STATUS.PENDING
                  span.badge.badge-yellow Chờ duyệt (PENDING)
                else if l.status === USER_STATUS.REJECTED
                  span.badge.badge-red Bị từ chối (REJECTED)
                  if l.rejectReason
                    div(class="admin-clean-104")
                      | #{l.rejectReason}
              td
                div(class="admin-clean-027")
                  if l.status !== USER_STATUS.APPROVED
                    button.btn.btn-success(data-admin-action="approve-landlord" data-id=l._id class="admin-clean-028" title="Phê duyệt tài khoản")
                      i.fa-solid.fa-check
                      | Duyệt
                  if l.status !== USER_STATUS.REJECTED
                    button.btn.btn-danger(data-admin-action="reject-landlord" data-id=l._id class="admin-clean-028" title="Từ chối tài khoản")
                      i.fa-solid.fa-xmark
                      | Từ chối
        else
          tr
            td(colspan="6" class="admin-clean-088")
              | Không tìm thấy tài khoản Chủ trọ nào phù hợp.

  +pagination(paging, query, '/admin/landlords')
