extends ../layouts/default.pug

block title
  title Tổng quan Quản trị - TroNest

block main
  h1.box-title(class="admin-clean-001")
    | Bảng điều khiển Quản trị viên (Admin)

  // Metrics Grid
  .stats-grid(class="admin-clean-002")
    // Chủ trọ chờ duyệt
    .stat-card(class="admin-clean-003")
      div(class="admin-clean-004")
        i.fa-solid.fa-user-clock
      div
        span(class="admin-clean-005") Chủ trọ chờ duyệt
        h3(class="admin-clean-006")= pendingLandlordsCount

    // Bài đăng chờ duyệt
    .stat-card(class="admin-clean-007")
      div(class="admin-clean-008")
        i.fa-solid.fa-hourglass-half
      div
        span(class="admin-clean-009") Bài đăng chờ duyệt
        h3(class="admin-clean-010")= pendingRoomsCount

    // Tổng số chủ trọ
    .stat-card(class="admin-clean-011")
      div(class="admin-clean-012")
        i.fa-solid.fa-user-tie
      div
        span(class="admin-clean-013") Tổng số Chủ trọ
        h3(class="admin-clean-014")= totalLandlords

    // Phòng đã duyệt công khai
    .stat-card(class="admin-clean-011")
      div(class="admin-clean-015")
        i.fa-solid.fa-circle-check
      div
        span(class="admin-clean-013") Phòng đang hiển thị
        h3(class="admin-clean-016")= approvedRoomsCount

    // Tổng khách hàng
    .stat-card(class="admin-clean-011")
      div(class="admin-clean-017")
        i.fa-solid.fa-users
      div
        span(class="admin-clean-013") Tổng Khách hàng
        h3(class="admin-clean-014")= totalCustomers

  // 1. BẢNG DUYỆT NHANH CHỦ TRỌ
  .section-pending-landlords(class="admin-clean-018")
    div(class="admin-clean-019")
      div(class="admin-clean-020")
        h2(class="admin-clean-021")
          i.fa-solid.fa-user-clock(class="admin-clean-022")
          | Chủ trọ mới đăng ký đang chờ phê duyệt
        if pendingLandlordsCount > 0
          span.badge.badge-yellow= `${pendingLandlordsCount} chờ duyệt`
      a(href="/admin/landlords" class="admin-clean-023") Xem tất cả

    .table-2(class="admin-clean-024")
      table
        thead
          tr
            th Họ tên
            th Email
            th Số điện thoại
            th Địa chỉ
            th Ngày đăng ký
            th Hành động
        tbody
          if pendingLandlords && pendingLandlords.length > 0
            each l in pendingLandlords
              tr
                td
                  b(class="admin-clean-025")= l.fullName
                td= l.email
                td(class="admin-clean-026")= l.phone || '-'
                td= l.address || '-'
                td= new Date(l.createdAt).toLocaleDateString('vi-VN')
                td
                  div(class="admin-clean-027")
                    button.btn.btn-success(data-admin-action="approve-landlord" data-id=l._id class="admin-clean-028" title="Phê duyệt cho phép đăng phòng")
                      i.fa-solid.fa-check
                      | Duyệt ngay
                    button.btn.btn-danger(data-admin-action="reject-landlord" data-id=l._id class="admin-clean-028" title="Từ chối")
                      i.fa-solid.fa-xmark
                      | Từ chối
          else
            tr
              td(colspan="6" class="admin-clean-029")
                i.fa-solid.fa-circle-check(class="admin-clean-030")
                | Không có tài khoản Chủ trọ nào đang chờ duyệt!

  // 2. BẢNG DUYỆT NHANH BÀI ĐĂNG PHÒNG TRỌ
  .section-pending-rooms
    div(class="admin-clean-019")
      div(class="admin-clean-020")
        h2(class="admin-clean-021")
          i.fa-solid.fa-house-circle-check(class="admin-clean-031")
          | Bài đăng phòng trọ mới đang chờ phê duyệt
        if pendingRoomsCount > 0
          span.badge.badge-yellow= `${pendingRoomsCount} chờ duyệt`
      a(href="/admin/rooms" class="admin-clean-023") Xem tất cả bài

    .table-2(class="admin-clean-024")
      table
        thead
          tr
            th Ảnh
            th Tiêu đề phòng
            th Chủ trọ
            th Giá thuê
            th Diện tích
            th Hành động
        tbody
          if pendingRooms && pendingRooms.length > 0
            each r in pendingRooms
              tr
                td(class="admin-clean-032")
                  img(src=r.thumbnail || "/client/assets/images/product-1.jpg" class="admin-clean-033")
                td
                  b(class="admin-clean-034")= r.title
                  div(class="admin-clean-035")= r.address
                td
                  div(class="admin-clean-036")= r.landlordId ? r.landlordId.fullName : '-'
                  div(class="admin-clean-035")= r.landlordId ? r.landlordId.phone : ''
                td(class="admin-clean-037") #{r.price.toLocaleString('vi-VN')} đ
                td #{r.area} m²
                td
                  div(class="admin-clean-027")
                    a.btn.btn-secondary(href=`/admin/rooms/detail/${r._id}` class="admin-clean-038" title="Xem chi tiết thẩm định")
                      i.fa-solid.fa-magnifying-glass
                      | Thẩm định
                    button.btn.btn-success(data-admin-action="approve-room" data-id=r._id class="admin-clean-039" title="Duyệt xuất bản")
                      i.fa-solid.fa-check
                      | Duyệt
                    button.btn.btn-danger(data-admin-action="reject-room" data-id=r._id class="admin-clean-039" title="Từ chối")
                      i.fa-solid.fa-xmark
          else
            tr
              td(colspan="6" class="admin-clean-029")
                i.fa-solid.fa-circle-check(class="admin-clean-030")
                | Không có bài đăng nào đang chờ duyệt! Tất cả đã được xử lý.
