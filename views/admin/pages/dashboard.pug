extends ../layouts/default.pug

block title
  title Tổng quan Quản trị - TroNest

block main
  h1.box-title(style="margin-bottom: 24px; font-size: 24px; font-weight: 800; color: #1e293b;")
    | Bảng điều khiển Quản trị viên (Admin)

  // Metrics Grid
  .stats-grid(style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 30px;")
    // Chủ trọ chờ duyệt
    .stat-card(style="background: #fff; padding: 20px; border-radius: 16px; border: 1px solid #fef08a; background: linear-gradient(135deg, #fff 0%, #fefce8 100%); display: flex; align-items: center; gap: 16px;")
      div(style="width: 50px; height: 50px; border-radius: 12px; background: #fef08a; color: #854d0e; display: flex; align-items: center; justify-content: center; font-size: 22px;")
        i.fa-solid.fa-user-clock
      div
        span(style="font-size: 13px; color: #854d0e; font-weight: 700;") Chủ trọ chờ duyệt
        h3(style="font-size: 26px; font-weight: 800; color: #ca8a04; margin: 4px 0 0;")= pendingLandlordsCount

    // Bài đăng chờ duyệt
    .stat-card(style="background: #fff; padding: 20px; border-radius: 16px; border: 1px solid #fde68a; background: linear-gradient(135deg, #fff 0%, #fffbeb 100%); display: flex; align-items: center; gap: 16px;")
      div(style="width: 50px; height: 50px; border-radius: 12px; background: #fef3c7; color: #b45309; display: flex; align-items: center; justify-content: center; font-size: 22px;")
        i.fa-solid.fa-hourglass-half
      div
        span(style="font-size: 13px; color: #b45309; font-weight: 700;") Bài đăng chờ duyệt
        h3(style="font-size: 26px; font-weight: 800; color: #d97706; margin: 4px 0 0;")= pendingRoomsCount

    // Tổng số chủ trọ
    .stat-card(style="background: #fff; padding: 20px; border-radius: 16px; border: 1px solid #e2e8f0; display: flex; align-items: center; gap: 16px;")
      div(style="width: 50px; height: 50px; border-radius: 12px; background: #e0e7ff; color: #4338ca; display: flex; align-items: center; justify-content: center; font-size: 22px;")
        i.fa-solid.fa-user-tie
      div
        span(style="font-size: 13px; color: #64748b; font-weight: 600;") Tổng số Chủ trọ
        h3(style="font-size: 24px; font-weight: 800; color: #1e293b; margin: 4px 0 0;")= totalLandlords

    // Phòng đã duyệt công khai
    .stat-card(style="background: #fff; padding: 20px; border-radius: 16px; border: 1px solid #e2e8f0; display: flex; align-items: center; gap: 16px;")
      div(style="width: 50px; height: 50px; border-radius: 12px; background: #dcfce7; color: #15803d; display: flex; align-items: center; justify-content: center; font-size: 22px;")
        i.fa-solid.fa-circle-check
      div
        span(style="font-size: 13px; color: #64748b; font-weight: 600;") Phòng đang hiển thị
        h3(style="font-size: 24px; font-weight: 800; color: #16a34a; margin: 4px 0 0;")= approvedRoomsCount

    // Tổng khách hàng
    .stat-card(style="background: #fff; padding: 20px; border-radius: 16px; border: 1px solid #e2e8f0; display: flex; align-items: center; gap: 16px;")
      div(style="width: 50px; height: 50px; border-radius: 12px; background: #f1f5f9; color: #475569; display: flex; align-items: center; justify-content: center; font-size: 22px;")
        i.fa-solid.fa-users
      div
        span(style="font-size: 13px; color: #64748b; font-weight: 600;") Tổng Khách hàng
        h3(style="font-size: 24px; font-weight: 800; color: #1e293b; margin: 4px 0 0;")= totalCustomers

  // 1. BẢNG DUYỆT NHANH CHỦ TRỌ
  .section-pending-landlords(style="margin-bottom: 35px;")
    div(style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;")
      div(style="display: flex; align-items: center; gap: 10px;")
        h2(style="font-size: 18px; font-weight: 700; color: #1e293b; margin: 0;")
          i.fa-solid.fa-user-clock(style="color: #ca8a04; margin-right: 8px;")
          | Chủ trọ mới đăng ký đang chờ phê duyệt
        if pendingLandlordsCount > 0
          span.badge.badge-yellow= `${pendingLandlordsCount} chờ duyệt`
      a(href="/admin/landlords" style="color: #2563eb; font-size: 14px; font-weight: 700; text-decoration: none;") Xem tất cả

    .table-2(style="background: #fff; border-radius: 16px; overflow: hidden; border: 1px solid #e2e8f0; box-shadow: 0 4px 15px rgba(0,0,0,0.02);")
      table
        thead
          tr
            th Họ tên
            th Email
            th Số điện thoại
            th Địa chỉ
            th Ngày đăng ký
            th Hành động
        tbody
          if pendingLandlords && pendingLandlords.length > 0
            each l in pendingLandlords
              tr
                td
                  b(style="color: #1e293b;")= l.fullName
                td= l.email
                td(style="font-weight: 600; color: #2563eb;")= l.phone || '-'
                td= l.address || '-'
                td= new Date(l.createdAt).toLocaleDateString('vi-VN')
                td
                  div(style="display: flex; gap: 8px;")
                    button.btn.btn-success(onclick=`approveLandlord('${l._id}')` style="padding: 6px 12px; font-size: 13px;" title="Phê duyệt cho phép đăng phòng")
                      i.fa-solid.fa-check
                      | Duyệt ngay
                    button.btn.btn-danger(onclick=`rejectLandlord('${l._id}')` style="padding: 6px 12px; font-size: 13px;" title="Từ chối")
                      i.fa-solid.fa-xmark
                      | Từ chối
          else
            tr
              td(colspan="6" style="text-align: center; padding: 30px; color: #64748b;")
                i.fa-solid.fa-circle-check(style="color: #16a34a; margin-right: 6px;")
                | Không có tài khoản Chủ trọ nào đang chờ duyệt!

  // 2. BẢNG DUYỆT NHANH BÀI ĐĂNG PHÒNG TRỌ
  .section-pending-rooms
    div(style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;")
      div(style="display: flex; align-items: center; gap: 10px;")
        h2(style="font-size: 18px; font-weight: 700; color: #1e293b; margin: 0;")
          i.fa-solid.fa-house-circle-check(style="color: #d97706; margin-right: 8px;")
          | Bài đăng phòng trọ mới đang chờ phê duyệt
        if pendingRoomsCount > 0
          span.badge.badge-yellow= `${pendingRoomsCount} chờ duyệt`
      a(href="/admin/rooms" style="color: #2563eb; font-size: 14px; font-weight: 700; text-decoration: none;") Xem tất cả bài

    .table-2(style="background: #fff; border-radius: 16px; overflow: hidden; border: 1px solid #e2e8f0; box-shadow: 0 4px 15px rgba(0,0,0,0.02);")
      table
        thead
          tr
            th Ảnh
            th Tiêu đề phòng
            th Chủ trọ
            th Giá thuê
            th Diện tích
            th Hành động
        tbody
          if pendingRooms && pendingRooms.length > 0
            each r in pendingRooms
              tr
                td(style="width: 80px;")
                  img(src=r.thumbnail || "/client/assets/images/product-1.jpg" style="width: 65px; height: 50px; object-fit: cover; border-radius: 8px;")
                td
                  b(style="color: #1e293b; display: block;")= r.title
                  div(style="font-size: 12px; color: #64748b;")= r.address
                td
                  div(style="font-weight: 600; color: #1e293b;")= r.landlordId ? r.landlordId.fullName : '-'
                  div(style="font-size: 12px; color: #64748b;")= r.landlordId ? r.landlordId.phone : ''
                td(style="font-weight: 700; color: #ff5100;") #{r.price.toLocaleString('vi-VN')} đ
                td #{r.area} m²
                td
                  div(style="display: flex; gap: 8px;")
                    a.btn.btn-secondary(href=`/admin/rooms/detail/${r._id}` style="padding: 6px 10px; font-size: 12px;" title="Xem chi tiết thẩm định")
                      i.fa-solid.fa-magnifying-glass
                      | Thẩm định
                    button.btn.btn-success(onclick=`approveRoom('${r._id}')` style="padding: 6px 12px; font-size: 12px;" title="Duyệt xuất bản")
                      i.fa-solid.fa-check
                      | Duyệt
                    button.btn.btn-danger(onclick=`rejectRoom('${r._id}')` style="padding: 6px 12px; font-size: 12px;" title="Từ chối")
                      i.fa-solid.fa-xmark
          else
            tr
              td(colspan="6" style="text-align: center; padding: 30px; color: #64748b;")
                i.fa-solid.fa-circle-check(style="color: #16a34a; margin-right: 6px;")
                | Không có bài đăng nào đang chờ duyệt! Tất cả đã được xử lý.

  script.
    function approveLandlord(id) {
      if (!confirm("Xác nhận phê duyệt tài khoản Chủ trọ này?")) return;
      fetch('/admin/landlords/approve/' + id, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      })
      .then(res => res.json())
      .then(data => {
        if (data.code === 200) {
          notyf.success(data.message);
          setTimeout(() => location.reload(), 1200);
        } else notyf.error(data.message);
      });
    }

    function rejectLandlord(id) {
      const reason = prompt("Nhập lý do từ chối tài khoản Chủ trọ này:");
      if (reason === null) return;
      fetch('/admin/landlords/reject/' + id, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reason })
      })
      .then(res => res.json())
      .then(data => {
        if (data.code === 200) {
          notyf.success(data.message);
          setTimeout(() => location.reload(), 1200);
        } else notyf.error(data.message);
      });
    }

    function approveRoom(id) {
      if (!confirm("Xác nhận duyệt bài đăng phòng này và công khai trên website?")) return;
      fetch('/admin/rooms/approve/' + id, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      })
      .then(res => res.json())
      .then(data => {
        if (data.code === 200) {
          notyf.success(data.message);
          setTimeout(() => location.reload(), 1200);
        } else notyf.error(data.message);
      });
    }

    function rejectRoom(id) {
      const reason = prompt("Nhập lý do từ chối bài đăng phòng này:");
      if (reason === null) return;
      fetch('/admin/rooms/reject/' + id, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reason })
      })
      .then(res => res.json())
      .then(data => {
        if (data.code === 200) {
          notyf.success(data.message);
          setTimeout(() => location.reload(), 1200);
        } else notyf.error(data.message);
      });
    }
