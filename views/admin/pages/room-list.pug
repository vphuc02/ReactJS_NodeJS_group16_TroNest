extends ../layouts/default.pug
include ../../shared/pagination.pug

block title
  title Quản lý và Phê duyệt bài đăng phòng trọ - TroNest

block main
  div(class="space-y-6 max-w-7xl mx-auto")
    //- 1. Header
    div(class="flex flex-col sm:flex-row sm:items-center justify-between gap-4")
      div
        h1.box-title(class="text-2xl font-bold tracking-tight text-slate-900 m-0")
          | Quản lý & Phê duyệt Bài đăng phòng trọ
        p(class="text-xs text-slate-500 m-0 mt-1")
          | Kiểm duyệt nội dung bài đăng phòng trước khi cho phép hiển thị công khai trên website

  // Filter Tabs
  .filter-tabs(class="admin-clean-070")
    a.btn(href="/admin/rooms" + (keyword ? '?keyword=' + encodeURIComponent(keyword) : '') class=!statusFilter ? 'btn-primary' : 'btn-secondary')
      | Tất cả (#{counts.all})
    a.btn(href="/admin/rooms?status=" + ROOM_STATUS.PENDING + (keyword ? '&keyword=' + encodeURIComponent(keyword) : '') class=statusFilter === ROOM_STATUS.PENDING ? 'btn-primary' : 'btn-secondary')
      i.fa-solid.fa-clock(class="admin-clean-071")
      | Chờ duyệt (#{counts.pending})
    a.btn(href="/admin/rooms?status=" + ROOM_STATUS.APPROVED + (keyword ? '&keyword=' + encodeURIComponent(keyword) : '') class=statusFilter === ROOM_STATUS.APPROVED ? 'btn-primary' : 'btn-secondary')
      i.fa-solid.fa-circle-check(class="admin-clean-072")
      | Đã duyệt (#{counts.approved})
    a.btn(href="/admin/rooms?status=" + ROOM_STATUS.REJECTED + (keyword ? '&keyword=' + encodeURIComponent(keyword) : '') class=statusFilter === ROOM_STATUS.REJECTED ? 'btn-primary' : 'btn-secondary')
      i.fa-solid.fa-circle-xmark(class="admin-clean-073")
      | Bị từ chối (#{counts.rejected})
    a.btn(href="/admin/rooms?status=" + ROOM_STATUS.DRAFT + (keyword ? '&keyword=' + encodeURIComponent(keyword) : '') class=statusFilter === ROOM_STATUS.DRAFT ? 'btn-primary' : 'btn-secondary')
      i.fa-solid.fa-file-lines(class="admin-clean-074")
      | Bản nháp (#{counts.draft})

  // Search Box
  form(action="/admin/rooms" method="GET" class="admin-clean-075")
    if statusFilter
      input(type="hidden" name="status" value=statusFilter)
    div(class="admin-clean-076")
      i.fa-solid.fa-magnifying-glass(class="admin-clean-077")
      input(type="text" name="keyword" value=keyword placeholder="Tìm tiêu đề, địa chỉ, chủ trọ..." class="admin-clean-078")
    button.btn.btn-primary(type="submit") Tìm kiếm

  // Table
  .table-2(class="admin-clean-024")
    table
      thead
        tr
          th Ảnh
          th Thông tin bài đăng
          th Chủ trọ
          th Giá & Diện tích
          th Trạng thái
          th Thao tác
      tbody
        if rooms && rooms.length > 0
          each room in rooms
            tr
              td(class="admin-clean-079")
                img(src=room.thumbnail || "/client/assets/images/product-1.jpg" class="admin-clean-080")
              td
                b(class="admin-clean-081")= room.title
                div(class="admin-clean-035")= room.address
                if room.categoryId
                  span(class="admin-clean-082")
                    = room.categoryId.title
                if room.status === ROOM_STATUS.REJECTED && room.rejectReason
                  div(class="admin-clean-083")
                    b Lý do: 
                    = room.rejectReason
              td
                b(class="admin-clean-034")= room.landlordId ? room.landlordId.fullName : '-'
                span(class="admin-clean-084")= room.landlordId ? room.landlordId.phone : ''
              td
                div(class="admin-clean-085")
                  = room.price.toLocaleString('vi-VN') + ' đ'
                div(class="admin-clean-035") #{room.area} m² - #{room.capacity || 2} người
              td
                if room.status === ROOM_STATUS.APPROVED
                  span.badge.badge-green Đã duyệt (APPROVED)
                else if room.status === ROOM_STATUS.PENDING
                  span.badge.badge-yellow Chờ duyệt (PENDING)
                else if room.status === ROOM_STATUS.DRAFT
                  span.badge.badge-gray Bản nháp (DRAFT)
                else if room.status === ROOM_STATUS.REJECTED
                  span.badge.badge-red Bị từ chối (REJECTED)
              td
                div(class="admin-clean-086")
                  a.btn.btn-secondary(href=`/admin/rooms/detail/${room._id}` class="admin-clean-038" title="Thẩm định nội dung")
                    i.fa-solid.fa-magnifying-glass
                    span Thẩm định
                  
                  if room.status !== ROOM_STATUS.APPROVED
                    button.btn.btn-success(data-admin-action="approve-room" data-id=room._id class="admin-clean-038" title="Phê duyệt bài đăng")
                      i.fa-solid.fa-check
                      span Duyệt
                  
                  if room.status !== ROOM_STATUS.REJECTED
                    button.btn.btn-danger(data-admin-action="reject-room" data-id=room._id class="admin-clean-038" title="Từ chối / Gỡ bài đăng")
                      i.fa-solid.fa-xmark
                      span Từ chối

                  if room.status === ROOM_STATUS.APPROVED
                    a.btn.btn-secondary(href=`/rooms/detail/${room._id}` target="_blank" class="admin-clean-038" title="Xem trên website")
                      i.fa-solid.fa-arrow-up-right-from-square
                      span Xem web

                  button.btn.btn-secondary(data-admin-action="delete-room" data-id=room._id class="admin-clean-087" title="Xóa vĩnh viễn")
                    i.fa-solid.fa-trash-can
        else
          tr
            td(colspan="6" class="admin-clean-088")
              | Không có bài đăng nào trong danh mục này.

                      if room.status === ROOM_STATUS.PENDING
                        button(
                          type="button"
                          data-admin-action="reject-room"
                          data-id=room._id
                          class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-rose-50 hover:bg-rose-600 text-rose-600 hover:text-white border border-rose-200 hover:border-rose-600 text-xs font-semibold transition-colors cursor-pointer"
                          title="Từ chối bài đăng"
                        )
                          i.fa-solid.fa-xmark(class="text-[11px]")
                          span Từ chối

                      button(
                        type="button"
                        data-admin-action="delete-room"
                        data-id=room._id
                        class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-colors bg-transparent border-0 cursor-pointer"
                        title="Xóa vĩnh viễn"
                      )
                        i.fa-solid.fa-trash-can(class="text-xs")
            else
              tr
                td(colspan="5" class="py-12 text-center text-slate-400 text-xs")
                  | Không có bài đăng nào trong danh mục này.

      if paging && paging.totalPages > 1
        div(class="p-4 border-t border-slate-100 flex items-center justify-center sm:justify-between text-xs text-slate-500")
          span(class="hidden sm:inline") Trang #{paging.currentPage} / #{paging.totalPages} (Tổng #{paging.total} bài đăng)
          +pagination(paging, query, '/admin/rooms')
