extends ../layouts/account.pug

block title
  title Đăng nhập Quản trị viên - TroNest

block main
  .form-account
    .inner-logo(class="admin-clean-113")
      div(class="admin-clean-114")
        i.fa-solid.fa-shield-halved(class="admin-clean-115")
        span TroNest Admin
    h2.inner-title Đăng nhập Quản trị
    p.inner-desc(class="admin-clean-116") Cổng xác thực Ban Quản trị hệ thống
    
    form.inner-form#login-form
      .inner-group
        label.inner-label(for="email") Email Quản trị viên
        input.inner-control(
          type="email"
          name="email"
          id="email"
          value="admin@tronest.com"
          placeholder="admin@tronest.com"
        )
      .inner-group
        label.inner-label(for="password") Mật khẩu
        input.inner-control(
          type="password"
          name="password"
          id="password"
          value="123456"
        )
      .inner-meta
        .inner-confirm
          input.inner-check(
            type="checkbox"
            name="rememberPassword"
            id="remember-password"
            checked
          )
          label.inner-label(for="remember-password") Nhớ mật khẩu
      button.inner-button(type="submit" class="admin-clean-117") Đăng Nhập Quản Trị
