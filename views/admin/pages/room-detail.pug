extends ../layouts/default.pug

block title
  title= `Thẩm định bài đăng: ${room.title} - TroNest`

block main
  div(class="admin-clean-040")
    div
      h1.box-title(class="admin-clean-041")
        | Thẩm định bài đăng phòng trọ
      p(class="admin-clean-042")
        | Kiểm tra nội dung bài đăng trước khi ra quyết định phê duyệt hoặc từ chối
    
    div(class="admin-clean-043")
      if room.status !== ROOM_STATUS.APPROVED
        button.btn.btn-success(data-admin-action="approve-room" data-id=room._id class="admin-clean-044")
          i.fa-solid.fa-check
          | Phê duyệt xuất bản

      if room.status !== ROOM_STATUS.REJECTED
        button.btn.btn-danger(data-admin-action="reject-room" data-id=room._id class="admin-clean-044")
          i.fa-solid.fa-xmark
          | Từ chối / Gỡ bài

      if room.status === ROOM_STATUS.APPROVED
        a.btn.btn-secondary(href=`/rooms/detail/${room._id}` target="_blank" class="admin-clean-044")
          i.fa-solid.fa-arrow-up-right-from-square
          | Xem trên website

      button.btn.btn-danger(data-admin-action="delete-room" data-id=room._id class="admin-clean-044")
        i.fa-solid.fa-trash-can
        | Xóa bài đăng

      a.btn.btn-secondary(href="/admin/rooms")
        i.fa-solid.fa-arrow-left
        | Quay lại danh sách

  // Status Banner
  div(class="admin-clean-045")
    if room.status === ROOM_STATUS.APPROVED
      span.badge.badge-green(class="admin-clean-046") Trạng thái: ĐÃ DUYỆT (Hiển thị công khai)
    else if room.status === ROOM_STATUS.PENDING
      span.badge.badge-yellow(class="admin-clean-046") Trạng thái: CHỜ DUYỆT (PENDING)
    else if room.status === ROOM_STATUS.DRAFT
      span.badge.badge-gray(class="admin-clean-046") Trạng thái: BẢN NHÁP (DRAFT)
    else if room.status === ROOM_STATUS.REJECTED
      span.badge.badge-red(class="admin-clean-046") Trạng thái: BỊ TỪ CHỐI (REJECTED)
      if room.rejectReason
        div(class="admin-clean-047")
          b Lý do từ chối: 
          = room.rejectReason

  .room-detail-grid(class="admin-clean-048")
    // Cột nội dung phòng
    .detail-card(class="admin-clean-049")
      h2(class="admin-clean-050")= room.title
      
      div(class="admin-clean-051")
        img(src=room.thumbnail || "/client/assets/images/product-1.jpg" class="admin-clean-052" alt=room.title)

      if room.images && room.images.length > 0
        div(style="margin-top: 14px")
          b(class="admin-clean-059") Tất cả hình ảnh bài đăng (#{room.images.length} ảnh):
          div(style="display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 8px; margin-top: 8px")
            each imgUrl in room.images
              a(href=imgUrl target="_blank" title="Xem ảnh kích thước lớn")
                img(src=imgUrl style="width: 100%; height: 80px; object-fit: cover; border-radius: 6px; border: 1px solid #e2e8f0" alt="Ảnh chi tiết")

      div(class="admin-clean-053")
        div
          span(class="admin-clean-054") Giá thuê
          b(class="admin-clean-055") #{room.price.toLocaleString('vi-VN')} đ/tháng
        div
          span(class="admin-clean-054") Diện tích
          b(class="admin-clean-056") #{room.area} m²
        div
          span(class="admin-clean-054") Sức chứa
          b(class="admin-clean-056") #{room.capacity || 2} người

      div(class="admin-clean-057")
        div
          b Địa chỉ: 
          span #{room.address}, #{room.district}, #{room.province}
        if room.location && room.location.coordinates && room.location.coordinates.length >= 2
          div
            b Tọa độ GPS: 
            span #{room.location.coordinates[1].toFixed(5)}, #{room.location.coordinates[0].toFixed(5)} 
            a(href=`https://maps.google.com/?q=${room.location.coordinates[1]},${room.location.coordinates[0]}` target="_blank" style="color: #2563eb; text-decoration: underline; margin-left: 6px") (Xem trên Google Maps)
        div
          b Loại phòng: 
          span= room.categoryId ? room.categoryId.title : '-'
        div
          b Tiền cọc: 
          span #{room.deposit ? room.deposit.toLocaleString('vi-VN') + ' đ' : '0 đ'}
        div
          b Giá điện: 
          span= room.electricityPrice
        div
          b Giá nước: 
          span= room.waterPrice
        div
          b Dịch vụ: 
          span= room.servicePrice
        div
          b Lượt xem: 
          span #{room.views || 0} lượt

      if room.amenities && room.amenities.length > 0
        div(class="admin-clean-058")
          b(class="admin-clean-059") Tiện ích đi kèm:
          div(class="admin-clean-060")
            each am in room.amenities
              span(class="admin-clean-061")= am

      div
        b(class="admin-clean-059") Mô tả bài đăng:
        p(class="admin-clean-062")= room.description || '(Không có mô tả)'

    // Cột thông tin Chủ trọ
    .landlord-info-card(class="admin-clean-049")
      h3(class="admin-clean-063") Thông tin Chủ trọ
      if room.landlordId
        div(class="admin-clean-064")
          img(src=room.landlordId.avatar || "/admin/assets/images/avatar.jpg" class="admin-clean-065")
          h4(class="admin-clean-066")= room.landlordId.fullName
          span.badge.badge-green(class="admin-clean-067") Chủ trọ hệ thống

        div(class="admin-clean-068")
          div
            span(class="block text-xs text-slate-500 mb-1") Giá thuê
            b(class="text-base sm:text-lg font-extrabold text-[#16A34A]") #{room.price.toLocaleString('vi-VN')} đ/tháng
          div
            span(class="block text-xs text-slate-500 mb-1") Diện tích
            b(class="text-base sm:text-lg font-bold text-slate-800") #{room.area} m²
          div
            span(class="block text-xs text-slate-500 mb-1") Sức chứa
            b(class="text-base sm:text-lg font-bold text-slate-800") #{room.capacity || 2} người

        //- Chi tiết địa chỉ & dịch vụ
        div(class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs sm:text-sm text-slate-600 bg-white p-4 rounded-xl border border-slate-100")
          div(class="sm:col-span-2")
            b(class="text-slate-800") Địa chỉ: 
            span #{room.address}, #{room.district}, #{room.province}
          div
            b(class="text-slate-800") Loại phòng: 
            span= room.categoryId ? room.categoryId.title : '-'
          div
            b(class="text-slate-800") Giá điện: 
            span= room.electricityPrice
          div
            b Ngày tham gia: 
            span= room.landlordId.createdAt ? new Date(room.landlordId.createdAt).toLocaleDateString('vi-VN') : '-'

        div(style="margin-top: 16px")
          a.btn.btn-secondary(href=`/admin/rooms?keyword=${encodeURIComponent(room.landlordId.email)}` style="width: 100%; text-align: center; justify-content: center")
            i.fa-solid.fa-list(style="margin-right: 6px")
            | Xem tất cả bài đăng của chủ này
      else
        p(class="admin-clean-069") Không có thông tin chủ trọ

