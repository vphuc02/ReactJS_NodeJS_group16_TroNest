header.header(style="background: #fff; border-bottom: 1px solid #e2e8f0; padding: 12px 24px; display: flex; justify-content: space-between; align-items: center;")
  div(style="display: flex; align-items: center; gap: 16px;")
    a(href="/landlord/dashboard" style="display: flex; align-items: center; gap: 8px; font-size: 20px; font-weight: 800; color: #ff5100; text-decoration: none;")
      i.fa-solid.fa-house-chimney-user
      span TroNest Chủ Trọ

    // Status badge of Landlord account
    if user
      if user.status === 'APPROVED'
        span.badge.badge-green(style="font-size: 12px;")
          i.fa-solid.fa-circle-check(style="margin-right: 4px;")
          | Tài khoản đã duyệt
      else if user.status === 'PENDING'
        span.badge.badge-yellow(style="font-size: 12px;")
          i.fa-solid.fa-clock(style="margin-right: 4px;")
          | Tài khoản Chờ Admin duyệt
      else if user.status === 'REJECTED'
        span.badge.badge-red(style="font-size: 12px;")
          i.fa-solid.fa-circle-xmark(style="margin-right: 4px;")
          | Tài khoản Bị từ chối

  div(style="display: flex; align-items: center; gap: 20px;")
    a(href="/" target="_blank" style="font-size: 14px; font-weight: 600; color: #4502C7; display: flex; align-items: center; gap: 6px; text-decoration: none;")
      i.fa-solid.fa-globe
      | Xem website chính

    if user
      .user-info(style="display: flex; align-items: center; gap: 10px;")
        img(src=user.avatar || "/admin/assets/images/avatar.jpg" alt=user.fullName style="width: 36px; height: 36px; border-radius: 50%; object-fit: cover; border: 2px solid #fed7aa;")
        div
          span(style="display: block; font-size: 14px; font-weight: 700; color: #1e293b;")= user.fullName
          span(style="display: block; font-size: 12px; color: #64748b;")= user.phone || user.email

      a(href="/logout" title="Đăng xuất" style="color: #ef4444; font-size: 16px; margin-left: 10px; text-decoration: none;")
        i.fa-solid.fa-power-off
