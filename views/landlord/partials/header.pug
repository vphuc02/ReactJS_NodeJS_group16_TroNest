header.header(class="admin-clean-118")
  div(class="admin-clean-119")
    a(href="/landlord/dashboard" class="admin-clean-167")
      i.fa-solid.fa-house-chimney-user
      span TroNest Chủ Trọ

    // Status badge of Landlord account
    if user
      if user.status === USER_STATUS.APPROVED
        span.badge.badge-green(class="admin-clean-168")
          i.fa-solid.fa-circle-check(class="admin-clean-169")
          | Tài khoản đã duyệt
      else if user.status === USER_STATUS.PENDING
        span.badge.badge-yellow(class="admin-clean-168")
          i.fa-solid.fa-clock(class="admin-clean-169")
          | Tài khoản Chờ Admin duyệt
      else if user.status === USER_STATUS.REJECTED
        span.badge.badge-red(class="admin-clean-168")
          i.fa-solid.fa-circle-xmark(class="admin-clean-169")
          | Tài khoản Bị từ chối

  div(class="admin-clean-121")
    a(href="/" target="_blank" class="admin-clean-122")
      i.fa-solid.fa-globe
      | Xem website chính

    if user
      .user-info(class="admin-clean-020")
        img(src=user.avatar || "/admin/assets/images/avatar.jpg" alt=user.fullName class="admin-clean-170")
        div
          span(class="admin-clean-124")= user.fullName
          span(class="admin-clean-171")= user.phone || user.email

      a.btn-logout(href="/logout" data-logout-url="/logout" title="Đăng xuất" class="admin-clean-126")
        i.fa-solid.fa-power-off
