mixin roomForm(options)
  - const isEdit = options.mode === 'edit';
  - const roomData = options.room || {};
  - const formId = isEdit ? 'form-edit-room' : 'form-create-room';
  - const districts = ROOM_DISTRICTS;
  - const amenitiesList = ['Điều hòa', 'Nóng lạnh', 'Wifi', 'Tủ lạnh', 'Máy giặt', 'Ban công', 'Thang máy', 'Tự do giờ giấc', 'Bảo vệ 24/7'];
  - const sampleImgs = [{ url: '/client/assets/images/product-1.jpg', name: 'Hiện đại 1' }, { url: '/client/assets/images/product-2.jpg', name: 'Studio 2' }, { url: '/client/assets/images/product-3.jpg', name: 'Chung cư 3' }, { url: '/client/assets/images/banner-1.png', name: 'Sleepbox' }, { url: '/client/assets/images/banner-2.png', name: 'Phòng đơn' }, { url: '/client/assets/images/banner-3.png', name: 'Gác lửng' }];

  .section-form.room-form-card(class="bg-white rounded-2xl border border-slate-200/90 shadow-xs p-5 sm:p-7 max-w-none")
    form(id=formId class="space-y-6")
      //- 1. Thông tin cơ bản
      div(class="space-y-4")
        div(class="flex items-center gap-2 pb-2.5 border-b border-slate-100")
          span(class="w-7 h-7 rounded-lg bg-emerald-50 text-[#16A34A] flex items-center justify-center text-xs")
            i.fa-solid.fa-house-chimney
          h2(class="text-sm font-bold text-slate-800 m-0") Thông tin cơ bản & Giá thuê

        .form-group.room-form-group(class="m-0")
          label.room-form-label(for="title" class="block text-xs font-bold text-slate-700 mb-1.5")
            | Tiêu đề bài đăng 
            span.room-form-required(class="text-rose-500") *
          input#title.room-form-control(
            type="text"
            name="title"
            value=isEdit ? roomData.title : undefined
            placeholder=isEdit ? undefined : "VD: Phòng trọ khép kín full nội thất gần ĐH Quốc Gia Cầu Giấy"
            required
            class="w-full px-3.5 py-2.5 text-xs sm:text-sm rounded-xl border border-slate-200 bg-slate-50/50 focus:bg-white focus:outline-none focus:border-[#16A34A] focus:ring-2 focus:ring-[#16A34A]/15 transition-all"
          )

        div.room-form-grid-3(class="grid grid-cols-1 sm:grid-cols-3 gap-4 m-0")
          .form-group
            label.room-form-label(for="categoryId" class="block text-xs font-bold text-slate-700 mb-1.5")
              | Loại phòng 
              span.room-form-required(class="text-rose-500") *
            select#categoryId.room-form-control(
              name="categoryId"
              required
              class="w-full px-3.5 py-2.5 text-xs sm:text-sm rounded-xl border border-slate-200 bg-slate-50/50 focus:bg-white focus:outline-none focus:border-[#16A34A] focus:ring-2 focus:ring-[#16A34A]/15 transition-all"
            )
              if !isEdit
                option(value="") -- Chọn loại phòng --
              each cat in categories
                option(value=cat._id selected=isEdit && roomData.categoryId && roomData.categoryId.toString() === cat._id.toString())= cat.title

          .form-group
            label.room-form-label(for="area" class="block text-xs font-bold text-slate-700 mb-1.5")
              | Diện tích (m²) 
              span.room-form-required(class="text-rose-500") *
            input#area.room-form-control(
              type="number"
              name="area"
              value=isEdit ? roomData.area : undefined
              placeholder=isEdit ? undefined : "VD: 25"
              required
              min="5"
              class="w-full px-3.5 py-2.5 text-xs sm:text-sm rounded-xl border border-slate-200 bg-slate-50/50 focus:bg-white focus:outline-none focus:border-[#16A34A] focus:ring-2 focus:ring-[#16A34A]/15 transition-all"
            )

          .form-group
            label.room-form-label(for="capacity" class="block text-xs font-bold text-slate-700 mb-1.5")
              | Sức chứa (người)
            input#capacity.room-form-control(
              type="number"
              name="capacity"
              value=isEdit ? roomData.capacity : 2
              min="1"
              class="w-full px-3.5 py-2.5 text-xs sm:text-sm rounded-xl border border-slate-200 bg-slate-50/50 focus:bg-white focus:outline-none focus:border-[#16A34A] focus:ring-2 focus:ring-[#16A34A]/15 transition-all"
            )

        div.room-form-grid-2(class="grid grid-cols-1 sm:grid-cols-2 gap-4 m-0")
          .form-group
            label.room-form-label(for="price" class="block text-xs font-bold text-slate-700 mb-1.5")
              | Giá thuê (VND/tháng) 
              span.room-form-required(class="text-rose-500") *
            input#price.room-form-control(
              type="number"
              name="price"
              value=isEdit ? roomData.price : undefined
              placeholder=isEdit ? undefined : "VD: 3500000"
              required
              min="100000"
              step="50000"
              class="w-full px-3.5 py-2.5 text-xs sm:text-sm rounded-xl border border-slate-200 bg-slate-50/50 focus:bg-white focus:outline-none focus:border-[#16A34A] focus:ring-2 focus:ring-[#16A34A]/15 transition-all font-semibold text-[#16A34A]"
            )

          .form-group
            label.room-form-label(for="deposit" class="block text-xs font-bold text-slate-700 mb-1.5")
              | Tiền đặt cọc (VND)
            input#deposit.room-form-control(
              type="number"
              name="deposit"
              value=isEdit ? roomData.deposit : undefined
              placeholder=isEdit ? undefined : "VD: 3500000"
              min="0"
              step="50000"
              class="w-full px-3.5 py-2.5 text-xs sm:text-sm rounded-xl border border-slate-200 bg-slate-50/50 focus:bg-white focus:outline-none focus:border-[#16A34A] focus:ring-2 focus:ring-[#16A34A]/15 transition-all"
            )

      //- 2. Vị trí & Địa chỉ
      div(class="space-y-4 pt-2")
        div(class="flex items-center gap-2 pb-2.5 border-b border-slate-100")
          span(class="w-7 h-7 rounded-lg bg-emerald-50 text-[#16A34A] flex items-center justify-center text-xs")
            i.fa-solid.fa-location-dot
          h2(class="text-sm font-bold text-slate-800 m-0") Khu vực & Địa chỉ phòng

        div.room-form-grid-2(class="grid grid-cols-1 sm:grid-cols-2 gap-4 m-0")
          .form-group
            label.room-form-label(for="district" class="block text-xs font-bold text-slate-700 mb-1.5")
              | Quận / Huyện 
              span.room-form-required(class="text-rose-500") *
            select#district.room-form-control(
              name="district"
              required
              class="w-full px-3.5 py-2.5 text-xs sm:text-sm rounded-xl border border-slate-200 bg-slate-50/50 focus:bg-white focus:outline-none focus:border-[#16A34A] focus:ring-2 focus:ring-[#16A34A]/15 transition-all"
            )
              each district in districts
                option(value=district selected=(isEdit && roomData.district === district) || (!isEdit && district === ROOM_DEFAULTS.district))= district

          .form-group
            label.room-form-label(for="ward" class="block text-xs font-bold text-slate-700 mb-1.5")
              | Phường / Xã
            input#ward.room-form-control(
              type="text"
              name="ward"
              value=isEdit ? roomData.ward : undefined
              placeholder=isEdit ? undefined : "VD: Dịch Vọng Hậu"
              class="w-full px-3.5 py-2.5 text-xs sm:text-sm rounded-xl border border-slate-200 bg-slate-50/50 focus:bg-white focus:outline-none focus:border-[#16A34A] focus:ring-2 focus:ring-[#16A34A]/15 transition-all"
            )

        .form-group.room-form-group(class="m-0")
          label.room-form-label(for="address" class="block text-xs font-bold text-slate-700 mb-1.5")
            | Địa chỉ chi tiết 
            span.room-form-required(class="text-rose-500") *
          input#address.room-form-control(
            type="text"
            name="address"
            value=isEdit ? roomData.address : undefined
            placeholder=isEdit ? undefined : "VD: Số 18, Ngõ 175 Xuân Thủy, Cầu Giấy, Hà Nội"
            required
            class="w-full px-3.5 py-2.5 text-xs sm:text-sm rounded-xl border border-slate-200 bg-slate-50/50 focus:bg-white focus:outline-none focus:border-[#16A34A] focus:ring-2 focus:ring-[#16A34A]/15 transition-all"
          )

      //- 3. Hình ảnh phòng trọ
      .form-group.room-form-upload-box(class="m-0 rounded-2xl border border-slate-200/90 bg-slate-50/40 p-4 sm:p-5 space-y-4")
        div.room-form-upload-head(class="flex flex-wrap items-center justify-between gap-3 m-0")
          div
            label.room-form-label-lg(class="flex items-center gap-2 text-sm font-bold text-slate-800 m-0")
              i.fa-solid.fa-images(class="text-[#16A34A]")
              span Hình ảnh phòng trọ (Tối đa 6 ảnh)
              span.room-form-required-gap(class="text-rose-500") *
            p.room-form-help(class="text-xs text-slate-500 m-0 mt-1")
              | Đăng tải từ 1 đến 6 hình ảnh. Ảnh có huy hiệu xanh 
              strong(class="text-[#16A34A]") [Ảnh chính]
              |  sẽ hiển thị làm ảnh đại diện ngoài trang chủ.
          #imageCounter.room-form-counter.image-counter-available(class="px-3.5 py-1.5 rounded-full text-xs font-bold")
            | Đã chọn: 
            span#countText 0
            | /6 ảnh

        div.room-form-actions-row(class="flex flex-wrap gap-2.5 m-0")
          input#fileInput.room-form-hidden-input(type="file" multiple accept="image/png,image/jpeg,image/jpg,image/webp,image/gif")
          button#btnUploadComputer.btn.room-form-button-primary(
            type="button"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#16A34A] hover:bg-[#15803D] text-white text-xs font-semibold shadow-2xs transition-all cursor-pointer border-0"
          )
            i.fa-solid.fa-cloud-arrow-up
            span Tải ảnh từ thiết bị
          button#btnToggleUrlInput.btn.room-form-button-muted(
            type="button"
            class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white hover:bg-slate-100 text-slate-700 text-xs font-semibold border border-slate-200 transition-all cursor-pointer"
          )
            i.fa-solid.fa-link
            span Dán đường dẫn ảnh
          button#btnToggleSampleBox.btn.room-form-button-muted(
            type="button"
            class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white hover:bg-slate-100 text-slate-700 text-xs font-semibold border border-slate-200 transition-all cursor-pointer"
          )
            i.fa-regular.fa-images
            span Chọn ảnh mẫu

        #urlInputBox.room-form-panel.is-hidden(class="bg-white p-3 rounded-xl border border-dashed border-slate-300 m-0")
          div.room-form-inline-row(class="flex gap-2")
            input#customImageUrl.room-form-url-input(
              type="text"
              placeholder="VD: /uploads/rooms/room-xxx.jpg"
              class="flex-1 px-3 py-2 text-xs rounded-lg border border-slate-200 focus:outline-none focus:border-[#16A34A]"
            )
            button#btnAddUrlImage.btn.room-form-button-compact(
              type="button"
              class="px-4 py-2 rounded-lg bg-[#16A34A] hover:bg-[#15803D] text-white text-xs font-semibold border-0 cursor-pointer"
            ) Thêm ảnh

        #sampleImagesBox.room-form-panel.room-form-panel-roomy.is-hidden(class="bg-white p-3.5 rounded-xl border border-dashed border-slate-300 m-0")
          p.room-form-sample-title(class="text-xs font-semibold text-slate-600 m-0 mb-2.5") Bấm vào ảnh để thêm nhanh:
          div.room-form-sample-grid
            each sample in sampleImgs
              div.sample-card.room-form-sample-card(data-image-url=sample.url title=`Bấm để thêm ${sample.name}`)
                img(src=sample.url alt=sample.name)
                span.room-form-sample-name= sample.name

        #uploadProgressBox.room-form-progress.is-hidden
          i.fa-solid.fa-spinner.fa-spin
          span#uploadProgressText Đang xử lý tải ảnh lên máy chủ...

        #imagePreviewGrid.room-form-preview-grid
          #addMoreSlot.room-form-add-slot(class="hover:border-[#16A34A] hover:bg-emerald-50/40")
            i.fa-solid.fa-plus
            span Thêm ảnh

      //- 4. Chi phí dịch vụ & Tiện ích
      div(class="space-y-4 pt-2")
        div(class="flex items-center gap-2 pb-2.5 border-b border-slate-100")
          span(class="w-7 h-7 rounded-lg bg-emerald-50 text-[#16A34A] flex items-center justify-center text-xs")
            i.fa-solid.fa-bolt
          h2(class="text-sm font-bold text-slate-800 m-0") Chi phí dịch vụ & Tiện ích đi kèm

        div.room-form-grid-fees(class="grid grid-cols-1 sm:grid-cols-3 gap-4 m-0")
          .form-group
            label.room-form-label-sm(for="electricityPrice" class="block text-xs font-bold text-slate-700 mb-1.5") Giá điện
            input#electricityPrice.room-form-control-sm(
              type="text"
              name="electricityPrice"
              value=isEdit ? roomData.electricityPrice : ROOM_DEFAULTS.electricityPrice
              class="w-full px-3.5 py-2 text-xs sm:text-sm rounded-xl border border-slate-200 bg-slate-50/50 focus:bg-white focus:outline-none focus:border-[#16A34A] transition-all"
            )
          .form-group
            label.room-form-label-sm(for="waterPrice" class="block text-xs font-bold text-slate-700 mb-1.5") Giá nước
            input#waterPrice.room-form-control-sm(
              type="text"
              name="waterPrice"
              value=isEdit ? roomData.waterPrice : ROOM_DEFAULTS.waterPrice
              class="w-full px-3.5 py-2 text-xs sm:text-sm rounded-xl border border-slate-200 bg-slate-50/50 focus:bg-white focus:outline-none focus:border-[#16A34A] transition-all"
            )
          .form-group
            label.room-form-label-sm(for="servicePrice" class="block text-xs font-bold text-slate-700 mb-1.5") Phí dịch vụ
            input#servicePrice.room-form-control-sm(
              type="text"
              name="servicePrice"
              value=isEdit ? roomData.servicePrice : ROOM_DEFAULTS.servicePrice
              class="w-full px-3.5 py-2 text-xs sm:text-sm rounded-xl border border-slate-200 bg-slate-50/50 focus:bg-white focus:outline-none focus:border-[#16A34A] transition-all"
            )

        .form-group.room-form-group(class="m-0")
          label(class="block text-xs font-bold text-slate-700 mb-2.5") Tiện ích đi kèm
          .amenities-list.room-form-amenities(class="grid grid-cols-2 sm:grid-cols-3 gap-2.5")
            each item in amenitiesList
              - const checked = isEdit ? (roomData.amenities && roomData.amenities.includes(item)) : ['Điều hòa', 'Nóng lạnh', 'Wifi', 'Tự do giờ giấc'].includes(item);
              label.room-form-amenity-label(class="flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl border border-slate-200/90 bg-slate-50/50 hover:bg-emerald-50/50 hover:border-emerald-200 cursor-pointer transition-all text-xs font-semibold text-slate-700")
                input(type="checkbox" name="amenities" value=item checked=checked class="accent-[#16A34A] w-4 h-4 rounded cursor-pointer")
                span= item

      //- 5. Mô tả chi tiết
      .form-group.room-form-group-xl(class="m-0 pt-2")
        label.room-form-label(for="description" class="block text-xs font-bold text-slate-700 mb-1.5") Mô tả chi tiết phòng
        textarea#description.room-form-textarea(
          name="description"
          rows="5"
          placeholder=isEdit ? undefined : "Mô tả cụ thể về phòng, giờ giấc, nội thất, khu vực xung quanh..."
          class="w-full px-3.5 py-2.5 text-xs sm:text-sm rounded-xl border border-slate-200 bg-slate-50/50 focus:bg-white focus:outline-none focus:border-[#16A34A] focus:ring-2 focus:ring-[#16A34A]/15 transition-all"
        )= isEdit ? roomData.description : ''

      //- 6. Nút hành động
      div.room-form-footer-actions(class="flex flex-wrap items-center justify-end gap-3 pt-5 border-t border-slate-100")
        if isEdit
          button#btn-save(
            type="button"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs sm:text-sm font-semibold transition-all cursor-pointer border-0"
          )
            i.fa-regular.fa-floppy-disk
            span Cập nhật bài
          button#btn-resubmit(
            type="button"
            class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-[#16A34A] hover:bg-[#15803D] text-white text-xs sm:text-sm font-bold shadow-sm shadow-emerald-600/20 transition-all cursor-pointer border-0"
          )
            i.fa-solid.fa-paper-plane
            span Gửi Admin duyệt lại (PENDING)
        else
          button#btn-draft(
            type="button"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs sm:text-sm font-semibold transition-all cursor-pointer border-0"
          )
            i.fa-regular.fa-floppy-disk
            span Lưu bản nháp (DRAFT)
          button#btn-submit(
            type="button"
            class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-[#16A34A] hover:bg-[#15803D] text-white text-xs sm:text-sm font-bold shadow-sm shadow-emerald-600/20 transition-all cursor-pointer border-0"
          )
            i.fa-solid.fa-paper-plane
            span Gửi Admin duyệt (PENDING)
