doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    block title
    link(rel="icon" href="/favicon.png")
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css")
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css")
    script(src="https://cdn.tailwindcss.com")
    script.
      tailwind.config = {
        corePlugins: {
          preflight: false
        },
        theme: {
          extend: {
            colors: {
              brand: {
                50: '#FDF4F0',
                100: '#FCE7DF',
                500: '#E05638',
                600: '#C84327',
                700: '#A7331B',
                DEFAULT: '#E05638',
                dark: '#C84327',
                light: '#FFF3EE'
              }
            }
          }
        }
      }
    link(rel="stylesheet" href="/landlord/assets/css/style.css")
    link(rel="stylesheet" href="/shared/assets/css/pagination.css")
  body
    // Header
    include ../partials/header.pug

    // Sider
    include ../partials/sider.pug

    // Main
    main.main(class="admin-clean-127")
      block main

    script(src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js")
    script(src="/shared/assets/js/notify.js")
    script(src="/shared/assets/js/http.js")
    script(src="/landlord/assets/js/script.js")
    script(src="/landlord/assets/js/actions.js")
    block scripts
