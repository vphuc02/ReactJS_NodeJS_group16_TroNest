doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    block title
    link(rel="icon" href="/favicon.png")
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css")
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css")
    script(src="https://cdn.tailwindcss.com")
    script.
      tailwind.config = {
        corePlugins: {
          preflight: false
        },
        theme: {
          extend: {
            fontFamily: {
              serif: ['"Cormorant Garamond"', 'Georgia', 'serif']
            },
            colors: {
              brand: {
                50: '#FAF7F2',
                100: '#F5EFE6',
                200: '#E6DFD3',
                500: '#A67C52',
                600: '#8C6239',
                700: '#6E4B26',
                DEFAULT: '#A67C52',
                dark: '#8C6239',
                forest: '#1C1B19',
                light: '#FAF7F2',
              }
            }
          }
        }
      }
    link(rel="stylesheet" href="/landlord/assets/css/style.css")
    link(rel="stylesheet" href="/shared/assets/css/pagination.css")
  body
    // Header
    include ../partials/header.pug

    // Sider
    include ../partials/sider.pug

    // Main
    main.main(class="admin-clean-127")
      block main

    script(src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js")
    script(src="/shared/assets/js/notify.js")
    script(src="/shared/assets/js/http.js")
    script(src="/landlord/assets/js/script.js")
    script(src="/landlord/assets/js/actions.js")
    block scripts
