extends ../layouts/default.pug

block title
  title Tổng quan Chủ trọ - TroNest

block main
  h1.box-title(class="admin-clean-001")
    | Tổng quan Chủ trọ

  // Cảnh báo trạng thái tài khoản
  if landlordStatus === USER_STATUS.PENDING
    .alert-banner(class="admin-clean-128")
      div(class="admin-clean-129")
        i.fa-solid.fa-clock(class="admin-clean-130")
        div
          b(class="admin-clean-131") Tài khoản của bạn đang trong trạng thái Chờ phê duyệt (PENDING)
          span(class="admin-clean-132") Vui lòng chờ Admin kiểm duyệt thông tin trước khi có thể đăng bài phòng trọ.
      span.badge.badge-yellow Chờ duyệt
  else if landlordStatus === USER_STATUS.REJECTED
    .alert-banner(class="admin-clean-133")
      div(class="admin-clean-129")
        i.fa-solid.fa-triangle-exclamation(class="admin-clean-134")
        div
          b(class="admin-clean-135") Tài khoản của bạn đã bị từ chối phê duyệt!
          span(class="admin-clean-136") Lý do: #{rejectReason || 'Thông tin chưa hợp lệ'}
      span.badge.badge-red Bị từ chối

  // 4 Thẻ thống kê bài đăng
  .stats-grid(class="admin-clean-002")
    .stat-card(class="admin-clean-011")
      div(class="admin-clean-012")
        i.fa-solid.fa-house
      div
        span(class="admin-clean-013") Tổng số bài đăng
        h3(class="admin-clean-014")= totalRooms

    .stat-card(class="admin-clean-011")
      div(class="admin-clean-015")
        i.fa-solid.fa-circle-check
      div
        span(class="admin-clean-013") Đã duyệt (APPROVED)
        h3(class="admin-clean-016")= approvedRooms

    .stat-card(class="admin-clean-011")
      div(class="admin-clean-137")
        i.fa-solid.fa-clock
      div
        span(class="admin-clean-013") Chờ Admin duyệt (PENDING)
        h3(class="admin-clean-138")= pendingRooms

    .stat-card(class="admin-clean-011")
      div(class="admin-clean-017")
        i.fa-solid.fa-file-lines
      div
        span(class="admin-clean-013") Bản nháp (DRAFT)
        h3(class="admin-clean-139")= draftRooms

    .stat-card(class="admin-clean-011")
      div(class="admin-clean-140")
        i.fa-solid.fa-circle-xmark
      div
        span(class="admin-clean-013") Bị từ chối (REJECTED)
        h3(class="admin-clean-141")= rejectedRooms

  // Action Bar
  div(class="admin-clean-142")
    h2(class="admin-clean-021") Bài đăng gần đây
    if landlordStatus === USER_STATUS.APPROVED
      a.btn.btn-primary(href="/landlord/rooms/create")
        i.fa-solid.fa-plus
        | Đăng phòng mới
    else
      button.btn.btn-secondary(disabled title="Cần được Admin phê duyệt tài khoản trước khi đăng phòng")
        i.fa-solid.fa-lock
        | Đăng phòng mới (Đang khóa)

  // Danh sách gần đây
  .table-2(class="admin-clean-143")
    table
      thead
        tr
          th Ảnh
          th Tiêu đề phòng
          th Loại phòng
          th Giá thuê
          th Diện tích
          th Trạng thái
          th Thao tác
      tbody
        if recentRooms && recentRooms.length > 0
          each room in recentRooms
            tr
              td(class="admin-clean-032")
                img(src=room.thumbnail || "/client/assets/images/product-1.jpg" class="admin-clean-144")
              td
                b(class="admin-clean-025")= room.title
                div(class="admin-clean-035")= room.address
              td= room.categoryId ? room.categoryId.title : '-'
              td(class="admin-clean-037") #{room.price.toLocaleString('vi-VN')} đ
              td #{room.area} m²
              td
                if room.status === ROOM_STATUS.APPROVED
                  span.badge.badge-green Đã duyệt (APPROVED)
                else if room.status === ROOM_STATUS.PENDING
                  span.badge.badge-yellow Chờ duyệt (PENDING)
                else if room.status === ROOM_STATUS.DRAFT
                  span.badge.badge-gray Bản nháp (DRAFT)
                else if room.status === ROOM_STATUS.REJECTED
                  span.badge.badge-red Bị từ chối (REJECTED)
              td
                div(class="admin-clean-027")
                  a.btn.btn-secondary(href=`/landlord/rooms/edit/${room._id}` class="admin-clean-038" title="Chỉnh sửa")
                    i.fa-solid.fa-pen-to-square
                  if room.status === ROOM_STATUS.APPROVED
                    a.btn.btn-success(href=`/rooms/detail/${room._id}` target="_blank" class="admin-clean-038" title="Xem trên web")
                      i.fa-solid.fa-eye
        else
          tr
            td(colspan="7" class="admin-clean-088")
              | Bạn chưa có bài đăng nào. Hãy bấm "Đăng phòng mới" để tạo bài đầu tiên!
