extends ../layouts/default.pug

block title
  title Danh sách bài đăng phòng trọ - TroNest

block main
  div(class="admin-clean-040")
    div
      h1.box-title(class="admin-clean-041")
        | Quản lý bài đăng phòng trọ
      p(class="admin-clean-042")
        | Danh sách các bài đăng bạn đã tạo và theo dõi tiến trình phê duyệt của Admin
    
    if landlordStatus === USER_STATUS.APPROVED
      a.btn.btn-primary(href="/landlord/rooms/create")
        i.fa-solid.fa-plus
        | Đăng bài mới
    else
      button.btn.btn-secondary(disabled title="Tài khoản chưa được Admin duyệt")
        i.fa-solid.fa-lock
        | Đăng bài mới (Chờ duyệt)

  // Status Filter Tabs
  .filter-tabs(class="admin-clean-070")
    a.btn(href="/landlord/rooms" class=!statusFilter ? 'btn-primary' : 'btn-secondary')
      | Tất cả bài đăng
    a.btn(href="/landlord/rooms?status=" + ROOM_STATUS.APPROVED class=statusFilter === ROOM_STATUS.APPROVED ? 'btn-primary' : 'btn-secondary')
      i.fa-solid.fa-circle-check(class="admin-clean-072")
      | Đã duyệt (APPROVED)
    a.btn(href="/landlord/rooms?status=" + ROOM_STATUS.PENDING class=statusFilter === ROOM_STATUS.PENDING ? 'btn-primary' : 'btn-secondary')
      i.fa-solid.fa-clock(class="admin-clean-071")
      | Chờ duyệt (PENDING)
    a.btn(href="/landlord/rooms?status=" + ROOM_STATUS.DRAFT class=statusFilter === ROOM_STATUS.DRAFT ? 'btn-primary' : 'btn-secondary')
      i.fa-solid.fa-file-lines(class="admin-clean-074")
      | Bản nháp (DRAFT)
    a.btn(href="/landlord/rooms?status=" + ROOM_STATUS.REJECTED class=statusFilter === ROOM_STATUS.REJECTED ? 'btn-primary' : 'btn-secondary')
      i.fa-solid.fa-circle-xmark(class="admin-clean-073")
      | Bị từ chối (REJECTED)

  // Table
  .table-2(class="admin-clean-024")
    table
      thead
        tr
          th Ảnh
          th Thông tin bài đăng
          th Loại phòng
          th Giá & Diện tích
          th Trạng thái
          th Thao tác
      tbody
        if rooms && rooms.length > 0
          each room in rooms
            tr
              td(class="admin-clean-145")
                img(src=room.thumbnail || "/client/assets/images/product-1.jpg" class="admin-clean-146")
              td
                b(class="admin-clean-147")= room.title
                div(class="admin-clean-148")
                  i.fa-solid.fa-location-dot(class="admin-clean-149")
                  span= room.address
                if room.status === ROOM_STATUS.REJECTED && room.rejectReason
                  div(class="admin-clean-150")
                    b Lý do từ chối: 
                    span= room.rejectReason
              td= room.categoryId ? room.categoryId.title : '-'
              td
                div(class="admin-clean-085")
                  = room.price.toLocaleString('vi-VN') + ' đ'
                div(class="admin-clean-035") #{room.area} m² - #{room.capacity || 2} người
              td
                if room.status === ROOM_STATUS.APPROVED
                  span.badge.badge-green Đã duyệt (APPROVED)
                else if room.status === ROOM_STATUS.PENDING
                  span.badge.badge-yellow Chờ duyệt (PENDING)
                else if room.status === ROOM_STATUS.DRAFT
                  span.badge.badge-gray Bản nháp (DRAFT)
                else if room.status === ROOM_STATUS.REJECTED
                  span.badge.badge-red Bị từ chối (REJECTED)
              td
                div(class="admin-clean-086")
                  if room.status === ROOM_STATUS.DRAFT
                    button.btn.btn-primary(data-landlord-room-action="submit" data-id=room._id class="admin-clean-028" title="Gửi Admin duyệt bài")
                      i.fa-solid.fa-paper-plane
                      | Gửi duyệt

                  if room.status === ROOM_STATUS.APPROVED
                    a.btn.btn-success(href=`/rooms/detail/${room._id}` target="_blank" class="admin-clean-038" title="Xem thực tế trên web")
                      i.fa-solid.fa-eye

                  a.btn.btn-secondary(href=`/landlord/rooms/edit/${room._id}` class="admin-clean-038" title="Chỉnh sửa bài đăng")
                    i.fa-solid.fa-pen-to-square
                    span Sửa

                  button.btn.btn-danger(data-landlord-room-action="delete" data-id=room._id class="admin-clean-038" title="Xóa bài")
                    i.fa-solid.fa-trash-can
        else
          tr
            td(colspan="6" class="admin-clean-151")
              i.fa-solid.fa-folder-open(class="admin-clean-152")
              | Không có bài đăng nào trong mục này.
