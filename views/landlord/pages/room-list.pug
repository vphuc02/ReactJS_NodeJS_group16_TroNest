extends ../layouts/default.pug

block title
  title Danh sách bài đăng phòng trọ - TroNest

block main
  div(style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;")
    div
      h1.box-title(style="margin: 0 0 6px; font-size: 24px; font-weight: 800; color: #1e293b;")
        | Quản lý bài đăng phòng trọ
      p(style="margin: 0; color: #64748b; font-size: 14px;")
        | Danh sách các bài đăng bạn đã tạo và theo dõi tiến trình phê duyệt của Admin
    
    if landlordStatus === 'APPROVED'
      a.btn.btn-primary(href="/landlord/rooms/create")
        i.fa-solid.fa-plus
        | Đăng bài mới
    else
      button.btn.btn-secondary(disabled title="Tài khoản chưa được Admin duyệt")
        i.fa-solid.fa-lock
        | Đăng bài mới (Chờ duyệt)

  // Status Filter Tabs
  .filter-tabs(style="display: flex; gap: 10px; margin-bottom: 20px; overflow-x: auto; padding-bottom: 4px;")
    a.btn(href="/landlord/rooms" class=!statusFilter ? 'btn-primary' : 'btn-secondary')
      | Tất cả bài đăng
    a.btn(href="/landlord/rooms?status=APPROVED" class=statusFilter === 'APPROVED' ? 'btn-primary' : 'btn-secondary')
      i.fa-solid.fa-circle-check(style="color: #16a34a;")
      | Đã duyệt (APPROVED)
    a.btn(href="/landlord/rooms?status=PENDING" class=statusFilter === 'PENDING' ? 'btn-primary' : 'btn-secondary')
      i.fa-solid.fa-clock(style="color: #ca8a04;")
      | Chờ duyệt (PENDING)
    a.btn(href="/landlord/rooms?status=DRAFT" class=statusFilter === 'DRAFT' ? 'btn-primary' : 'btn-secondary')
      i.fa-solid.fa-file-lines(style="color: #64748b;")
      | Bản nháp (DRAFT)
    a.btn(href="/landlord/rooms?status=REJECTED" class=statusFilter === 'REJECTED' ? 'btn-primary' : 'btn-secondary')
      i.fa-solid.fa-circle-xmark(style="color: #dc2626;")
      | Bị từ chối (REJECTED)

  // Table
  .table-2(style="background: #fff; border-radius: 16px; overflow: hidden; border: 1px solid #e2e8f0; box-shadow: 0 4px 15px rgba(0,0,0,0.02);")
    table
      thead
        tr
          th Ảnh
          th Thông tin bài đăng
          th Loại phòng
          th Giá & Diện tích
          th Trạng thái
          th Thao tác
      tbody
        if rooms && rooms.length > 0
          each room in rooms
            tr
              td(style="width: 90px;")
                img(src=room.thumbnail || "/client/assets/images/product-1.jpg" style="width: 75px; height: 55px; object-fit: cover; border-radius: 8px;")
              td
                b(style="font-size: 15px; color: #1e293b; display: block; margin-bottom: 4px;")= room.title
                div(style="font-size: 12px; color: #64748b; display: flex; align-items: center; gap: 4px;")
                  i.fa-solid.fa-location-dot(style="color: #ff5100;")
                  span= room.address
                if room.status === 'REJECTED' && room.rejectReason
                  div(style="margin-top: 8px; background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; padding: 6px 10px; border-radius: 6px; font-size: 12px;")
                    b Lý do từ chối: 
                    span= room.rejectReason
              td= room.categoryId ? room.categoryId.title : '-'
              td
                div(style="font-weight: 700; color: #ff5100; font-size: 15px;")
                  = room.price.toLocaleString('vi-VN') + ' đ'
                div(style="font-size: 12px; color: #64748b;") #{room.area} m² - #{room.capacity || 2} người
              td
                if room.status === 'APPROVED'
                  span.badge.badge-green Đã duyệt (APPROVED)
                else if room.status === 'PENDING'
                  span.badge.badge-yellow Chờ duyệt (PENDING)
                else if room.status === 'DRAFT'
                  span.badge.badge-gray Bản nháp (DRAFT)
                else if room.status === 'REJECTED'
                  span.badge.badge-red Bị từ chối (REJECTED)
              td
                div(style="display: flex; gap: 8px; flex-wrap: wrap;")
                  if room.status === 'DRAFT'
                    button.btn.btn-primary(onclick=`submitRoom('${room._id}')` style="padding: 6px 12px; font-size: 13px;" title="Gửi Admin duyệt bài")
                      i.fa-solid.fa-paper-plane
                      | Gửi duyệt

                  if room.status === 'APPROVED'
                    a.btn.btn-success(href=`/rooms/detail/${room._id}` target="_blank" style="padding: 6px 10px; font-size: 12px;" title="Xem thực tế trên web")
                      i.fa-solid.fa-eye

                  a.btn.btn-secondary(href=`/landlord/rooms/edit/${room._id}` style="padding: 6px 10px; font-size: 12px;" title="Chỉnh sửa bài đăng")
                    i.fa-solid.fa-pen-to-square
                    span Sửa

                  button.btn.btn-danger(onclick=`deleteRoom('${room._id}')` style="padding: 6px 10px; font-size: 12px;" title="Xóa bài")
                    i.fa-solid.fa-trash-can
        else
          tr
            td(colspan="6" style="text-align: center; padding: 50px 20px; color: #64748b;")
              i.fa-solid.fa-folder-open(style="font-size: 40px; color: #cbd5e1; margin-bottom: 12px; display: block;")
              | Không có bài đăng nào trong mục này.

  script.
    function submitRoom(id) {
      if (!confirm("Bạn có chắc chắn muốn gửi bài đăng này để Admin phê duyệt?")) return;
      fetch('/landlord/rooms/submit/' + id, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      })
      .then(res => res.json())
      .then(data => {
        if (data.code === 200) {
          notyf.success(data.message);
          setTimeout(() => location.reload(), 1200);
        } else {
          notyf.error(data.message);
        }
      })
      .catch(err => notyf.error("Lỗi khi gửi duyệt bài!"));
    }

    function deleteRoom(id) {
      if (!confirm("Bạn có chắc chắn muốn xóa bài đăng này vĩnh viễn?")) return;
      fetch('/landlord/rooms/delete/' + id, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      })
      .then(res => res.json())
      .then(data => {
        if (data.code === 200) {
          notyf.success(data.message);
          setTimeout(() => location.reload(), 1200);
        } else {
          notyf.error(data.message);
        }
      })
      .catch(err => notyf.error("Lỗi khi xóa bài!"));
    }
