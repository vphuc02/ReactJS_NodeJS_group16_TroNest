extends ../layouts/default.pug

block title
  title Thông tin cá nhân - Kênh Chủ Trọ TroNest

block main
  -
    const formatFbUrl = (val) => {
      if (!val) return '';
      const s = String(val).trim();
      if (s.startsWith('http://') || s.startsWith('https://')) return s;
      if (s.startsWith('facebook.com') || s.startsWith('www.facebook.com') || s.startsWith('fb.com')) return 'https://' + s;
      return 'https://facebook.com/' + s;
    };

  div(class="space-y-6 max-w-7xl mx-auto")
    //- Breadcrumb
    nav(class="flex items-center gap-2 text-xs text-slate-500 font-medium")
      a(href="/landlord/dashboard" class="hover:text-[#16A34A] no-underline text-slate-500 flex items-center gap-1.5 transition-colors")
        i.fa-solid.fa-house-chimney-user(class="text-xs text-[#16A34A]")
        span Kênh chủ trọ
      span /
      span(class="text-slate-800 font-semibold") Thông tin cá nhân

    //- Cảnh báo trạng thái tài khoản (nếu đang chờ duyệt hoặc bị từ chối)
    if landlordStatus === USER_STATUS.PENDING
      div(class="rounded-2xl border border-amber-200 bg-amber-50/80 p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 shadow-xs")
        div(class="flex items-center gap-3")
          div(class="w-9 h-9 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center shrink-0")
            i.fa-solid.fa-clock(class="text-base")
          div
            p(class="text-xs font-bold text-amber-900 m-0") Tài khoản Chủ trọ của bạn đang trong trạng thái Chờ phê duyệt (PENDING)
            p(class="text-[11px] text-amber-700 m-0 mt-0.5") Vui lòng cập nhật đầy đủ thông tin liên hệ để Quản trị viên duyệt hồ sơ nhanh chóng nhất.
        span(class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-white text-amber-700 border border-amber-300 shadow-2xs shrink-0")
          span(class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse")
          | Chờ duyệt
    else if landlordStatus === USER_STATUS.REJECTED
      div(class="rounded-2xl border border-rose-200 bg-rose-50/80 p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 shadow-xs")
        div(class="flex items-center gap-3")
          div(class="w-9 h-9 rounded-xl bg-rose-100 text-rose-600 flex items-center justify-center shrink-0")
            i.fa-solid.fa-triangle-exclamation(class="text-base")
          div
            p(class="text-xs font-bold text-rose-900 m-0") Tài khoản Chủ trọ của bạn đã bị từ chối phê duyệt!
            p(class="text-[11px] text-rose-700 m-0 mt-0.5") Lý do: #{rejectReason || 'Thông tin chưa hợp lệ. Vui lòng cập nhật lại hồ sơ.'}
        span(class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-white text-rose-700 border border-rose-300 shadow-2xs shrink-0")
          span(class="w-1.5 h-1.5 rounded-full bg-rose-500")
          | Bị từ chối

    //- Hero Profile Header Card
    .profile-hero(class="bg-white rounded-2xl p-5 sm:p-7 border border-slate-200/80 shadow-xs relative overflow-hidden")
      div(class="absolute top-0 right-0 -mr-16 -mt-16 w-64 h-64 bg-emerald-100/35 rounded-full blur-3xl pointer-events-none")
      div(class="absolute bottom-0 left-1/3 -mb-12 w-48 h-48 bg-emerald-50/40 rounded-full blur-2xl pointer-events-none")

      div(class="relative z-10 flex flex-col sm:flex-row items-center sm:items-start gap-5 sm:gap-6")
        //- Avatar Chủ trọ kèm nút đổi ảnh
        .avatar-wrapper(class="relative group cursor-pointer shrink-0" id="avatar-click-zone" title="Nhấn vào ảnh để đổi avatar từ máy tính")
          img#profile-avatar-display(
            src=user.avatar || "/admin/assets/images/avatar.jpg" 
            alt=user.fullName 
            class="w-24 h-24 sm:w-28 sm:h-28 rounded-full object-cover border-4 border-white shadow-md ring-2 ring-emerald-300/80 bg-slate-100 transition-all duration-200 group-hover:brightness-90"
          )
          div(class="absolute inset-0 bg-black/45 rounded-full flex flex-col items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-200 text-white")
            i.fa-solid.fa-camera(class="text-base sm:text-lg mb-0.5")
            span(class="text-[10px] font-semibold tracking-wide") Đổi ảnh
          span(class="absolute bottom-0 right-0 w-8 h-8 bg-[#16A34A] text-white border-2 border-white rounded-full flex items-center justify-center text-xs shadow-md group-hover:scale-105 transition-transform" title="Tải ảnh lên")
            i.fa-solid.fa-camera
          input#avatar-file-input(type="file" name="avatar" accept="image/jpeg,image/png,image/webp,image/gif" class="hidden")

        //- Thông tin tóm tắt & Badges
        div(class="flex-1 text-center sm:text-left min-w-0")
          div(class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-3 justify-center sm:justify-start mb-2")
            h1#profile-name-display(class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight m-0")= user.fullName
            div(class="flex items-center gap-2 flex-wrap justify-center sm:justify-start")
              span(class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200/80")
                i.fa-solid.fa-house-user(class="text-[11px] text-[#16A34A]")
                | Chủ trọ cho thuê
              if user.status === USER_STATUS.APPROVED
                span(class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200/80")
                  i.fa-solid.fa-circle-check(class="text-[11px] text-emerald-600")
                  | Đã xác thực
              else if user.status === USER_STATUS.PENDING
                span(class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200/80")
                  i.fa-solid.fa-clock(class="text-[11px] text-amber-500")
                  | Chờ phê duyệt
              else if user.status === USER_STATUS.REJECTED
                span(class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 border border-rose-200/80")
                  i.fa-solid.fa-circle-xmark(class="text-[11px] text-rose-600")
                  | Bị từ chối

          div(class="flex flex-wrap items-center gap-x-5 gap-y-2 text-xs sm:text-sm text-slate-500 justify-center sm:justify-start mt-2.5")
            span(class="flex items-center gap-1.5")
              i.fa-regular.fa-envelope(class="text-[#16A34A]")
              span= user.email
            span(class="flex items-center gap-1.5")
              i.fa-regular.fa-calendar-check(class="text-[#16A34A]")
              | Tham gia: #{new Date(user.createdAt).toLocaleDateString('vi-VN')}
            if user.phone
              span(class="flex items-center gap-1.5")
                i.fa-solid.fa-phone(class="text-[#16A34A]")
                span= user.phone
            - const heroFbUrl = formatFbUrl(user.facebook)
            a#hero-facebook-link(
              href=heroFbUrl || '#' 
              target="_blank" 
              rel="noopener noreferrer" 
              class="flex items-center gap-1.5 text-blue-600 hover:text-blue-700 hover:underline no-underline font-medium " + (user.facebook ? '' : 'hidden')
              title="Mở Facebook cá nhân"
            )
              i.fa-brands.fa-facebook(class="text-sm text-blue-600")
              span#hero-facebook-text Facebook
              i.fa-solid.fa-arrow-up-right-from-square(class="text-[10px] opacity-75")

        //- Hành động nhanh bên phải
        div(class="flex flex-row sm:flex-col gap-2.5 sm:self-center w-full sm:w-auto shrink-0")
          a(
            href="/landlord/rooms" 
            class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-50 hover:bg-emerald-100/80 text-emerald-700 text-xs sm:text-sm font-semibold transition-all border border-emerald-200/70 no-underline shadow-xs"
          )
            i.fa-solid.fa-list-check(class="text-xs text-[#16A34A]")
            span Quản lý bài đăng
            span(class="bg-[#16A34A] text-white text-[11px] font-bold px-2 py-0.5 rounded-full")= roomCount || 0
          
          button#btn-trigger-edit(
            type="button" 
            class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-[#16A34A] hover:bg-[#15803D] text-white text-xs sm:text-sm font-semibold transition-all shadow-sm active:scale-95 border-none cursor-pointer"
          )
            i.fa-solid.fa-user-pen(class="text-xs")
            span Cập nhật hồ sơ

    //- Main Grid: Sider điều hướng + Nội dung Tabs
    div(class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start")
      //- Cột trái: Tab selector & Thống kê bài đăng
      div(class="lg:col-span-4 space-y-5")
        //- Menu Tabs
        div(class="bg-white rounded-2xl p-2.5 sm:p-3 border border-slate-200/80 shadow-xs")
          ul(class="space-y-1 list-none p-0 m-0")
            li
              button.profile-tab-btn(
                type="button" 
                data-target="#tab-overview" 
                class="active w-full flex items-center justify-between px-3.5 py-3 rounded-xl text-left font-semibold text-sm transition-all border-none cursor-pointer bg-[#F0FDF4] text-[#16A34A]"
              )
                span(class="flex items-center gap-3")
                  i.fa-solid.fa-id-card(class="text-base w-5 text-center")
                  span Thông tin chi tiết
                i.fa-solid.fa-chevron-right(class="text-xs opacity-60")
            li
              button.profile-tab-btn(
                type="button" 
                data-target="#tab-edit" 
                class="w-full flex items-center justify-between px-3.5 py-3 rounded-xl text-left font-semibold text-sm transition-all border-none cursor-pointer bg-transparent text-slate-600 hover:bg-slate-50 hover:text-slate-900"
              )
                span(class="flex items-center gap-3")
                  i.fa-solid.fa-user-gear(class="text-base w-5 text-center")
                  span Chỉnh sửa thông tin
                i.fa-solid.fa-chevron-right(class="text-xs opacity-60")
            li
              button.profile-tab-btn(
                type="button" 
                data-target="#tab-password" 
                class="w-full flex items-center justify-between px-3.5 py-3 rounded-xl text-left font-semibold text-sm transition-all border-none cursor-pointer bg-transparent text-slate-600 hover:bg-slate-50 hover:text-slate-900"
              )
                span(class="flex items-center gap-3")
                  i.fa-solid.fa-shield-halved(class="text-base w-5 text-center")
                  span Đổi mật khẩu
                i.fa-solid.fa-chevron-right(class="text-xs opacity-60")

        //- Tiện ích & Lối tắt
        div(class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-xs space-y-3.5")
          h3(class="text-xs font-bold text-slate-700 uppercase tracking-wider mb-2 flex items-center gap-2")
            i.fa-solid.fa-chart-pie(class="text-[#16A34A]")
            | Quản lý & Hoạt động

          div(class="p-3.5 rounded-xl bg-emerald-50/50 border border-emerald-100 flex items-center justify-between")
            div(class="flex items-center gap-3")
              div(class="w-9 h-9 rounded-xl bg-white flex items-center justify-center text-[#16A34A] shadow-xs")
                i.fa-solid.fa-house-chimney(class="text-xs")
              div
                div(class="text-xs text-slate-500") Phòng trọ đang quản lý
                div(class="text-base font-bold text-slate-800")
                  span= roomCount || 0
                  span(class="text-xs font-normal text-slate-500 ml-1") bài đăng
            a(href="/landlord/rooms" class="text-xs font-semibold text-[#16A34A] hover:underline no-underline") Quản lý &rarr;

          div(class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-between")
            div(class="flex items-center gap-3")
              div(class="w-9 h-9 rounded-xl bg-white flex items-center justify-center text-[#16A34A] shadow-xs")
                i.fa-solid.fa-circle-plus(class="text-xs")
              div
                div(class="text-xs text-slate-500") Đăng phòng trọ mới
                div(class="text-xs font-bold text-slate-800") Tiếp cận người thuê
            a(href="/landlord/rooms/create" class="text-xs font-semibold text-[#16A34A] hover:underline no-underline") Đăng bài &rarr;

          div(class="pt-2 border-t border-slate-100")
            a(href="/logout" data-logout-url="/logout" class="w-full flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl border border-rose-200 text-rose-600 hover:bg-rose-50 text-xs font-semibold transition-colors no-underline")
              i.fa-solid.fa-arrow-right-from-bracket
              | Đăng xuất tài khoản

      //- Cột phải: Các nội dung Tabs
      div(class="lg:col-span-8")
        //- Tab 1: Thông tin chi tiết
        #tab-overview.profile-tab-content(class="bg-white rounded-2xl p-5 sm:p-7 border border-slate-200/80 shadow-xs space-y-5 sm:space-y-6")
          div(class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-slate-100")
            div
              h2(class="text-lg sm:text-xl font-bold text-slate-900 m-0") Hồ sơ chủ trọ
              p(class="text-slate-500 text-xs sm:text-sm mt-1 m-0") Thông tin cá nhân & liên hệ của bạn được hiển thị an toàn trên hệ thống TroNest.
            button(type="button" onclick="document.querySelector('[data-target=\"#tab-edit\"]').click()" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-slate-200 text-slate-700 hover:text-[#16A34A] hover:border-emerald-300 text-xs font-medium transition-colors cursor-pointer bg-white")
              i.fa-solid.fa-pen-to-square
              | Chỉnh sửa

          //- Grid thông tin chi tiết
          div(class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 sm:gap-4")
            //- Họ và tên
            .info-card(class="p-4 rounded-xl bg-slate-50/70 border border-slate-200/60")
              span(class="text-xs font-semibold text-slate-400 block mb-1.5 flex items-center gap-1.5")
                i.fa-solid.fa-user(class="text-slate-400 text-[11px]")
                | Họ và tên đầy đủ
              p#profile-fullname-text(class="text-sm sm:text-base font-semibold text-slate-800 m-0")= user.fullName

            //- Email
            .info-card(class="p-4 rounded-xl bg-slate-50/70 border border-slate-200/60")
              span(class="text-xs font-semibold text-slate-400 block mb-1.5 flex items-center gap-1.5")
                i.fa-solid.fa-envelope(class="text-slate-400 text-[11px]")
                | Địa chỉ Email
              div(class="flex items-center gap-2")
                p(class="text-sm sm:text-base font-semibold text-slate-800 m-0 truncate" title=user.email)= user.email
                span(class="px-1.5 py-0.5 rounded bg-emerald-50 text-emerald-600 text-[10px] font-bold border border-emerald-200 shrink-0") Xác thực

            //- Số điện thoại
            .info-card(class="p-4 rounded-xl bg-slate-50/70 border border-slate-200/60")
              span(class="text-xs font-semibold text-slate-400 block mb-1.5 flex items-center gap-1.5")
                i.fa-solid.fa-phone(class="text-slate-400 text-[11px]")
                | Số điện thoại liên hệ
              if user.phone
                p#profile-phone-text(class="text-sm sm:text-base font-semibold text-slate-800 m-0")= user.phone
              else
                p#profile-phone-text(class="text-sm text-slate-400 italic m-0") Chưa cập nhật

            //- Địa chỉ liên hệ
            .info-card(class="p-4 rounded-xl bg-slate-50/70 border border-slate-200/60")
              span(class="text-xs font-semibold text-slate-400 block mb-1.5 flex items-center gap-1.5")
                i.fa-solid.fa-location-dot(class="text-slate-400 text-[11px]")
                | Địa chỉ liên hệ
              if user.address
                p#profile-address-text(class="text-sm sm:text-base font-semibold text-slate-800 m-0")= user.address
              else
                p#profile-address-text(class="text-sm text-slate-400 italic m-0") Chưa cập nhật

            //- Facebook cá nhân
            .info-card(class="p-4 rounded-xl bg-slate-50/70 border border-slate-200/60 sm:col-span-2")
              span(class="text-xs font-semibold text-slate-400 block mb-1.5 flex items-center gap-1.5")
                i.fa-brands.fa-facebook(class="text-blue-600 text-[12px]")
                | Liên kết Facebook
              - const fbUrl = formatFbUrl(user.facebook)
              a#profile-facebook-link(
                href=fbUrl || '#' 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center gap-1.5 text-sm sm:text-base font-semibold text-blue-600 hover:text-blue-700 hover:underline no-underline " + (user.facebook ? '' : 'hidden')
                title="Bấm để truy cập Facebook cá nhân"
              )
                span#profile-facebook-text= user.facebook || ''
                i.fa-solid.fa-arrow-up-right-from-square(class="text-xs opacity-75")
              p#profile-facebook-empty(class="text-sm text-slate-400 italic m-0 " + (user.facebook ? 'hidden' : '')) Chưa cập nhật

            //- Vai trò & Quyền hạn
            .info-card(class="p-4 rounded-xl bg-slate-50/70 border border-slate-200/60")
              span(class="text-xs font-semibold text-slate-400 block mb-1.5 flex items-center gap-1.5")
                i.fa-solid.fa-id-badge(class="text-slate-400 text-[11px]")
                | Vai trò tài khoản
              div(class="flex items-center gap-2")
                span(class="text-sm sm:text-base font-semibold text-slate-800") Chủ trọ cho thuê
                span(class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800") LANDLORD

            //- Trạng thái phê duyệt
            .info-card(class="p-4 rounded-xl bg-slate-50/70 border border-slate-200/60")
              span(class="text-xs font-semibold text-slate-400 block mb-1.5 flex items-center gap-1.5")
                i.fa-solid.fa-shield-halved(class="text-slate-400 text-[11px]")
                | Trạng thái duyệt hồ sơ
              div(class="flex items-center gap-2")
                if user.status === USER_STATUS.APPROVED
                  span(class="inline-flex items-center gap-1 text-xs sm:text-sm font-semibold text-emerald-700")
                    i.fa-solid.fa-circle-check(class="text-emerald-600")
                    | Đã được duyệt xác thực
                else if user.status === USER_STATUS.PENDING
                  span(class="inline-flex items-center gap-1 text-xs sm:text-sm font-semibold text-amber-700")
                    i.fa-solid.fa-clock(class="text-amber-500")
                    | Đang chờ phê duyệt
                else if user.status === USER_STATUS.REJECTED
                  span(class="inline-flex items-center gap-1 text-xs sm:text-sm font-semibold text-rose-700")
                    i.fa-solid.fa-circle-xmark(class="text-rose-600")
                    | Bị từ chối

            //- Ngày tham gia
            .info-card(class="p-4 rounded-xl bg-slate-50/70 border border-slate-200/60")
              span(class="text-xs font-semibold text-slate-400 block mb-1.5 flex items-center gap-1.5")
                i.fa-solid.fa-calendar-plus(class="text-slate-400 text-[11px]")
                | Ngày khởi tạo tài khoản
              p(class="text-sm sm:text-base font-medium text-slate-700 m-0")
                | #{new Date(user.createdAt).toLocaleDateString('vi-VN')} #{new Date(user.createdAt).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' })}

            //- Cập nhật lần cuối
            .info-card(class="p-4 rounded-xl bg-slate-50/70 border border-slate-200/60")
              span(class="text-xs font-semibold text-slate-400 block mb-1.5 flex items-center gap-1.5")
                i.fa-solid.fa-clock-rotate-left(class="text-slate-400 text-[11px]")
                | Lần cập nhật gần nhất
              p#profile-updated-at(class="text-sm sm:text-base font-medium text-slate-700 m-0")
                | #{new Date(user.updatedAt || user.createdAt).toLocaleDateString('vi-VN')} #{new Date(user.updatedAt || user.createdAt).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' })}

          //- Mẹo dành cho chủ trọ
          div(class="rounded-xl bg-emerald-50/70 border border-emerald-200/70 p-4 flex items-start gap-3 text-xs sm:text-sm text-emerald-900")
            i.fa-solid.fa-lightbulb(class="text-[#16A34A] mt-0.5 text-base shrink-0")
            div
              strong(class="font-semibold block mb-0.5") Mẹo dành cho Chủ trọ:
              | Cập nhật số điện thoại chính xác và liên kết Facebook cá nhân sẽ giúp người tìm trọ dễ dàng liên lạc trao đổi trực tiếp, gia tăng tỷ lệ chốt phòng thành công!

        //- Tab 2: Chỉnh sửa thông tin
        #tab-edit.profile-tab-content(class="hidden bg-white rounded-2xl p-5 sm:p-7 border border-slate-200/80 shadow-xs space-y-5 sm:space-y-6")
          div(class="pb-4 border-b border-slate-100")
            h2(class="text-lg sm:text-xl font-bold text-slate-900 m-0") Cập nhật thông tin chủ trọ
            p(class="text-slate-500 text-xs sm:text-sm mt-1 m-0") Điền các thông tin bạn muốn cập nhật. Nhấn Lưu thay đổi để hoàn tất.

          //- Khu vực tải ảnh đại diện từ máy tính
          div(class="p-4 sm:p-5 rounded-2xl bg-emerald-50/40 border border-emerald-100 flex flex-col sm:flex-row items-center sm:items-start gap-4")
            div(class="relative group cursor-pointer shrink-0" onclick="document.getElementById('avatar-file-input').click()")
              img#edit-avatar-preview(
                src=user.avatar || "/admin/assets/images/avatar.jpg" 
                alt=user.fullName 
                class="w-20 h-20 rounded-full object-cover border-2 border-white shadow-md ring-2 ring-emerald-300 transition-all group-hover:brightness-90"
              )
