block scripts
  script.
    document.addEventListener("DOMContentLoaded", function () {
      // 1. Chuyển đổi Tabs
      const tabButtons = document.querySelectorAll(".profile-tab-btn");
      const tabContents = document.querySelectorAll(".profile-tab-content");
      const btnTriggerEdit = document.getElementById("btn-trigger-edit");

      function switchTab(targetSelector) {
        tabButtons.forEach(function (btn) {
          if (btn.getAttribute("data-target") === targetSelector) {
            btn.classList.add("active", "bg-[#F0FDF4]", "text-[#16A34A]");
            btn.classList.remove("bg-transparent", "text-slate-600");
          } else {
            btn.classList.remove("active", "bg-[#F0FDF4]", "text-[#16A34A]");
            btn.classList.add("bg-transparent", "text-slate-600");
          }
        });

        tabContents.forEach(function (content) {
          if ("#" + content.id === targetSelector) {
            content.classList.remove("hidden");
          } else {
            content.classList.add("hidden");
          }
        });
      }

      tabButtons.forEach(function (btn) {
        btn.addEventListener("click", function () {
          const target = this.getAttribute("data-target");
          switchTab(target);
        });
      });

      if (btnTriggerEdit) {
        btnTriggerEdit.addEventListener("click", function () {
          switchTab("#tab-edit");
        });
      }

      function formatFbUrlClient(val) {
        if (!val) return "";
        const s = String(val).trim();
        if (s.startsWith("http://") || s.startsWith("https://")) return s;
        if (s.startsWith("facebook.com") || s.startsWith("www.facebook.com") || s.startsWith("fb.com")) {
          return "https://" + s;
        }
        return "https://facebook.com/" + s;
      }

      // 2. Upload avatar từ thiết bị
      const avatarFileInput = document.getElementById("avatar-file-input");
      const avatarClickZone = document.getElementById("avatar-click-zone");
      const profileAvatarDisplay = document.getElementById("profile-avatar-display");
      const editAvatarPreview = document.getElementById("edit-avatar-preview");
      const avatarUploadStatus = document.getElementById("avatar-upload-status");

      if (avatarClickZone && avatarFileInput) {
        avatarClickZone.addEventListener("click", function (e) {
          if (e.target !== avatarFileInput) {
            avatarFileInput.click();
          }
        });
      }

      if (avatarFileInput) {
        avatarFileInput.addEventListener("change", async function () {
          const file = this.files && this.files[0];
          if (!file) return;

          if (!file.type.match(/^image\/(jpeg|png|webp|gif)$/i)) {
            if (window.notyf) {
              window.notyf.error("Vui lòng chọn tệp ảnh có định dạng JPG, PNG, WEBP hoặc GIF!");
            }
            this.value = "";
            return;
          }

          if (file.size > 5 * 1024 * 1024) {
            if (window.notyf) {
              window.notyf.error("Kích thước ảnh không được vượt quá 5 MB!");
            }
            this.value = "";
            return;
          }

          const previewUrl = URL.createObjectURL(file);
          if (editAvatarPreview) editAvatarPreview.src = previewUrl;
          if (profileAvatarDisplay) profileAvatarDisplay.src = previewUrl;

          const formData = new FormData();
          formData.append("avatar", file);

          if (avatarUploadStatus) {
            avatarUploadStatus.textContent = "Đang tải ảnh lên...";
            avatarUploadStatus.classList.remove("hidden");
          }
          if (profileAvatarDisplay) profileAvatarDisplay.style.opacity = "0.6";

          try {
            const response = await fetch("/landlord/profile/avatar", {
              method: "POST",
              headers: {
                "Accept": "application/json"
              },
              body: formData
            });

            const data = await response.json();

            if (response.ok && data.code === 200) {
              const newAvatarUrl = data.avatar || previewUrl;
              if (profileAvatarDisplay) profileAvatarDisplay.src = newAvatarUrl;
              if (editAvatarPreview) editAvatarPreview.src = newAvatarUrl;

              // Đồng bộ avatar trên thanh header
              document.querySelectorAll("header img").forEach(function (img) {
                if (img.classList.contains("rounded-full")) {
                  img.src = newAvatarUrl;
                }
              });

              if (window.notyf) {
                window.notyf.success(data.message || "Tải lên ảnh đại diện thành công!");
              }
            } else {
              if (window.notyf) {
                window.notyf.error(data.message || "Tải lên ảnh thất bại, vui lòng thử lại!");
              }
            }
          } catch (err) {
            console.error("Lỗi tải avatar:", err);
            if (window.notyf) {
              window.notyf.error("Có lỗi xảy ra khi kết nối máy chủ!");
            }
          } finally {
            if (profileAvatarDisplay) profileAvatarDisplay.style.opacity = "1";
            if (avatarUploadStatus) avatarUploadStatus.classList.add("hidden");
            avatarFileInput.value = "";
          }
        });
      }

      // 3. Cập nhật thông tin chủ trọ
      const formUpdateProfile = document.getElementById("form-update-profile");
      const btnSaveProfile = document.getElementById("btn-save-profile");

      if (formUpdateProfile) {
        formUpdateProfile.addEventListener("submit", async function (e) {
          e.preventDefault();

          const fullName = document.getElementById("fullName").value.trim();
          const phone = document.getElementById("phone").value.trim();
          const address = document.getElementById("address").value.trim();
          const facebook = document.getElementById("facebook").value.trim();

          if (!fullName) {
            if (window.notyf) window.notyf.error("Họ và tên không được để trống!");
            return;
          }

          if (phone && !/^[0-9]{10}$/.test(phone)) {
            if (window.notyf) window.notyf.error("Số điện thoại không hợp lệ (cần đúng 10 chữ số)!");
            return;
          }

          if (btnSaveProfile) {
            btnSaveProfile.disabled = true;
            btnSaveProfile.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> <span>Đang lưu...</span>';
          }

          try {
            const response = await fetch("/landlord/profile/edit", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                "Accept": "application/json"
              },
              body: JSON.stringify({ fullName, phone, address, facebook })
            });

            const data = await response.json();

            if (response.ok && data.code === 200) {
              const updatedUser = data.user || {};
              const nameDisplay = document.getElementById("profile-name-display");
              const fullnameText = document.getElementById("profile-fullname-text");
              const phoneText = document.getElementById("profile-phone-text");
              const addressText = document.getElementById("profile-address-text");
              const facebookLink = document.getElementById("profile-facebook-link");
              const facebookText = document.getElementById("profile-facebook-text");
              const facebookEmpty = document.getElementById("profile-facebook-empty");
              const heroFbLink = document.getElementById("hero-facebook-link");
              const heroFbText = document.getElementById("hero-facebook-text");
              const updatedAtEl = document.getElementById("profile-updated-at");

              if (nameDisplay) nameDisplay.textContent = updatedUser.fullName || fullName;
              if (fullnameText) fullnameText.textContent = updatedUser.fullName || fullName;

              if (phoneText) {
                if (updatedUser.phone) {
                  phoneText.textContent = updatedUser.phone;
                  phoneText.className = "text-sm sm:text-base font-semibold text-slate-800 m-0";
                } else {
                  phoneText.textContent = "Chưa cập nhật";
                  phoneText.className = "text-sm text-slate-400 italic m-0";
                }
              }

              if (addressText) {
                if (updatedUser.address) {
                  addressText.textContent = updatedUser.address;
                  addressText.className = "text-sm sm:text-base font-semibold text-slate-800 m-0";
                } else {
                  addressText.textContent = "Chưa cập nhật";
                  addressText.className = "text-sm text-slate-400 italic m-0";
                }
              }

              const fbHref = formatFbUrlClient(updatedUser.facebook || facebook);
              if (updatedUser.facebook || facebook) {
                if (facebookText) facebookText.textContent = updatedUser.facebook || facebook;
                if (facebookLink) {
                  facebookLink.href = fbHref;
                  facebookLink.classList.remove("hidden");
                }
                if (facebookEmpty) facebookEmpty.classList.add("hidden");

                if (heroFbLink) {
                  heroFbLink.href = fbHref;
                  heroFbLink.classList.remove("hidden");
                }
                if (heroFbText) heroFbText.textContent = "Facebook";
              } else {
                if (facebookLink) facebookLink.classList.add("hidden");
                if (facebookEmpty) facebookEmpty.classList.remove("hidden");
                if (heroFbLink) heroFbLink.classList.add("hidden");
              }

              if (updatedAtEl) {
                const now = new Date();
                updatedAtEl.textContent = now.toLocaleDateString("vi-VN") + " " + now.toLocaleTimeString("vi-VN", { hour: "2-digit", minute: "2-digit" });
              }

              if (window.notyf) {
                window.notyf.success(data.message || "Cập nhật thông tin thành công!");
              }

              setTimeout(function () {
                switchTab("#tab-overview");
              }, 400);
            } else {
              if (window.notyf) {
                window.notyf.error(data.message || "Cập nhật thất bại, vui lòng kiểm tra lại dữ liệu!");
              }
            }
          } catch (err) {
            console.error("Lỗi cập nhật hồ sơ:", err);
            if (window.notyf) {
              window.notyf.error("Có lỗi xảy ra khi kết nối máy chủ!");
            }
          } finally {
            if (btnSaveProfile) {
              btnSaveProfile.disabled = false;
              btnSaveProfile.innerHTML = '<i class="fa-solid fa-check"></i> <span>Lưu thay đổi</span>';
            }
          }
        });
      }

      // 4. Đổi mật khẩu
      const formChangePassword = document.getElementById("form-change-password");
      const btnSavePassword = document.getElementById("btn-save-password");

      if (formChangePassword) {
        formChangePassword.addEventListener("submit", async function (e) {
          e.preventDefault();

          const oldPassword = document.getElementById("oldPassword").value;
          const newPassword = document.getElementById("newPassword").value;
          const confirmPassword = document.getElementById("confirmPassword").value;

          if (!oldPassword || !newPassword || !confirmPassword) {
            if (window.notyf) window.notyf.error("Vui lòng điền đầy đủ các trường mật khẩu!");
            return;
          }

          if (newPassword.length < 6) {
            if (window.notyf) window.notyf.error("Mật khẩu mới phải có ít nhất 6 ký tự!");
            return;
          }

          if (newPassword !== confirmPassword) {
            if (window.notyf) window.notyf.error("Xác nhận mật khẩu mới không trùng khớp!");
            return;
          }

          if (btnSavePassword) {
            btnSavePassword.disabled = true;
            btnSavePassword.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> <span>Đang xử lý...</span>';
          }

          try {
            const response = await fetch("/landlord/profile/change-password", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                "Accept": "application/json"
              },
              body: JSON.stringify({ oldPassword, newPassword, confirmPassword })
            });

            const data = await response.json();

            if (response.ok && data.code === 200) {
              if (window.notyf) {
                window.notyf.success(data.message || "Đổi mật khẩu thành công!");
              }
              formChangePassword.reset();
              setTimeout(function () {
                switchTab("#tab-overview");
              }, 400);
            } else {
              if (window.notyf) {
                window.notyf.error(data.message || "Đổi mật khẩu thất bại!");
              }
            }
          } catch (err) {
            console.error("Lỗi đổi mật khẩu:", err);
            if (window.notyf) {
              window.notyf.error("Có lỗi xảy ra khi kết nối máy chủ!");
            }
          } finally {
            if (btnSavePassword) {
              btnSavePassword.disabled = false;
              btnSavePassword.innerHTML = '<i class="fa-solid fa-key"></i> <span>Đổi mật khẩu</span>';
            }
          }
        });
      }
    });

